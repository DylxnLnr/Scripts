-- Accept a quest: teleport to the offering NPC first (server checks proximity).
function acceptQuest(name, cancelled)
    if cancelled and cancelled() then return false, "stopped" end
    local q = questInfo(name)
    if not q then return false, "unknown quest" end
    if questState(name) == "Doing" then return true end
    local npc = q.OfferNpc and DB.npcs[q.OfferNpc]
    if not npc then return false, "npc position unknown (" .. tostring(q.OfferNpc) .. ")" end
    if not passes(q.Requirements) then return false, "requirements" end
    if q.WenCostOnAccept and getWen() < q.WenCostOnAccept then return false, "not enough wen" end
    local cdLeft = questCooldownLeft()
    if cdLeft > 0 then return false, ("quest cooldown %ds"):format(cdLeft) end -- caller keeps farming meanwhile
    if not canAddQuest(name) then return false, "cannot add (another quest of this category active)" end
    local before = getHRP() and getHRP().CFrame
    tpPos(npc.pos, 3)
    task.wait(0.9)
    if cancelled and cancelled() then return false, "stopped" end
    toServer("AddQuest", name)
    local t0 = os.clock()
    while os.clock() - t0 < 3 do
        if cancelled and cancelled() then return false, "stopped" end
        if questState(name) == "Doing" then return true end
        task.wait(0.2)
    end
    return false, "server refused"
end

