-- === SKILL KEY-SPAM FALLBACK ===
-- The game's skill hotbar slots (Skills_2nd..Skills_6th) default to Z, X, C, V, B.
-- When the scripted Attempt_Hold cast can't fire (eg demon weapon skills aren't in mySkills,
-- or the game gates scripts differently), tap the real hotbar keys so the game's own
-- HUD -> Skill_Controller handler casts natively (it still enforces cooldown / Checker / Can_Skill).
-- Everything is scoped inside do..end so the chunk's live register count stays low.
do
    local VIM = game:GetService("VirtualInputManager")
    local SKILL_SPAM_KEYS = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.B }
    local SKILL_SPAM_VKEYS = { [Enum.KeyCode.Z] = 0x5A, [Enum.KeyCode.X] = 0x58, [Enum.KeyCode.C] = 0x43, [Enum.KeyCode.V] = 0x56, [Enum.KeyCode.B] = 0x42 }
    local _skillSpamIdx, _lastSkillSpamAt = 0, 0
    _skillLast.spamTick = function()
        if not CFG.skillKeySpam then return false end
        local delay = CFG.skillKeySpamDelay or 0.5
        local now = os.clock()
        if now - _lastSkillSpamAt < delay then return false end
        if UserInput:GetFocusedTextBox() then return false end
        _lastSkillSpamAt = now
        _skillSpamIdx = _skillSpamIdx % #SKILL_SPAM_KEYS + 1
        local kc = SKILL_SPAM_KEYS[_skillSpamIdx]
        -- AZERTY-safe: keypress(0x5A) on a FR layout hits the physical W key; Z goes through VIM only.
        if kc ~= Enum.KeyCode.Z and type(keypress) == "function" and type(keyrelease) == "function" then
            pcall(function() keypress(SKILL_SPAM_VKEYS[kc]); task.wait(0.05); keyrelease(SKILL_SPAM_VKEYS[kc]) end)
        end
        pcall(function()
            VIM:SendKeyEvent(true, kc, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, kc, false, game)
        end)
        _skillLast.status = "Key spam: " .. tostring(kc.Name)
        return true
    end
end

