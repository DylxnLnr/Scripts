        local root = e.model:FindFirstChild("HumanoidRootPart")
        local d = hrp and root and (root.Position - hrp.Position).Magnitude or 0
        -- prefer already-damaged mobs, then nearest
        local score = d - (e.hum.MaxHealth - e.hum.Health) * 2
        if not bd or score < bd then best, bd = e, score end
    end
    return best
end

local potionTick -- defined below (potions section)
function COMBAT.loopDelay(now)
    if COMBAT.mode ~= "attack" then return 0.12 end
    return math.clamp((COMBAT.nextMeleeAt or 0) - now, 0, 1 / 60)
end
function COMBAT.canStrike(model, root, playerRoot, now)
    local delta = root.Position - playerRoot.Position
    return STATE.target == model and COMBAT.mode == "attack" and now - (COMBAT.stepAt or 0) < 0.25
        and now >= (COMBAT.settleUntil or 0) and not COMBAT.actionBusy and not COMBAT.potionBusy
        and not _skillLast.busy and delta.Magnitude <= 6 and math.abs(delta.Y) <= 5
end
function COMBAT.attackTick(model)
    local hum = model and model.Parent and model:FindFirstChildOfClass("Humanoid")
    local root = model and model:FindFirstChild("HumanoidRootPart")
    local playerRoot = getHRP()
    local now = os.clock()
    if not alive() or not hum or hum.Health <= 0 or not root or not playerRoot then return end
    local canAttack = COMBAT.canStrike(model, root, playerRoot, now)
    if canAttack and Checker then
        local checked, allowed = pcall(function() return asGame(function() return Checker.check(LP, "combat") end) end)
        canAttack = checked and allowed == true
    end
    local recovery = COMBAT.trackProgress(model, hum.Health, now, canAttack)
    if CFG.recoverStalledCombat and recovery == "pause" then
        COMBAT.pause("No target damage after weapon recovery; retrying this encounter")
        return
    elseif CFG.recoverStalledCombat and recovery == "reequip" then
        local config = LP:FindFirstChild("Items_Config")
        local equipped = config and config:FindFirstChild("Equipped")
        if equipped then asGame(function() equipped.Value = 0 end) end
        _lastEquipFix = 0
        return
    end
    if COMBAT.retreating and CFG.autoPotion and potionTick then potionTick(true); return end
    if not canAttack or not ensureEquipped() then return end
    local epoch, character = STATE.activityEpoch, getChar()
    local function cancelled()
        return _stopped or STATE.activityEpoch ~= epoch or getChar() ~= character or not alive()
            or STATE.target ~= model or not model.Parent or hum.Health <= 0
            or COMBAT.evading or COMBAT.retreating or COMBAT.blockCharacter ~= nil or COMBAT.potionBusy
    end
    COMBAT.actionBusy = true
    local ok, why = pcall(function()
        if cancelled() then return end
        if CFG.useSkills and (COMBAT.meleeSinceSkill or CFG.skillKeySpam) and now >= (COMBAT.nextSkillAt or 0)
            and now >= (COMBAT.commitUntil or 0)
            and (COMBAT.nextMeleeAt or 0) - now > 0.45
            and hum.Health >= (CFG.skillMinTargetHP or 0) then
            local values = getValues()
            local stamina = values and val(values, "Stamina", 0) or 0
            local skills = mySkills()
            for offset = 1, #skills do
                local index = (_skillLast.cursor + offset - 1) % #skills + 1
                local skill = skills[index]
                if stamina >= math.max(skill.stamina or 0, CFG.skillMinStamina or 30) and _skillLast.ready(skill.name) then
                    local cast = useSkill(skill.name, root.Position, function() return not CFG.useSkills or cancelled() end)
                    if cancelled() then return end
                    if cast then
                        _skillLast.cursor = index
                        COMBAT.nextSkillAt = os.clock() + 1.2
                        COMBAT.meleeSinceSkill = false
                        COMBAT.meleeChain = 0
                        COMBAT.metrics.skills = COMBAT.metrics.skills + 1
                        return
                    end
                end
            end
            -- fallback: weapon skills (eg demon scythe) aren't in mySkills and scripted casts
            -- can be gated out; spam the real hotbar keys so the game casts natively.
            if CFG.skillKeySpam and _skillLast.spamTick() then
                COMBAT.nextSkillAt = os.clock() + (CFG.skillKeySpamDelay or 0.5)
                COMBAT.metrics.skills = COMBAT.metrics.skills + 1
                return
            end
        end
        if cancelled() or not root.Parent or (root.Position - playerRoot.Position).Magnitude > 6 then return end
        if os.clock() < (COMBAT.nextMeleeAt or 0) then return end
        if now >= (COMBAT.commitUntil or 0) or not COMBAT.attackOffset then
            COMBAT.attackOffset = playerRoot.Position - root.Position
            COMBAT.commitUntil = os.clock() + 0.4
        end
        COMBAT.metrics.swings = COMBAT.metrics.swings + 1
        local requested, cooldown = swing()
        if not cancelled() then
            COMBAT.nextMeleeAt = os.clock() + math.clamp(tonumber(cooldown) or 0.08, 0, 3) + 0.001
            COMBAT.meleeSinceSkill = requested == true or COMBAT.meleeSinceSkill
            if requested then
                COMBAT.meleeChain = (COMBAT.meleeChain or 0) + 1
                COMBAT.metrics.meleeExecuted = (COMBAT.metrics.meleeExecuted or 0) + 1
            end
        end
    end)
    COMBAT.actionBusy = false
    if not ok then error(why) end
end
function farmTick(mob, clearanceTarget)
    if _stopped then return end
    if COMBAT.potionBusy then STATE.farmStatus = COMBAT.potionStatus or "Drinking"; return end
    if mob and typeof(mob.center) == "Vector3" then
        STATE.resumeCombat = { position = mob.center, epoch = STATE.activityEpoch }
    end
    local hum = getHum()
    if not hum or hum.Health <= 0 then STATE.farmStatus = "Dead"; stopLock(); return end
    if mob then STATE.targetIsBoss = mob.boss == true end
    local hpPct = hum.Health / math.max(1, hum.MaxHealth) * 100
    COMBAT.retreating = COMBAT.shouldRetreat(hpPct)
    local priority = clearanceTarget or COMBAT.priorityTarget(mob)
    if priority and STATE.target ~= priority.model then
        lockTo(priority.model)
        STATE.targetName = priority.name
        STATE.farmStatus = ("Nearby enemies: %d threatening combat"):format(STATE.nearbyHostiles or 0)
        return
    elseif not priority and STATE.target and mob and (not STATE.target.Parent or STATE.target.Parent.Name ~= mob.folderName) then
        stopLock()
    end
    local t = STATE.target
    local tHum = t and t.Parent and t:FindFirstChildOfClass("Humanoid")
    if not (t and t.Parent and tHum and tHum.Health > 0) then
        if tHum and tHum.Health <= 0 then COMBAT.recordDefeat(t) end
        stopLock()
        if STATE.postKill then STATE.farmStatus = "Collecting kill rewards"; return end
        local e = findTarget(mob)
        if e then
            lockTo(e.model)
            STATE.targetName = e.name
            STATE.farmStatus = "Fighting " .. e.name
        else
            STATE.farmStatus = "Waiting for spawn: " .. (mob and mob.name or "?")
            -- mobs only (re)spawn with a player nearby: patrol the spawn locations while waiting
            local hrp = getHRP()
            if mob and hrp then
                local locs = mob.locs or { mob.center }
                local idx = (math.floor(os.clock() / 4) % #locs) + 1
                local want = locs[idx] + Vector3.new(0, 14, 0)
                if (hrp.Position - want).Magnitude > 3 then tpCF(CFrame.new(want)) end
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
        return
    end
    COMBAT.attackTick(t)
end

-- === AUTO QUEST (repeatable combat quests = best XP loop) ===
-- Boss hunt missions: Kasugai Crow (slayer/hybrid) and Muzan (demon/hybrid) sides, same board + module.
STATE.hunts = { module = safeReq("CAM.Global.Subsets.Gameplay.Quests.BossHunts"), lastTry = 0, status = "Idle", activeSince = 0, stallUntil = 0 }
function huntSideEnabled(side)
    if side == "Crow" then return CFG.autoCrow end
    if side == "Muzan" then return CFG.autoMuzan end
    return false
end
function STATE.hunts.offers()
    local board = RS:FindFirstChild("BossHunts")
    local hunts = STATE.hunts.module
    local offers = {}
    if not board or not hunts then return offers end
    local now = workspace:GetServerTimeNow()
    for _, offer in ipairs(board:GetChildren()) do
        local boss = offer:GetAttribute("Boss")
        local name = offer:GetAttribute("Quest")
        local expires = offer:GetAttribute("ExpiresAt")
        local entry = boss and hunts.Entry(boss)
        local side = offer:GetAttribute("Side") or (entry and entry.Side)
        if entry and huntSideEnabled(entry.Side) and (not side or side == entry.Side)
            and type(expires) == "number" and expires > now + 5 and name == hunts.QuestName(boss)
            and asGame(function() return hunts.Eligible(entry, LP) end) then
            local mob = mobByCode(entry.Code)
            if mob and not STATE.avoidBoss(mob.name) then
                local rewards = hunts.Rewards(entry)
                offers[#offers + 1] = { instance = offer, name = name, boss = boss, mob = mob,
                    expires = expires, exp = rewards.Exp or 0, wen = rewards.Wen or 0,
                    minimumLevel = entry.MinLevel, side = entry.Side }
            end
        end
    end
    table.sort(offers, function(first, second)
        if first.minimumLevel ~= second.minimumLevel then return first.minimumLevel < second.minimumLevel end
        if first.expires ~= second.expires then return first.expires < second.expires end
        return first.name < second.name
    end)
    return offers
end
function STATE.hunts.active()
    local hunts = STATE.hunts.module
    if not hunts then return nil end
    for _, name in ipairs(activeQuestNames()) do
        local quest = questInfo(name)
        if quest and quest.Category == "BossHunt" and questState(name) == "Doing" then
            for _, entry in ipairs(hunts.Hunts) do
                if hunts.QuestName(hunts.Npc(entry)) == name then
                    return { name = name, side = entry.Side, mob = mobByCode(entry.Code) }
                end
            end
        end
    end
    return nil
end
function STATE.hunts.tick()
    if _stopped or IN_MINIGAME or not CFG.autoQuests or not alive() then return false end
    if not huntSideEnabled("Crow") and not huntSideEnabled("Muzan") then return false end
    local manager = STATE.hunts
    local active = manager.active()
    if active then
        manager.pending = nil
        if not huntSideEnabled(active.side) then manager.status = "Another boss hunt is active"; return false end
        if active.mob and STATE.avoidBoss(active.mob.name) then
            manager.status = ("Skipped %s after %d deaths; ordinary quests continue"):format(active.name, STATE.bossDeaths[active.mob.name] or 0)
            STATE.questStatus = manager.status
            return false
        end
        manager.status = "Active: " .. active.name
        STATE.questStatus = manager.status
        if active.mob then
            STATE.targetIsBoss = true
            farmTick(active.mob)
            return true
        end
        stopLock()
        manager.status = "Hunt target not in database; ordinary quests continue"
        STATE.questStatus = manager.status
        return false
    end
    if manager.pending then manager.status = "Claim not confirmed: " .. manager.pending; return false end
    if os.clock() - manager.lastTry < 8 then return false end
    manager.lastTry = os.clock()
    local offers = manager.offers()
    manager.status = #offers == 0 and "No eligible hunt missions" or "Waiting for an available mission"
    for _, offer in ipairs(offers) do
        local quest = questInfo(offer.name)
        if quest and (tonumber(quest.WenCostOnAccept) or 0) == 0 and not quest.ItemCostOnAccept
            and canAddQuest(offer.name) and offer.instance.Parent == RS:FindFirstChild("BossHunts")
            and (offer.instance:GetAttribute("ExpiresAt") or 0) > workspace:GetServerTimeNow() + 5 then
            local epoch, character = STATE.activityEpoch, getChar()
            stopLock()
            manager.pending = offer.name
            manager.status = "Claiming: " .. offer.name
            STATE.questStatus = manager.status
            local sent, why = pcall(toServer, "BossHuntsRequest", { action = "Claim", id = offer.instance.Name })
            if not sent then manager.status = "Claim error: " .. tostring(why); return true end
            local deadline = os.clock() + 3
            repeat
                if _stopped or not CFG.autoQuests or STATE.activityEpoch ~= epoch
                    or getChar() ~= character or not alive() then return true end
                if not huntSideEnabled(offer.side) then return true end
                if questState(offer.name) == "Doing" then
                    manager.pending = nil
                    manager.status = "Active: " .. offer.name
                    STATE.questStatus = manager.status
                    return true
                end
                task.wait(0.1)
            until os.clock() >= deadline
            manager.status = "Claim not confirmed: " .. offer.name
            STATE.questStatus = manager.status
            return true
        end
    end
    return false
end
function STATE.hunts.describe()
    local lines = { STATE.hunts.status }
    local active = STATE.hunts.active()
    if active then lines[#lines + 1] = active.name end
    for _, offer in ipairs(STATE.hunts.offers()) do
        local remaining = math.max(0, math.floor(offer.expires - workspace:GetServerTimeNow()))
        lines[#lines + 1] = ("%s | Lv %d+ | %02d:%02d"):format(offer.boss, offer.minimumLevel,
            math.floor(remaining / 60), remaining % 60)
    end
    return table.concat(lines, "\n")
end
function eligibleCombatQuests()
    local out = {}
    local lvl = getLevel()
    for qn, q in pairs(DB.quests) do
        if q.Category == "Combat" and q._mobCode and q.OfferNpc and DB.npcs[q.OfferNpc] and not q.LogCompletion and questState(qn) ~= "Done" then
            local mob = mobByCode(q._mobCode)
            if mob and passes(q.Requirements) and (not mob.boss or CFG.autoBoss) and levelOK(mob) then
                local rw = q.Rewards or {}
                local exp, wen = rw.Exp or 0, rw.Wen or 0
                local kills = q._killMax or 1
                -- per-kill value: quest reward spread over the kills + the mob's own drop (~2.7 XP / ~1.2 Wen per mob level)
                local perKill = (CFG.questGoal == "Wen") and (wen / kills + (mob.level or 1) * 1.2) or (exp / kills + (mob.level or 1) * 2.7)
                local score = perKill * (mob.boss and 0.4 or 1)
                out[#out + 1] = { name = qn, q = q, mob = mob, score = score, exp = exp, wen = wen }
            end
        end
    end
    table.sort(out, function(a, b) return a.score > b.score end)
    return out
end

function questTick()
    local epoch = STATE.activityEpoch
    local function cancelled() return _stopped or STATE.activityEpoch ~= epoch end
    if STATE.currentQuest then
        local st = questState(STATE.currentQuest)
        if st ~= "Doing" then
            notify("Quest", "Completed: " .. STATE.currentQuest)
            STATE.currentQuest = nil
            STATE.lastQuestTry = os.clock()
        else
            return
        end
    end
    if os.clock() - STATE.lastQuestTry < 5 then return end
    local cooldown = questCooldownLeft()
    if cooldown > 0 then STATE.questStatus = ("Quest cooldown: %ds; farming continues"):format(math.ceil(cooldown)); return end
    STATE.lastQuestTry = os.clock()
    for _, n in ipairs(activeQuestNames()) do
        local q = DB.quests[n]
        if q and q.Category == "Combat" then STATE.currentQuest = n; STATE.questStatus = "Active: " .. n; return end
    end
    local list = eligibleCombatQuests()
    STATE.questLog = {}
    STATE.questStatus = #list == 0 and "No eligible repeatable quest; farming continues" or "Checking repeatable quests"
    for i, e in ipairs(list) do
        if i > 2 then break end -- at most two NPC visits per attempt; retry next tick
        if cancelled() then return end
        if (tonumber(e.q.WenCostOnAccept) or 0) > 0 then
            STATE.questLog[#STATE.questLog + 1] = e.name .. ": paid quest skipped"
        elseif canAddQuest(e.name) then
            stopLock()
            STATE.farmStatus = "Accepting quest " .. e.name
            local ok, why = acceptQuest(e.name, cancelled)
            if cancelled() then return end
            if ok then
                STATE.currentQuest = e.name
                STATE.questStatus = "Active: " .. e.name
                notify("Quest", "Accepted: " .. e.name .. " (+" .. e.exp .. " XP)")
                return
            end
            STATE.questLog[#STATE.questLog + 1] = e.name .. ": " .. tostring(why)
            warn("[Pkaizen] quest accept failed " .. e.name .. ": " .. tostring(why))
        else
            STATE.questLog[#STATE.questLog + 1] = e.name .. ": CanAddQuest=false"
        end
    end
    if #STATE.questLog > 0 then STATE.questStatus = table.concat(STATE.questLog, " | ") end
end

-- === STORY QUESTS (one-time Pickup / Deliver quests: big XP for little work) ===
function doStoryQuest(qn, log)
    local epoch = STATE.activityEpoch
    local function cancelled() return _stopped or STATE.activityEpoch ~= epoch end
    log = log or function() end
    local q = questInfo(qn)
    if not q or not q.TaskSpecs then return false, "no tasks" end
    for tn, spec in pairs(q.TaskSpecs) do
        if spec.Type ~= "Pickup" and spec.Type ~= "Deliver" then return false, "unsupported task " .. tostring(spec.Type) end
    end
    if questState(qn) ~= "Doing" then
        local ok, why = acceptQuest(qn, cancelled)
        if not ok then return false, why end
    end
    -- pickups first, then deliveries (deliveries usually need the picked item)
    local order = {}
    for tn, spec in pairs(q.TaskSpecs) do order[#order + 1] = { tn = tn, spec = spec, prio = spec.Type == "Pickup" and 0 or 1 } end
    table.sort(order, function(a, b) return a.prio < b.prio end)
    for _, t in ipairs(order) do
        if cancelled() then return false, "stopped" end
        local spec = t.spec
        if spec.Type == "Pickup" then
            local prog = questTaskProgress(qn)
            local need = prog and prog[t.tn] and prog[t.tn].max or 1
            local function cur() local pr = questTaskProgress(qn) return pr and pr[t.tn] and pr[t.tn].value or need end
            if type(spec.Positions) == "function" then
                -- randomised props around an anchor (e.g. 500 coins): server validates proximity to the anchor,
                -- so stand on it and claim every slot in a loop (~0.25s spacing is accepted)
                local anchor = spec.Anchor
                if typeof(anchor) ~= "Vector3" then local ok, p = pcall(spec.Positions, 1) anchor = ok and p or nil end
                if typeof(anchor) ~= "Vector3" then return false, "no anchor for " .. t.tn end
                local slots = spec.SpawnCount or 1
                tpPos(anchor, 2.5); if not STATE.waitActivity(epoch, 0.8) then return false, "stopped" end
                local stalled = 0
                while cur() < need and not cancelled() and stalled < 3 do
                    local before = cur()
                    for i = 1, slots do
                        if cur() >= need or cancelled() then break end
                        toServer("QuestProgress", qn, t.tn, i)
                        if not STATE.waitActivity(epoch, 0.5) then return false, "stopped" end
                    end
                    log(("Pickup %s %d/%d"):format(t.tn, cur(), need))
                    if not STATE.waitActivity(epoch, 0.6) then return false, "stopped" end
                    if cur() <= before then
                        stalled = stalled + 1
                        -- fallback: walk to the client-side props (named "<ObjectText><i>") one by one
                        for i = 1, slots do
                            if cancelled() then return false, "stopped" end
                            local prop = workspace:FindFirstChild((spec.ObjectText or "Pickup") .. i)
                            if prop and cur() < need then
                                local ok, p = pcall(function() return prop:GetPivot().Position end)
                                if ok then
                                    tpPos(p, 2); if not STATE.waitActivity(epoch, 0.5) then return false, "stopped" end
                                    toServer("QuestProgress", qn, t.tn, i)
                                    if not STATE.waitActivity(epoch, 0.5) then return false, "stopped" end
                                end
                            end
                        end
                        tpPos(anchor, 2.5); if not STATE.waitActivity(epoch, 0.5) then return false, "stopped" end
                    else
                        stalled = 0
                    end
                end
            else
                local positions = spec.Positions or {}
                for i, p in ipairs(positions) do
                    if cancelled() then return false, "stopped" end
                    if typeof(p) == "Vector3" and cur() < need then
                        log(("Pickup %s %d/%d"):format(t.tn, i, #positions))
                        tpPos(p, 2.5); if not STATE.waitActivity(epoch, 0.8) then return false, "stopped" end
                        toServer("QuestProgress", qn, t.tn, i)
                        if not STATE.waitActivity(epoch, 0.6) then return false, "stopped" end
                    end
                end
            end
        elseif spec.Type == "Deliver" then
            local npc = spec.TargetNpc and DB.npcs[spec.TargetNpc]
            if not npc then return false, "deliver npc unknown " .. tostring(spec.TargetNpc) end
            log("Deliver: " .. t.tn)
            tpPos(npc.pos, 3); if not STATE.waitActivity(epoch, 0.9) then return false, "stopped" end
            toServer("QuestProgress", qn, t.tn)
            if not STATE.waitActivity(epoch, 0.8) then return false, "stopped" end
        end
    end
    local t0 = os.clock()
    while os.clock() - t0 < 4 do
        if cancelled() then return false, "stopped" end
        if questState(qn) ~= "Doing" then return true end
        task.wait(0.3)
    end
    return questState(qn) ~= "Doing", "tasks not all validated"
end

-- An already-active quest whose Pickup/Deliver tasks are not finished (e.g. accepted by hand or interrupted).
function unfinishedStoryQuest()
    for _, qn in ipairs(activeQuestNames()) do
        local q = questInfo(qn)
        local prog = questTaskProgress(qn)
        if q and q.TaskSpecs and prog then
            for tn, spec in pairs(q.TaskSpecs) do
                local p = prog[tn]
                if (spec.Type == "Pickup" or spec.Type == "Deliver") and p and p.value < p.max then return qn end
            end
        end
    end
end

function storyCandidates()
    local out = {}
    for qn, q in pairs(DB.quests) do
        if q.LogCompletion and q.TaskSpecs and q.OfferNpc and DB.npcs[q.OfferNpc] and questState(qn) == "None" and passes(q.Requirements) then
            local ok = true
            for _, spec in pairs(q.TaskSpecs) do if spec.Type ~= "Pickup" and spec.Type ~= "Deliver" then ok = false end end
            if q.ConsumeItemOnAccept or q.ItemCostOnAccept then ok = false end
            if q.WenCostOnAccept and (not CFG.storyAllowWenCost or getWen() < q.WenCostOnAccept) then ok = false end
            if ok then out[#out + 1] = { name = qn, exp = (q.Rewards and q.Rewards.Exp) or 0 } end
        end
    end
    table.sort(out, function(a, b) return a.exp > b.exp end)
    return out
end

