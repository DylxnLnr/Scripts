-- === AUTO BAIT BUY (experimental, off by default) ===
-- Best buyable bait = Fish Head (+0.10 CatchChance, 9 Wen) from Baitmonger Nori in Hidden Mist Village (quest
-- required), fallback Worm (+0.05, 6 Wen) from Fisherman Jeso on the Mistfall Harbor dock.
-- The Drowned Lure (+0.25) is Unique/NoPrice -> not for sale, so it can never be bought.
-- Baits are NOT in Shop.Content, and the NPC shop is opened SERVER side through the NPC ProximityPrompt
-- (OpenDialogue is a server->client signal, the client cannot request it). So we teleport to the seller, hold its
-- prompt like a player would, wait for the server to add the bait to Shop.itemsforsale, then validate with
-- Shop.CanBuy exactly like the market feature, buy, and walk back to the dock.
-- Hard capped to 2 attempts per session, after which it switches itself off instead of looping teleports.
local BAIT_SELLERS = { ["Fish Head"] = "Baitmonger Nori", Worm = "Fisherman Jeso" }
local BAIT_ORDER = { "Fish Head", "Worm" }
function baitBuyStop(reason)
    FISH.needBait, FISH.baitBuyOff = false, true
    fishLog("Auto bait buy off: " .. reason)
end
function baitQuote(name, cap)
    return asGame(function()
        local listing = Shop.itemsforsale[name]
        -- NPC shop listings are added by Shop.RegisterItem(name, { AlsoSoldBy = {...} }) and have NO "Type" field
        -- (only rotating market listings do), so Type must NOT be required here or every bait is refused.
        if not listing or listing.NoSave or type(listing.Price) ~= "table" then
            return nil, name .. " is not in this shop"
        end
        for currency in pairs(listing.Price) do if currency ~= "Wen" then return nil, name .. " is not sold for Wen" end end
        local totals, count = Shop.GetCartTotals({ [name] = 1 }, LP)
        local price = totals and totals.Wen
        if type(price) ~= "number" or price ~= price or price < 0 or price == math.huge or (count and count ~= 1) then
            return nil, "no price for " .. name
        end
        if cap and price > cap then return nil, ("%s costs %d Wen, over your %d cap"):format(name, price, cap) end
        if getWen() - price < (CFG.baitBuyReserve or 500) then return nil, "Wen reserve protected" end
        local data = getData()
        if not data then return nil, "no player data" end
        local allowed, why = Shop.CanBuy(LP, name, data, 1)
        if not allowed then return nil, tostring(why or "requirements not met") end
        return { name = name, price = price, before = invAmount(name) }
    end)
end
function baitListed(name)
    local ok, v = pcall(function() return asGame(function() return Shop.itemsforsale[name] ~= nil end) end)
    return ok and v
end
function baitNpcPrompt(seller)
    local model, exact
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") then
            if d.Name == seller then model, exact = d, true break end
            if not model and d.Name:find(seller, 1, true) then model = d end
        end
    end
    if not model then return nil end
    local best
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local text = (d.ActionText or "") .. " " .. (d.ObjectText or "")
            if text:lower():find("shop", 1, true) or text:lower():find("bait", 1, true) then return d end
            if d.Name == "Shop" or d.Name == "Dialogue" or d.Name == "Open" then return d end
            if d.Enabled and not best then best = d end
        end
    end
    return best, exact
end
function baitOpenShop(name)
    local seller = BAIT_SELLERS[name]
    local prompt = baitNpcPrompt(seller)
    if not prompt then return false, "no ProximityPrompt on " .. tostring(seller) end
    local anchor = prompt.Parent and prompt.Parent:IsA("BasePart") and prompt.Parent.Position
    local root = getHRP()
    if root and anchor and (root.Position - anchor).Magnitude > math.max(4, prompt.MaxActivationDistance - 2) then
        stopLock(); tpPos(anchor, 0); task.wait(0.4)
    end
    -- Deliberately NOT LOOT.holdPrompt: it refuses when LOOT.safe() is false, and LOOT.safe() rejects any position
    -- with a live mob within 30 studs. Hidden Mist Village is populated, so the shop prompt was never triggered there.
    pcall(function() asGame(function() prompt:InputHoldBegin() end) end)
    if typeof(fireproximityprompt) == "function" then
        pcall(function() asGame(function() fireproximityprompt(prompt) end) end)
    end
    local deadline = os.clock() + 4
    while not baitListed(name) and os.clock() < deadline do
        if _stopped then return false, "stopped", prompt end
        task.wait(0.1)
    end
    if not baitListed(name) then
        pcall(function() asGame(function() prompt:InputHoldEnd() end) end)
        return false, "server did not list " .. name .. " for " .. tostring(seller), prompt
    end
    -- NB: do NOT InputHoldEnd here. Closing the dialogue ends the server side shop session and the following
    -- PurchaseFromShop is silently refused; the prompt is released once the purchase is done.
    return true, nil, prompt
end
function baitReleasePrompt(prompt)
    if prompt then pcall(function() asGame(function() prompt:InputHoldEnd() end) end) end
end
-- SellItems is fired from GinzoSell, a merchant dialogue action, and the dock is ~2400 studs from Ginzo, so the
-- server refuses a sale made from there. Go to the merchant, hold its prompt, sell, then walk back to the dock.
local MERCHANT_SPOTS = { Ginzo = Vector3.new(1869.092, 687.835, -734.628) }
function merchantOpen(name)
    local n = DB.npcs and DB.npcs[name]
    local pos = (n and n.pos) or MERCHANT_SPOTS[name]
    if not pos then return nil end
    stopLock(); tpPos(pos, 3); task.wait(0.8)
    if _stopped then return nil end
    local prompt = baitNpcPrompt(name)
    if not prompt then return nil end
    local root = getHRP()
    local anchor = prompt.Parent and prompt.Parent:IsA("BasePart") and prompt.Parent.Position
    if root and anchor and (root.Position - anchor).Magnitude > math.max(4, prompt.MaxActivationDistance - 2) then
        stopLock(); tpPos(anchor, 0); task.wait(0.4)
    end
    pcall(function() asGame(function() prompt:InputHoldBegin() end) end)
    if typeof(fireproximityprompt) == "function" then
        pcall(function() asGame(function() fireproximityprompt(prompt) end) end)
    end
    task.wait(0.6)
    return prompt
end
function baitBuyOne(name, cap, qty)
    local npc = DB.npcs and DB.npcs[BAIT_SELLERS[name]]
    if not (npc and npc.pos) then baitBuyStop("seller " .. tostring(BAIT_SELLERS[name]) .. " not found"); return false end
    if not (Shop and SF) then return false end
    stopLock()
    tpPos(npc.pos, 3)
    task.wait(0.8)
    if _stopped or not CFG.autoFish then return false end
    local opened, why, prompt = baitOpenShop(name)
    if not opened then baitBuyStop(tostring(why or "could not open the shop")); return false end
    local order, reason = baitQuote(name, cap)
    if not order then baitReleasePrompt(prompt); baitBuyStop(tostring(reason or "quote failed")); return false end
    -- The game buys with a single call: SignalEvent.ToServer("PurchaseFromShop", name, Shop.SanitizeAmount(amount)),
    -- and the in-game "max" button is math.clamp(math.floor(Wen / price), 1, 99). Mirror both, so one trip buys the
    -- whole stack instead of firing one remote per bait.
    local amount = asGame(function() return Shop.SanitizeAmount(qty or 99) end)
    local budget = math.floor(math.max(0, getWen() - (CFG.baitBuyReserve or 500)) / math.max(1, order.price))
    amount = math.max(1, math.min(amount, budget, 99))
    local allowed, whyBuy = asGame(function() return Shop.CanBuy(LP, name, getData(), amount) end)
    if not allowed then
        baitReleasePrompt(prompt)
        fishLog(("Bait: %s x%d refused at %s - %s"):format(name, amount, BAIT_SELLERS[name], tostring(whyBuy or "not allowed")))
        return false
    end
    local sent = pcall(function() return asGame(function() return SF.ToServer("PurchaseFromShop", name, amount) end) end)
    local deadline = os.clock() + 4
    while sent and os.clock() < deadline do
        if invAmount(name) >= order.before + amount then break end
        task.wait(0.1)
    end
    baitReleasePrompt(prompt)
    local got = math.max(0, invAmount(name) - order.before)
    if not sent or got <= 0 then
        fishLog(("Bait: %s refused the purchase at %s (asked x%d)"):format(name, BAIT_SELLERS[name], amount))
        return false
    end
    fishLog(("Bought %s x%d for %d Wen at %s"):format(name, got, order.price * got, BAIT_SELLERS[name]))
    return true
end
function baitAutoBuy()
    if not CFG.autoFish or CFG.autoBait == false or CFG.baitBuy == false or FISH.baitBuyOff then return false end
    if not FISH.needBait then return false end
    if os.clock() < (FISH.nextBuyBait or 0) then return false end
    FISH.baitBuyTries = (FISH.baitBuyTries or 0) + 1
