function CRAFT.market.snapshot(name)
    local vendor = CRAFT.market.vendors[name]
    if not vendor then return nil end
    return asGame(function()
        local config = vendor.config
        local service = vendor.timed and CRAFT.market.timed or CRAFT.market.rotating
        if not service then return nil end
        local cycle, active, remaining
        if vendor.timed then
            local state = service.GetState(config)
            cycle, active, remaining = state.Cycle, state.Active, state.NextEdgeIn
        else
            cycle, active = service.GetCycleIndex(config), true
            remaining = service.GetEvery(config) - workspace:GetServerTimeNow() % service.GetEvery(config)
        end
        local function stock(index)
            local rows = vendor.timed and service.GetStock(config, index) or service.GetRotation(config, index)
            local names = {}
            for _, row in ipairs(rows) do names[#names + 1] = type(row) == "string" and row or row.Name end
            table.sort(names)
            return names
        end
        return { cycle = cycle, active = active, remaining = math.max(0, math.ceil(remaining)),
            current = stock(cycle), upcoming = stock(cycle + 1), vendor = vendor }
    end)
end
function CRAFT.market.amount(name)
