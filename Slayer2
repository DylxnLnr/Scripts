function FSR.holdLever(sw, prompt, root)
    local lever = sw:FindFirstChild("A_")
    if lever and lever:GetAttribute("On") == true then return true end
    local anchor = prompt.Parent
    local position = anchor and (anchor:IsA("Attachment") and anchor.WorldPosition or anchor:IsA("BasePart") and anchor.Position)
    if typeof(position) ~= "Vector3" then return false, "missing prompt anchor" end
    local character, epoch = getChar(), STATE.activityEpoch
    local values = getValues()
    local training = values and values:FindFirstChild("Training")
    if not training or training:GetAttribute("Type") ~= "Parkour Dungeon" then return false, "cancelled" end
    local frame = CFrame.new(position + Vector3.new(0, 1, 3), position)
    local connection
    local callbacks = {}
    if typeof(getconnections) == "function" then
        for _, name in ipairs({ "PromptButtonHoldBegan", "Triggered", "PromptButtonHoldEnded" }) do
            for _, signalConnection in ipairs(getconnections(prompt[name])) do
                local callback = signalConnection.Function
                if signalConnection.Enabled ~= false and type(callback) == "function" then
                    local identified, source = pcall(debug.info, callback, "s")
                    if identified and source == "ReplicatedStorage.CAM.Global.Training.Parkour Dungeon.lever" then
                        callbacks[name] = callback
                        break
                    end
                end
            end
        end
    end
    local native = callbacks.PromptButtonHoldBegan and callbacks.Triggered and callbacks.PromptButtonHoldEnded
    local holdThread, holdError
    local function cancelled()
        return _stopped or not CFG.autoFinalSelection or STATE.activityEpoch ~= epoch or getChar() ~= character
            or not alive() or getHRP() ~= root or not prompt.Parent or not sw.Parent
            or not training.Parent or values:FindFirstChild("Training") ~= training
    end
    local function confirmed() return lever and lever:GetAttribute("On") == true end
    local ok, result, reason = pcall(function()
        local function stabilize()
            if not cancelled() then
                root.CFrame = frame
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end
        connection = RunService.Heartbeat:Connect(stabilize)
        stabilize()
        if not FSR.wait(0.6) or cancelled() then return false, "cancelled" end
        local cooldownDeadline = os.clock() + 3
        while prompt:GetAttribute("OnCooldown") do
            if os.clock() >= cooldownDeadline then return false, "prompt cooldown" end
            if not FSR.wait(0.1) or cancelled() then return false, "cancelled" end
        end
        if not prompt.Enabled then return confirmed() == true, "prompt disabled" end
        local beganAt
        if native then
            holdThread = task.spawn(function()
                local started, err = pcall(function()
                    asGame(function()
                        if cancelled() then return end
                        beganAt = os.clock()
                        callbacks.PromptButtonHoldBegan(LP)
                    end)
                end)
                if not started then holdError = tostring(err) end
            end)
        else
            asGame(function() prompt:InputHoldBegin() end)
            beganAt = os.clock()
        end
        local startDeadline = os.clock() + 1
        while not beganAt do
            if holdError then return false, holdError end
            if os.clock() >= startDeadline then return false, "hold did not start" end
            if not FSR.wait(0.05) or cancelled() then return false, "cancelled" end
        end
        local deadline = beganAt + prompt.HoldDuration + (native and 0.3 or 1.5)
        repeat
            if not FSR.wait(0.1) or cancelled() then return false, "cancelled" end
            if holdError then return false, holdError end
            if confirmed() then return true end
        until os.clock() >= deadline
        local currentPosition = anchor:IsA("Attachment") and anchor.WorldPosition or anchor.Position
        if prompt.Enabled and (root.Position - currentPosition).Magnitude <= prompt.MaxActivationDistance then
            if native then asGame(function() callbacks.Triggered(LP) end)
            elseif typeof(fireproximityprompt) == "function" then asGame(function() fireproximityprompt(prompt) end) end
        end
        if not FSR.wait(0.8) or cancelled() then return false, "cancelled" end
        return confirmed() == true, "activation not confirmed"
    end)
    pcall(function()
        asGame(function()
            if native then callbacks.PromptButtonHoldEnded(LP) else prompt:InputHoldEnd() end
        end)
    end)
    if holdThread and coroutine.status(holdThread) ~= "dead" then pcall(task.cancel, holdThread) end
    if connection then connection:Disconnect() end
    if not ok then return false, tostring(result) end
    return result, reason
end
function fsDungeon(qn, tn)
    -- Parkour Dungeon = training session: pull the 7 levers (server checks 20 studs), then Stop within 75 studs of "Final"
    local vals = getValues()
    local tr = vals and vals:FindFirstChild("Training")
    local pt = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("DetachedMaps") and workspace.Map.DetachedMaps:FindFirstChild("ParkourTraining")
