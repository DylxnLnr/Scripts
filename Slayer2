function CRAFT.market.quote()
    local market = CRAFT.market
    local name, vendor = CFG.marketWanted, CFG.marketVendor
    local data = getData()
    if not (data and Shop and SF) or not alive() then return nil, "Character or shop unavailable" end
    if name == "" or not (Items and Items[name]) then return nil, "Choose an inventory item" end
    for _, key in ipairs({ "marketTarget", "marketMaxPrice", "marketBudget", "marketReserve" }) do
        local value = CFG[key]
        if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then return nil, "Invalid purchase limit" end
    end
    if CFG.marketTarget < 1 or CFG.marketTarget > 99 or CFG.marketTarget % 1 ~= 0 then return nil, "Target must be 1 to 99" end
    if market.amount(name) >= CFG.marketTarget then return nil, "Target quantity reached" end
    if CFG.marketMaxPrice <= 0 or CFG.marketBudget <= 0 then return nil, "Set maximum price and session budget first" end
    local snapshot = market.snapshot(vendor)
    if not snapshot or not snapshot.active or not table.find(snapshot.current, name) then return nil, "Waiting for selected vendor stock" end
    if snapshot.remaining <= 8 then return nil, "Waiting for stable market rotation" end
    if not market.near(vendor) then return nil, "Waiting within 10 studs of " .. vendor end
    return asGame(function()
        local listing = Shop.itemsforsale[name]
        if not listing or listing.Type ~= "Item" or listing.NoSave or type(listing.Price) ~= "table" then return nil, "No supported active listing" end
        for currency in pairs(listing.Price) do if currency ~= "Wen" then return nil, "Only Wen purchases allowed" end end
        local totals, count = Shop.GetCartTotals({ [name] = 1 }, LP)
        local price = totals and totals.Wen
        if count ~= 1 or type(price) ~= "number" or price ~= price or price < 0 or price == math.huge then return nil, "Price unavailable" end
        for currency in pairs(totals) do if currency ~= "Wen" then return nil, "Only Wen purchases allowed" end end
        if price > CFG.marketMaxPrice then return nil, "Price exceeds maximum" end
        if market.spent + price > CFG.marketBudget then return nil, "Session budget exhausted" end
        if getWen() - price < CFG.marketReserve then return nil, "Wen reserve protected" end
        local allowed, reason = Shop.CanBuy(LP, name, data, 1)
        if not allowed then return nil, tostring(reason or "Purchase requirements not met") end
        return { name = name, vendor = vendor, data = data, price = price, before = market.amount(name), wen = getWen() }
    end)
end
function CRAFT.market.buy()
    local market = CRAFT.market
    if market.busy or _stopped or not CFG.marketAutoBuy then return end
    market.busy = true
    local ok, err = pcall(function()
        local order, reason = market.quote()
        if not order then
            market.status = reason
            if reason == "Target quantity reached" then CFG.marketAutoBuy = false end
            return
        end
        if _stopped or not CFG.marketAutoBuy or getData() ~= order.data
            or CFG.marketWanted ~= order.name or CFG.marketVendor ~= order.vendor then return end
        market.status = "Buying one " .. order.name
        market.spent = market.spent + order.price
        local sent = pcall(function()
            return asGame(function() return SF.ToServer("PurchaseFromShop", order.name, 1) end)
        end)
        local deadline = os.clock() + 3
        while sent and getData() == order.data and market.amount(order.name) <= order.before and os.clock() < deadline do task.wait(0.1) end
        if not sent or getData() ~= order.data or market.amount(order.name) <= order.before then
            CFG.marketAutoBuy = false
            market.status = "Purchase unconfirmed; paused, budget reserved"
            return
        end
        market.spent = market.spent + math.max(0, order.wen - getWen() - order.price)
        market.bought = (market.bought or 0) + 1
        STATE.webhook.record("Bought " .. order.name .. " (" .. order.price .. " Wen)", "Market")
        market.status = "Received " .. order.name
        if CFG.marketWanted == order.name and market.amount(order.name) >= CFG.marketTarget then CFG.marketAutoBuy = false end
    end)
    market.busy = false
    if not ok then CFG.marketAutoBuy = false; market.status = "Purchase paused: " .. tostring(err) end
    syncUI()
end
