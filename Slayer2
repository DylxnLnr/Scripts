    end
    FISH.pendingCatch, FISH.catchSince = nil, nil
    if line then
        if os.clock() - FISH.castT > 35 then
            FISH.status = "Line stuck, reeling in"
            castCmd(spot.cast); FISH.castT = os.clock()
            return
        end
        FISH.status = ("Waiting for a bite (%ds)   |   %d casts, %d catches, %d Wen sold"):format(math.floor(os.clock() - FISH.castT), FISH.casts, FISH.catches, FISH.soldWen)
        return
    end
