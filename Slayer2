function FISH.collectPosition(prompt, standPos)
    local root = prompt and prompt.Parent
    local target = root and (root:IsA("Attachment") and root.WorldPosition or root:IsA("BasePart") and root.Position)
    local hrp, hum = getHRP(), getHum()
    if not (standPos and hrp and hum) or (prompt and not target) then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { getChar() }
    for _, name in ipairs({ "Debree", "Humanoids" }) do
        local folder = workspace:FindFirstChild(name)
        if folder then excluded[#excluded + 1] = folder end
    end
    params.FilterDescendantsInstances = excluded
    params.RespectCanCollide = true
    local samples = { standPos }
    if prompt then
        samples[#samples + 1] = hrp.Position
        for _, radius in ipairs({ 4, 8, 12 }) do
            for index = 1, 12 do
                local angle = index * math.pi / 6
                samples[#samples + 1] = standPos + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
            end
        end
    end
    local best, distance
    local height = hum.HipHeight + hrp.Size.Y / 2 + 0.15
    for _, sample in ipairs(samples) do
        local horizontal = Vector3.new(sample.X - standPos.X, 0, sample.Z - standPos.Z).Magnitude
        if horizontal <= 16 then
            local hit = workspace:Raycast(Vector3.new(sample.X, standPos.Y + 12, sample.Z), Vector3.new(0, -32, 0), params)
            if hit and hit.Material ~= Enum.Material.Water and hit.Normal.Y >= 0.8 and hit.Position.Y >= standPos.Y - 6 then
                local point = hit.Position + Vector3.new(0, height, 0)
                local headroom = workspace:Raycast(hit.Position + Vector3.new(0, 0.2, 0), Vector3.new(0, height + 2, 0), params)
                local blocked = prompt and prompt.RequiresLineOfSight and workspace:Raycast(point, target - point, params)
                local travel = (point - hrp.Position).Magnitude
                if not headroom and not blocked and (not prompt or (point - target).Magnitude <= math.max(0, prompt.MaxActivationDistance - 0.75))
                    and (not distance or travel < distance) then
                    best, distance = point, travel
                end
            end
        end
    end
    return best
end
function FISH.pickupStep(origin, target, standPos)
    local direction = Vector3.new(target.X - origin.X, 0, target.Z - origin.Z)
    if direction.Magnitude < 0.1 then return nil end
    local candidate = origin + direction.Unit * math.min(1, direction.Magnitude)
    local ground = FISH.collectPosition(nil, candidate)
    if not ground or (ground - origin).Magnitude > 2 or math.abs(ground.Y - origin.Y) > 0.5 then return nil end
    if standPos and Vector3.new(ground.X - standPos.X, 0, ground.Z - standPos.Z).Magnitude > 4 then return nil end
    return ground
end
function FISH.stopWalk()
    local walk = FISH.walk
    if not walk then return end
    FISH.walk = nil
    game:GetService("RunService"):UnbindFromRenderStep(walk.binding)
    pcall(function()
        walk.humanoid:Move(Vector3.zero, false)
        walk.humanoid.AutoRotate = walk.autoRotate
        if walk.humanoid.WalkSpeed == walk.speed then walk.humanoid.WalkSpeed = walk.previousSpeed end
    end)
end
function FISH.walkTo(destination, cancelled)
    FISH.stopWalk()
    local root, humanoid = getHRP(), getHum()
    if not (root and humanoid) or cancelled() then return false end
    local origin = root.Position
    local delta = Vector3.new(destination.X - origin.X, 0, destination.Z - origin.Z)
    if delta.Magnitude <= 0.15 then return true end
    if delta.Magnitude > 4 or math.abs(destination.Y - origin.Y) > 0.5
        or humanoid.WalkSpeed <= 0 or root.Anchored or humanoid.FloorMaterial == Enum.Material.Air then return false end
    local walk = {
        binding = "PkaizenFishingStep", humanoid = humanoid, autoRotate = humanoid.AutoRotate,
        previousSpeed = humanoid.WalkSpeed, speed = math.min(6, humanoid.WalkSpeed),
    }
    FISH.walk = walk
    humanoid.AutoRotate = false
    humanoid.WalkSpeed = walk.speed
    local deadline, reached = os.clock() + 1.25, false
    game:GetService("RunService"):BindToRenderStep(walk.binding, Enum.RenderPriority.Character.Value + 1, function()
        if FISH.walk ~= walk then return end
        if cancelled() or getHRP() ~= root or getHum() ~= humanoid or humanoid.Health <= 0
            or humanoid.FloorMaterial == Enum.Material.Air or os.clock() >= deadline then
            FISH.stopWalk(); return
        end
        local remaining = Vector3.new(destination.X - root.Position.X, 0, destination.Z - root.Position.Z)
        if remaining.Magnitude <= 0.15 or remaining:Dot(delta) <= 0 then
            reached = true; FISH.stopWalk(); return
        end
        local ground = FISH.collectPosition(nil, root.Position + remaining.Unit * math.min(0.5, remaining.Magnitude))
        if not ground or math.abs(ground.Y - origin.Y) > 0.5 or (root.Position - origin).Magnitude > 4 then
            FISH.stopWalk(); return
        end
        humanoid:Move(remaining.Unit, false)
    end)
    repeat task.wait() until FISH.walk ~= walk
    return reached and not cancelled()
end
function collectCatch(catch, standPos)
    local prompt = catch:FindFirstChildWhichIsA("ProximityPrompt", true)
    local root = prompt and prompt.Parent
    if not (prompt and prompt.Enabled and root) then return false end
    local position = root:IsA("Attachment") and root.WorldPosition or root:IsA("BasePart") and root.Position
    if not position then return false end
    local item = catch:GetAttribute("CatchItem")
    if type(item) ~= "string" then return false end
    local before = invAmount(item)
    local epoch, character = STATE.activityEpoch, getChar()
    local function cancelled()
        return _stopped or not CFG.autoFish or STATE.activityEpoch ~= epoch or getChar() ~= character or not alive()
    end
    local function waitFor(duration, holding)
        local deadline = os.clock() + duration
        repeat
            if cancelled() then return false end
            if holding then
                local parent, current = prompt.Parent, getHRP()
                local point = parent and (parent:IsA("Attachment") and parent.WorldPosition or parent:IsA("BasePart") and parent.Position)
                if invAmount(item) > before then return true end
                if not (catch.Parent and prompt.Enabled and current) or typeof(point) ~= "Vector3" then return false end
                if (current.Position - point).Magnitude > prompt.MaxActivationDistance then return false end
            end
            task.wait(0.1)
        until os.clock() >= deadline
        return not cancelled()
    end
    if cancelled() then return false end
    local rope = catch:FindFirstChildWhichIsA("RopeConstraint", true)
    if rope and ((rope.Attachment0 and rope.Attachment0:IsDescendantOf(character))
        or (rope.Attachment1 and rope.Attachment1:IsDescendantOf(character))) then
        if os.clock() - (FISH.catchSince or os.clock()) < 1.7 or rope.Length > 1 then
            FISH.status = "Reeling the catch to the rod"
            return false
        end
        local tip = rope.Attachment0 and rope.Attachment0:IsDescendantOf(character) and rope.Attachment0 or rope.Attachment1
        local catchRoot = root:IsA("Attachment") and root.Parent or root
        if not (tip and catchRoot:IsA("BasePart")) then return false end
        local current = getHRP()
        if not current then return false end
        if FISH.steppedCatch ~= catch then
            FISH.steppedCatch = catch
            local step = FISH.pickupStep(current.Position, position, standPos)
            if step then
                FISH.walkTo(step, cancelled)
                if cancelled() then return false end
            end
        end
        if FISH.catchHold then FISH.catchHold:Disconnect(); FISH.catchHold = nil end
        if FISH.catchAlign then FISH.catchAlign:Destroy(); FISH.catchAlign = nil end
        if FISH.catchAttachment then FISH.catchAttachment:Destroy(); FISH.catchAttachment = nil end
        local attachment = Instance.new("Attachment")
        attachment.Parent = catchRoot
        local align = Instance.new("AlignPosition")
        align.Mode = Enum.PositionAlignmentMode.OneAttachment
        align.Attachment0 = attachment
        align.MaxForce = math.huge
        align.MaxVelocity = 150
        align.Responsiveness = 100
        align.ApplyAtCenterOfMass = true
        align.Position = current.Position + Vector3.new(0, 1, 0)
        catch:PivotTo(catch:GetPivot() + align.Position - catchRoot.Position)
        catchRoot.AssemblyLinearVelocity = Vector3.zero
        catchRoot.AssemblyAngularVelocity = Vector3.zero
        align.Parent = catchRoot
        FISH.catchAlign, FISH.catchAttachment = align, attachment
        local deadline = os.clock() + prompt.HoldDuration * 2 + 6
        local connection
        connection = game:GetService("RunService").Heartbeat:Connect(function()
            if cancelled() or not catch.Parent or not tip.Parent or os.clock() >= deadline then
                connection:Disconnect()
                align:Destroy(); attachment:Destroy()
                if FISH.catchHold == connection then FISH.catchHold = nil end
                return
            end
            local ok = pcall(function()
                local currentRoot = getHRP()
                if not currentRoot then return end
                align.Position = currentRoot.Position + Vector3.new(0, 1, 0)
            end)
            if not ok then connection:Disconnect(); align:Destroy(); attachment:Destroy(); if FISH.catchHold == connection then FISH.catchHold = nil end end
        end)
        FISH.catchHold = connection
        local arrivalDeadline = os.clock() + 6
        while (catchRoot.Position - current.Position).Magnitude > 3 and os.clock() < arrivalDeadline do
            if not waitFor(0.1) then connection:Disconnect(); align:Destroy(); attachment:Destroy(); FISH.catchHold = nil; return false end
        end
    end
    local hrp = getHRP()
    if not hrp then return false end
    if FISH.steppedCatch ~= catch then
        FISH.steppedCatch = catch
        local step = FISH.pickupStep(hrp.Position, position, standPos)
        if step then FISH.walkTo(step, cancelled) end
    end
    if not waitFor(0.35) then return false end
    root = prompt.Parent
    position = root and (root:IsA("Attachment") and root.WorldPosition or root:IsA("BasePart") and root.Position)
    hrp = getHRP()
    if not (prompt.Enabled and hrp) or typeof(position) ~= "Vector3" then return false end
    if (hrp.Position - position).Magnitude > prompt.MaxActivationDistance then return false end
    local began = pcall(function() asGame(function() prompt:InputHoldBegin() end) end)
    local held = began and waitFor(prompt.HoldDuration + 0.2, true)
    if held and not cancelled() and catch.Parent and invAmount(item) <= before and typeof(fireproximityprompt) == "function" then
        local current = getHRP()
        local parent = prompt.Parent
        local point = parent and (parent:IsA("Attachment") and parent.WorldPosition or parent:IsA("BasePart") and parent.Position)
        if prompt.Enabled and current and typeof(point) == "Vector3" and (current.Position - point).Magnitude <= prompt.MaxActivationDistance then
            pcall(function() asGame(function() fireproximityprompt(prompt) end) end)
        end
    end
    pcall(function() asGame(function() prompt:InputHoldEnd() end) end)
    if cancelled() or not began then return false end
    local deadline = os.clock() + 2
    while invAmount(item) <= before and os.clock() < deadline do
        if not waitFor(0.1) then break end
    end
    local got = invAmount(item) > before
    if got then FISH.catches = FISH.catches + 1; fishLog("Caught " .. tostring(item)) end
    if not got then FISH.status = "Catch not confirmed: " .. item end
    if FISH.catchHold then FISH.catchHold:Disconnect(); FISH.catchHold = nil end
    if FISH.catchAlign then FISH.catchAlign:Destroy(); FISH.catchAlign = nil end
    if FISH.catchAttachment then FISH.catchAttachment:Destroy(); FISH.catchAttachment = nil end
    if got and standPos and not cancelled() then
        local stand = FISH.collectPosition(nil, standPos)
        local current = getHRP()
        if stand and current and (current.Position - stand).Magnitude > 0.5 then
            FISH.walkTo(stand, cancelled)
        end
    end
    return got
end
