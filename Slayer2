        function sectionClass:addSlider(title, default, min, max, callback)
            local sld = Instance.new("Frame", self.container)
            sld.Name = title; sld.Size = UDim2.new(1, 0, 0, 44)
            sld.BackgroundColor3 = C.bg; sld.BorderSizePixel = 0; corner(sld, 8)
            local tl = Instance.new("TextLabel", sld)
