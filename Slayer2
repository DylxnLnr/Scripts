function doTrainingSession(station)
    local epoch = STATE.activityEpoch
    local root = station:FindFirstChild("Root") or station.PrimaryPart or station:FindFirstChildWhichIsA("BasePart")
    if not root then return false end
    tpCF(root.CFrame * CFrame.new(0, 3, 4))
    if not STATE.waitActivity(epoch, 1.5) then return false, "stopped" end
    local prompt = station:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return false, "no prompt" end
    pcall(fireproximityprompt, prompt)
    local vals = getValues()
    local t0 = os.clock()
    while os.clock() - t0 < 4 and not (vals and vals:FindFirstChild("Training")) do
        if not STATE.waitActivity(epoch, 0.2) then return false, "stopped" end
    end
    if not (vals and vals:FindFirstChild("Training")) then return false, "did not start" end
    if not STATE.waitActivity(epoch, CFG.trainDuration or 8) then return false, "stopped" end
    local typeName = station.Parent and station.Parent.Name or ""
    if typeName == "Boulder Split" then
        for _ = 1, 6 do toServer("training_signaler", "StateChanged"); if not STATE.waitActivity(epoch, 0.4) then return false, "stopped" end end
        toServer("training_signaler", "Stop", true)
    elseif typeName == "Boulder Push" then
        for i = 1, 5 do toServer("training_signaler", "StateChanged", i / 5); if not STATE.waitActivity(epoch, 0.4) then return false, "stopped" end end
        toServer("training_signaler", "Stop")
    else
        toServer("training_signaler", "Stop", true)
    end
    task.wait(1)
    return true
end
function trainTick(log)
    log = log or function() end
    for _, qn in ipairs(activeQuestNames()) do
        local prog = questTaskProgress(qn)
        if prog then
            for tn, p in pairs(prog) do
                local station = TRAIN_MAP[tn] and trainingStation(TRAIN_MAP[tn])
                if station and p.value < p.max then
                    STATE.farmStatus = ("Training %s (%d/%d)"):format(tn, p.value, p.max)
                    local ok, why = doTrainingSession(station)
                    if not ok then log("Training failed: " .. tostring(why)) task.wait(2) end
                    return true
                end
                local q = questInfo(qn)
                local spec = q and q.TaskSpecs and q.TaskSpecs[tn]
                if spec and spec.Type == "Pickup" and p.value < p.max then
                    STATE.farmStatus = "Quest pickup: " .. tn
                    doStoryQuest(qn, log)
                    return true
                end
            end
        end
    end
    return false
end

-- === CHESTS ===
local _chestSeen = setmetatable({}, { __mode = "k" })
local LOOT = { busy = false, status = "Idle", opened = 0, collected = 0 }
local _lootSeen = setmetatable({}, { __mode = "k" })
function LOOT.promptPosition(prompt)
    local parent = prompt and prompt.Parent
    if not parent then return nil end
    if parent:IsA("Attachment") then return parent.WorldPosition end
    if parent:IsA("BasePart") then return parent.Position end
    if parent:IsA("Model") then return parent:GetPivot().Position end
    return nil
end
function LOOT.holdPrompt(prompt, cancelled, confirmed)
    local function valid()
        local position, root = LOOT.promptPosition(prompt), getHRP()
        return not cancelled() and alive() and position and root and prompt.Enabled
            and (position - root.Position).Magnitude <= prompt.MaxActivationDistance
            and LOOT.safe(position)
    end
    if not valid() then return false end
    local began = false
    local ok, result = pcall(function()
        began = true
        asGame(function() prompt:InputHoldBegin() end)
        local deadline = os.clock() + 0.2
        repeat
            if cancelled() then return false end
            if confirmed() then return true end
            if not valid() then return false end
            task.wait(0.01)
        until os.clock() >= deadline
        if confirmed() then return true end
        if not valid() then return false end
        if typeof(fireproximityprompt) == "function" then
            asGame(function() fireproximityprompt(prompt) end)
        end
        return true
    end)
    if began then pcall(function() asGame(function() prompt:InputHoldEnd() end) end) end
    if not ok then LOOT.status = "Interaction error: " .. tostring(result) end
    return ok and result == true
end
function LOOT.idle()
    if CFG.autoFarm or CFG.autoBoss or CFG.autoQuests or CFG.autoTrain
        or CFG.autoPower or CFG.autoFish or CFG.autoSlayer then return false end
    return not CFG.autoFinalSelection or LP:GetAttribute("TrialEnding") == true
        or questState("Defeat the Hand Demon") == "Done"
end
function LOOT.eligible(drop)
    if not drop:IsA("BasePart") or not drop.Parent then return false end
    local owner = drop:GetAttribute("DropOwnerUserId")
    if type(owner) == "number" and owner ~= LP.UserId then return false end
    local reserved = drop:GetAttribute("DropReservedFor")
    if type(reserved) == "string" and not reserved:find("," .. LP.UserId .. ",", 1, true) then return false end
    local claimed = drop:GetAttribute("DropClaimedBy")
    return claimed == nil or claimed == 0
end
function LOOT.amount(name)
    local data = getData()
    local inventory = data and data:FindFirstChild("Inventory")
    inventory = inventory and inventory:FindFirstChild("Inventory")
    local item = inventory and inventory:FindFirstChild(name)
    return item and val(item, "Amount", 0) or 0
end
function LOOT.safe(position)
    local hum = getHum()
    local threshold = STATE.postKill and (CFG.safeHP or 35) or math.max(50, CFG.safeHP or 35)
    if not hum or hum.Health <= 0 or hum.Health / math.max(1, hum.MaxHealth) * 100 < threshold then return false end
    if COMBAT.evading or COMBAT.retreating and not STATE.postKill then return false end
    local target = STATE.target
    local targetHum = target and target.Parent and target:FindFirstChildOfClass("Humanoid")
    if targetHum and targetHum.Health > 0 then return false end
    COMBAT.scan(position)
    if COMBAT.unsafe(position) then return false end
    for _, entry in ipairs(liveMobs()) do
        local root = entry.model:FindFirstChild("HumanoidRootPart")
        if root and (root.Position - position).Magnitude < 30 then return false end
    end
    return true
end
function LOOT.available()
    local folder = workspace:FindFirstChild("LootDrops")
    local root = getHRP()
    local drops = {}
    if not folder or not root then return drops end
    for _, drop in ipairs(folder:GetChildren()) do
        if LOOT.eligible(drop) then
            local prompt = drop:FindFirstChildWhichIsA("ProximityPrompt", true)
            local distance = (drop.Position - root.Position).Magnitude
            if prompt and prompt.Enabled and distance <= (CFG.lootRadius or 80) then
                drops[#drops + 1] = { drop = drop, prompt = prompt, distance = distance }
            end
        end
    end
    table.sort(drops, function(first, second) return first.distance < second.distance end)
    return drops
end
function collectLoot(automatic, postKill)
    local root = getHRP()
    if LOOT.busy or not root or not LOOT.safe(root.Position) then return 0, false end
    local epoch, character = STATE.activityEpoch, getChar()
    local back = root.CFrame
    local function cancelled()
        return _stopped or STATE.activityEpoch ~= epoch or getChar() ~= character
            or not alive() or (postKill and (STATE.postKill ~= postKill or os.clock() >= postKill.deadline))
            or (automatic and not (CFG.autoLoot or postKill and CFG.autoChests))
    end
    local function waitFor(duration, position)
        local deadline = os.clock() + duration
        repeat
            if cancelled() or not LOOT.safe(position) then return false end
            task.wait(0.1)
        until os.clock() >= deadline
        return not cancelled() and LOOT.safe(position)
    end
    local count, moved = 0, false
    LOOT.busy = true
    local claimConnection
    local ok, err = pcall(function()
        LOOT.status = "No eligible nearby drops"
        for index, entry in ipairs(LOOT.available()) do
            if index > 5 or cancelled() then break end
            local drop, prompt = entry.drop, entry.prompt
            if postKill and (drop.Position - postKill.position).Magnitude > postKill.radius then continue end
            if os.clock() < (_lootSeen[drop] or 0) or not LOOT.eligible(drop) or not prompt.Enabled then continue end
            if not LOOT.safe(drop.Position) then LOOT.status = "Loot waiting: enemies or danger nearby"; continue end
            _lootSeen[drop] = os.clock() + 10
            local item = tostring(drop:GetAttribute("DropItemId") or "Loot")
            local before = LOOT.amount(item)
            local claimed = false
            claimConnection = drop:GetAttributeChangedSignal("DropClaimedBy"):Connect(function()
                claimed = drop:GetAttribute("DropClaimedBy") == LP.UserId
            end)
            LOOT.status = "Collecting " .. item
            local position = LOOT.promptPosition(prompt)
            if not position then claimConnection:Disconnect(); claimConnection = nil; continue end
            tpPos(position, math.min(2, prompt.MaxActivationDistance / 2)); moved = true
            if not waitFor(0.05, drop.Position) then break end
            if not LOOT.eligible(drop) or not prompt.Parent or not prompt.Enabled then
                claimConnection:Disconnect(); claimConnection = nil
                continue
            end
            local held = LOOT.holdPrompt(prompt, cancelled, function()
                return claimed or LOOT.amount(item) > before
            end)
            if not held then break end
            local deadline = os.clock() + 0.4
            while not claimed and LOOT.amount(item) <= before and os.clock() < deadline do
                if not waitFor(0.1, drop.Position) then break end
            end
            claimConnection:Disconnect(); claimConnection = nil
            if claimed or drop:GetAttribute("DropClaimedBy") == LP.UserId
                or (not drop.Parent and LOOT.amount(item) > before) then
                count = count + 1; LOOT.collected = LOOT.collected + 1
                LOOT.status = "Collected: " .. item
            else
                LOOT.status = "Collection not confirmed: " .. item
            end
        end
    end)
    if claimConnection then claimConnection:Disconnect() end
    if cancelled() then LOOT.status = "Loot collection cancelled"
    elseif not ok then LOOT.status = "Loot error: " .. tostring(err) end
    if moved and not cancelled() then
        local safe, allowed = pcall(LOOT.safe, back.Position)
        if safe and allowed then pcall(tpCF, back) end
    end
    LOOT.busy = false
    return count, moved
end
-- Event / world chests spawn outside workspace.Chests; find them by prompt text, cached 8s (full workspace scan is heavy).
LOOT.extraChests = {}
function LOOT.chestModels(fresh)
    local list = {}
    local folder = workspace:FindFirstChild("Chests")
    for _, chest in ipairs(folder and folder:GetChildren() or {}) do list[#list + 1] = chest end
    if fresh or os.clock() - (LOOT.extraChestsAt or 0) > 3 then
        LOOT.extraChestsAt = os.clock()
        local extra, seen = {}, {}
        for _, prompt in ipairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and not (folder and prompt:IsDescendantOf(folder)) then
                local text = (prompt.ObjectText .. " " .. prompt.ActionText):lower()
                if text:find("chest") or text:find("cache") or text:find("treasure") or text:find("coffre") or text:find("caisse") then
                    local model = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent
                    if model and model ~= workspace and not seen[model] then seen[model] = true; extra[#extra + 1] = model end
                end
            end
        end
        LOOT.extraChests = extra
    end
    for _, chest in ipairs(LOOT.extraChests) do if chest.Parent then list[#list + 1] = chest end end
    return list
end
function LOOT.queueNearbyChest(force)
    if STATE.postKill or not CFG.autoChests or not alive() then return false end
    if not force and not LOOT.idle() then return false end
    local root = getHRP()
    if not root then return false end
    local radius = math.clamp(CFG.lootRadius or 80, 30, 400)
    local enemies = liveMobs()
    for _, chest in ipairs(LOOT.chestModels()) do
        local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
        local position = LOOT.promptPosition(prompt)
        if prompt and prompt.Enabled and position and chest:GetAttribute("IsOpen") ~= true and (position - root.Position).Magnitude <= radius then
            local blocked = false
            for _, entry in ipairs(enemies) do
                local enemyRoot = entry.model:FindFirstChild("HumanoidRootPart")
                if enemyRoot and entry.hum.Health > 0 and ((enemyRoot.Position - position).Magnitude < 30
                    or (enemyRoot.Position - root.Position).Magnitude < 30) then blocked = true; break end
            end
            if force or blocked then
                local now = os.clock()
                STATE.postKill = { chest = chest, position = position, epoch = STATE.activityEpoch,
                    started = now, deadline = now + 25, stage = "chests", radius = radius, readyAt = now }
                LOOT.chestStatus = blocked and ("Clearing enemies before opening " .. chest.Name) or ("Heading to chest " .. chest.Name)
                return true
            end
        end
    end
    return false
end
function openChests(automatic, postKill)
    if LOOT.busy then return 0 end
    if automatic and not postKill and LOOT.queueNearbyChest() then return 0 end
    local root = getHRP()
    if not root or not LOOT.safe(root.Position) then LOOT.chestStatus = "Chests waiting for safety"; return 0 end
    local chestList = LOOT.chestModels()
    if #chestList == 0 then LOOT.status = "No chests loaded"; return 0 end
    local epoch, character = STATE.activityEpoch, getChar()
    local function cancelled()
        return _stopped or STATE.activityEpoch ~= epoch or getChar() ~= character
            or not alive() or (postKill and (STATE.postKill ~= postKill or os.clock() >= postKill.deadline))
            or (automatic and (not CFG.autoChests or not postKill and not LOOT.idle()))
    end
    local function waitFor(duration)
        local deadline = os.clock() + duration
        repeat
            if cancelled() then return false end
            local current = getHRP()
            if not current or not LOOT.safe(current.Position) then return false end
            task.wait(0.1)
        until os.clock() >= deadline
        return not cancelled()
    end
    LOOT.busy = true
    local n, disabled, missing = 0, 0, 0
    local back = getHRP() and getHRP().CFrame
    local moved = false
    local ok, err = pcall(function()
    LOOT.status = "No unopened chests loaded"
    for _, chest in ipairs(chestList) do
        if cancelled() then break end
        if chest:GetAttribute("IsOpen") ~= true and os.clock() >= (_chestSeen[chest] or 0) then
            local ok, pos = pcall(function() return chest:GetPivot().Position end)
            if ok then
                if postKill and (pos - postKill.position).Magnitude > postKill.radius then continue end
                if not LOOT.safe(pos) then LOOT.status = "Chests waiting: enemies nearby"; continue end
                local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled then
                    local position = LOOT.promptPosition(prompt)
                    if not position then missing = missing + 1; continue end
                    _chestSeen[chest] = os.clock() + 5
                    LOOT.status = "Opening " .. chest.Name
                    tpPos(position, math.min(2, prompt.MaxActivationDistance / 2)); moved = true
                    if not waitFor(0.2) then break end
                    if not prompt.Parent or not prompt.Enabled then continue end
                    local held = LOOT.holdPrompt(prompt, cancelled, function() return chest:GetAttribute("IsOpen") == true end)
                    if not held then break end
                    local deadline = os.clock() + 1
                    while chest.Parent and chest:GetAttribute("IsOpen") ~= true and os.clock() < deadline do
                        if not waitFor(0.05) then break end
                    end
                    if chest:GetAttribute("IsOpen") == true then
                        n = n + 1; LOOT.opened = LOOT.opened + 1
                        LOOT.status = "Chest opening confirmed: " .. chest.Name
                    else
                        LOOT.status = "Opening not confirmed: " .. chest.Name
                    end
                    if CFG.autoChests then
                        local pr = postKill and postKill.radius or math.clamp(CFG.lootRadius or 80, 30, 150)
                        pcall(LOOT.grabChestDrops, chest:GetPivot().Position, pr, cancelled)
                    end
                elseif prompt then
                    disabled = disabled + 1
                else
                    missing = missing + 1
                end
            end
        end
    end
    end)
    if cancelled() then LOOT.status = "Chest sweep cancelled"
    elseif not ok then LOOT.status = "Chest error: " .. tostring(err) end
    if ok and not cancelled() and n == 0 and (disabled > 0 or missing > 0) then
        LOOT.status = ("Chests: %d interactions disabled, %d without a prompt"):format(disabled, missing)
    end
    LOOT.chestStatus = LOOT.status
    if moved and back and not cancelled() and LOOT.safe(back.Position) then pcall(tpCF, back) end
    LOOT.busy = false
    return n
end
-- Grab a safe, unopened, nearby chest mid-farm (independent of LOOT.idle / idle-only slow sweep).
function LOOT.grabNearChest()
    if STATE.postKill or not CFG.autoChests or not alive() then return false, false end
    if CFG.autoBoss and STATE.bossRotation and STATE.bossRotation.target then return false, false end
    local root = getHRP()
    if not root or not LOOT.safe(root.Position) then return false, false end
    local radius = math.clamp(CFG.lootRadius or 80, 30, 400)
    local enemies = liveMobs()
    local target
    for _, chest in ipairs(LOOT.chestModels()) do
        if chest:GetAttribute("IsOpen") ~= true then
            local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
            local position = LOOT.promptPosition(prompt)
            if prompt and prompt.Enabled and position and (position - root.Position).Magnitude <= radius then
                local clear = true
                for _, entry in ipairs(enemies) do
                    local enemyRoot = entry.model:FindFirstChild("HumanoidRootPart")
                    if enemyRoot and entry.hum.Health > 0 and (enemyRoot.Position - position).Magnitude < 30 then clear = false; break end
                end
                if clear then target = { chest = chest, prompt = prompt, position = position } break end
            end
        end
    end
    if not target then return false, false end
    local epoch, character = STATE.activityEpoch, getChar()
    local function cancelled()
        return _stopped or STATE.activityEpoch ~= epoch or getChar() ~= character or not alive()
            or not CFG.autoChests or STATE.postKill
    end
    local back = root.CFrame
    LOOT.busy = true
    local opened = false
    local ok, err = pcall(function()
        LOOT.status = "Opening " .. target.chest.Name
        _chestSeen[target.chest] = os.clock() + 4
        tpPos(target.position, math.min(2, target.prompt.MaxActivationDistance / 2))
        local deadline = os.clock() + 0.2
        while os.clock() < deadline do
            if cancelled() then return end
            task.wait(0.01)
        end
        if cancelled() or not target.prompt.Parent or not target.prompt.Enabled then return end
        LOOT.holdPrompt(target.prompt, cancelled, function() return target.chest:GetAttribute("IsOpen") == true end)
        opened = target.chest:GetAttribute("IsOpen") == true
        if opened then
            LOOT.opened = LOOT.opened + 1
            LOOT.status = "Chest opened: " .. target.chest.Name
        else
            LOOT.status = "Chest not opened yet: " .. target.chest.Name
        end
        LOOT.chestStatus = LOOT.status
    end)
    if not ok then LOOT.status = "Chest grab error: " .. tostring(err); LOOT.chestStatus = LOOT.status end
    if back and not cancelled() and LOOT.safe(back.Position) then pcall(tpCF, back) end
    LOOT.busy = false
    return true, opened
end
-- Relaxed prompt hold for priority chests: no LOOT.safe requirement, just alive + in range.
function LOOT.holdChestPrompt(prompt, cancelled, confirmed)
    local function valid()
        local position, root = LOOT.promptPosition(prompt), getHRP()
        return not cancelled() and alive() and position and root and prompt.Enabled
            and (position - root.Position).Magnitude <= prompt.MaxActivationDistance
    end
    if not valid() then return false end
    local began = false
    local ok, result = pcall(function()
        began = true
        asGame(function() prompt:InputHoldBegin() end)
        local deadline = os.clock() + 0.2
        repeat
            if cancelled() then return false end
            if confirmed() then return true end
            if not valid() then return false end
            task.wait(0.01)
        until os.clock() >= deadline
        if confirmed() then return true end
        if not valid() then return false end
        if typeof(fireproximityprompt) == "function" then
            asGame(function() fireproximityprompt(prompt) end)
        end
        return true
    end)
    if began then pcall(function() asGame(function() prompt:InputHoldEnd() end) end) end
    if not ok then LOOT.status = "Interaction error: " .. tostring(result) end
    return ok and result == true
end
-- Pick the drops that a chest just spawned, relaxed (no enemy-clear requirement).
-- Drops spawn a few ms after the chest opens, so rescan around the chest center in a loop
-- until everything in the zone is gone (keep staring at the chest, don't walk off early).
function LOOT.grabChestDrops(center, radius, cancelled)
    local root = getHRP()
    if not root or not alive() then return 0 end
    local epoch, character = STATE.activityEpoch, getChar()
    local function stop()
        return _stopped or STATE.activityEpoch ~= epoch or getChar() ~= character or not alive() or cancelled()
    end
    local effective = math.max(radius, CFG.lootRadius or 80)
    local function floorDrops()
        local folder = workspace:FindFirstChild("LootDrops")
        local list = {}
        if not folder then
            -- chest loot may spawn outside LootDrops; scan broadly near the chest center as a fallback
            for _, prompt in ipairs(workspace:GetDescendants()) do
                local drop = prompt:IsA("ProximityPrompt") and prompt.Parent or nil
                if drop and drop:IsA("BasePart") and LOOT.eligible(drop)
                    and (drop.Position - center).Magnitude <= effective then
                    list[#list + 1] = { drop = drop, prompt = prompt, distance = (drop.Position - center).Magnitude }
                end
            end
            table.sort(list, function(first, second) return first.distance < second.distance end)
            return list
        end
        for _, drop in ipairs(folder:GetChildren()) do
            if LOOT.eligible(drop) and (drop.Position - center).Magnitude <= effective then
                local prompt = drop:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    list[#list + 1] = { drop = drop, prompt = prompt, distance = (drop.Position - center).Magnitude }
                end
            end
        end
        table.sort(list, function(first, second) return first.distance < second.distance end)
        return list
    end
    local count, sawSomething = 0, false
    local deadline = os.clock() + 6
    while os.clock() < deadline and not stop() and count < 8 do
        local drops = floorDrops()
        if #drops == 0 then
            -- chest fully looted: leave as soon as nothing remains
            if sawSomething then break end
            task.wait(0.05)
        else
            sawSomething = true
            for _, entry in ipairs(drops) do
                if stop() or count >= 8 then break end
                local drop, prompt = entry.drop, entry.prompt
                -- drop prompts often enable shortly after the chest opens: wait for ours, don't bail
                if not prompt.Enabled then
                    local waitUntil = os.clock() + 3
                    while os.clock() < waitUntil and not stop() do
                        if prompt.Enabled then break end
                        if not prompt.Parent then break end
                        task.wait(0.05)
                    end
                end
                if stop() or not drop.Parent or not LOOT.eligible(drop) or not prompt.Enabled then
                    if drop.Parent and LOOT.eligible(drop) then task.wait(0.05) end
                    continue
                end
                local item = tostring(drop:GetAttribute("DropItemId") or "Loot")
                local before = LOOT.amount(item)
                local claimed = false
                local conn = drop:GetAttributeChangedSignal("DropClaimedBy"):Connect(function()
                    claimed = drop:GetAttribute("DropClaimedBy") == LP.UserId
                end)
                local position = LOOT.promptPosition(prompt)
                LOOT.status = "Collecting " .. item .. " (chest)"
                local waited = 0
                while waited < 8 and not stop() do
                    local hrp = getHRP()
                    if position and (not hrp or (hrp.Position - position).Magnitude > prompt.MaxActivationDistance) then
                        tpPos(position, math.min(2, prompt.MaxActivationDistance / 2))
                    end
                    if hrp and position and (hrp.Position - position).Magnitude <= prompt.MaxActivationDistance then break end
                    task.wait(0.01); waited = waited + 1
                end
                if not stop() and prompt.Parent and prompt.Enabled then
                    LOOT.holdChestPrompt(prompt, stop, function() return claimed or LOOT.amount(item) > before end)
                    if claimed or LOOT.amount(item) > before then
                        count = count + 1
                        LOOT.collected = LOOT.collected + 1
                        LOOT.status = "Collected: " .. item .. " (chest)"
                    end
                end
                conn:Disconnect()
            end
        end
    end
    return count
end
-- Priority chest rush: see a chest -> open it -> pick the drops, no waiting for safety.
function LOOT.rushChest()
    if LOOT.busy or STATE.postKill or not CFG.autoChests or not alive() then return false, false end
    local root = getHRP()
    if not root then return false, false end
    local dropRadius = math.clamp(CFG.lootRadius or 80, 30, 150)
    local target
    -- scan all loaded chests anywhere on the map, not just nearby: don't miss any.
    for _, chest in ipairs(LOOT.chestModels(os.clock() - (LOOT.extraChestsAt or 0) > 2)) do
        if chest:GetAttribute("IsOpen") ~= true and os.clock() >= (_chestSeen[chest] or 0) then
            local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
            local position = LOOT.promptPosition(prompt)
            if not position then
                local ok, pivot = pcall(function() return chest:GetPivot().Position end)
                if ok then position = pivot end
            end
            -- chest just spawned has no enabled prompt yet; still claim it and wait for it.
            local spawning = chest:GetAttribute("ChestState") == "Spawned"
            if position and (spawning or prompt and prompt.Enabled) then
                local distance = (position - root.Position).Magnitude
                if not target or distance < target.distance then
                    target = { chest = chest, prompt = prompt, position = position, distance = distance }
                end
            end
        end
    end
    if not target then return false, false end
    local epoch, character = STATE.activityEpoch, getChar()
    local function cancelled()
        return _stopped or STATE.activityEpoch ~= epoch or getChar() ~= character or not alive()
            or not CFG.autoChests or STATE.postKill
    end
    local back = root.CFrame
    LOOT.busy = true
    local opened = false
    local ok, err = pcall(function()
        LOOT.status = "Chest rush: " .. target.chest.Name
        LOOT.chestStatus = LOOT.status
        _chestSeen[target.chest] = os.clock() + 2
        stopLock()
        -- if the chest is still spawning, its prompt is not enabled yet: stay close and wait for it.
        if not target.prompt or not target.prompt.Enabled then
            local waitUntil = os.clock() + 2
            while os.clock() < waitUntil do
                if cancelled() then return end
                local hrp = getHRP()
                local prompt = target.chest and target.chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                target.prompt = prompt or target.prompt
                if target.prompt and target.prompt.Enabled then break end
                if hrp then
                    local want = target.position
                    if (hrp.Position - want).Magnitude > 8 then tpPos(want, 4) end
                end
                task.wait(0.05)
            end
            if not target.prompt or not target.prompt.Enabled or not target.chest.Parent then return end
        end
        local deadline = os.clock() + 0.2
        repeat
            if cancelled() then return end
            local hrp = getHRP()
            if hrp and (hrp.Position - target.position).Magnitude <= target.prompt.MaxActivationDistance then break end
            tpPos(target.position, math.min(2, target.prompt.MaxActivationDistance / 2))
            task.wait(0.01)
        until os.clock() >= deadline
        if cancelled() or not target.prompt.Parent or not target.prompt.Enabled then return end
        LOOT.holdChestPrompt(target.prompt, cancelled, function() return target.chest:GetAttribute("IsOpen") == true end)
        opened = target.chest:GetAttribute("IsOpen") == true
        if opened then
            LOOT.opened = LOOT.opened + 1
            LOOT.status = "Chest opened: " .. target.chest.Name
        else
            LOOT.status = "Chest not opened yet: " .. target.chest.Name
        end
        LOOT.chestStatus = LOOT.status
        -- collect whatever the chest spawned, even if IsOpen confirms a moment later
        LOOT.grabChestDrops(target.position, dropRadius, cancelled)
    end)
    if not ok then LOOT.status = "Chest rush error: " .. tostring(err); LOOT.chestStatus = LOOT.status end
    if back and not cancelled() then pcall(tpCF, back) end
    LOOT.busy = false
    return true, opened
end
function LOOT.pendingChests(job)
    for _, chest in ipairs(LOOT.chestModels()) do
        if chest:GetAttribute("IsOpen") ~= true then
            local ok, position = pcall(function() return chest:GetPivot().Position end)
            local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
            local spawning = chest:GetAttribute("ChestState") == "Spawned"
            if ok and (position - job.position).Magnitude <= job.radius and (spawning or prompt and prompt.Enabled) then return true end
        end
    end
    return false
end
function LOOT.afterKill()
    local job = STATE.postKill
    if not job then return false end
    if _stopped or not alive() or job.epoch ~= STATE.activityEpoch or not (CFG.autoChests or CFG.autoLoot)
        or job.chest and (not CFG.autoChests or not job.chest.Parent) then
        if job.clearTarget and STATE.target == job.clearTarget then stopLock() end
        STATE.postKill = nil
        return false
    end
    local playerRoot = getHRP()
    local positions = { job.position }
    if CFG.autoChests then
        for _, chest in ipairs(LOOT.chestModels()) do
            local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
            local position = LOOT.promptPosition(prompt)
            if prompt and prompt.Enabled and position and chest:GetAttribute("IsOpen") ~= true and (position - job.position).Magnitude <= job.radius then
                positions[#positions + 1] = position
            end
        end
    end
    local blocker, bestDistance
    for _, entry in ipairs(liveMobs()) do
        local enemyRoot = entry.model:FindFirstChild("HumanoidRootPart")
        if enemyRoot and entry.hum.Health > 0 then
            local distance = playerRoot and (enemyRoot.Position - playerRoot.Position).Magnitude or math.huge
            local blocking = distance < 30
            for _, position in ipairs(positions) do
                if (enemyRoot.Position - position).Magnitude < 30 then blocking = true; break end
            end
            if blocking then
                if entry.model == job.clearTarget then blocker = entry; break end
                if not bestDistance or distance < bestDistance then blocker, bestDistance = entry, distance end
            end
        end
    end
    if blocker then
        if LOOT.busy or _skillLast.busy or COMBAT.potionBusy then return true end
        job.clearTarget = blocker.model
        job.deadline = os.clock() + 25
        LOOT.status = "Clearing loot area: " .. blocker.name
        LOOT.chestStatus = LOOT.status
        farmTick(nil, blocker)
        return true
    end
    job.clearTarget = nil
    if os.clock() >= job.deadline then
        if CFG.autoChests and LOOT.pendingChests(job) and (job.extensions or 0) < 3 then
            job.extensions = (job.extensions or 0) + 1
            job.deadline = os.clock() + 25
            job.readyAt = os.clock() + 1
            LOOT.status = ("Chest still pending; retry %d/3"):format(job.extensions)
            LOOT.chestStatus = LOOT.status
            return true
        end
        LOOT.status = "Post-kill collection deferred; combat continues"
        STATE.postKill = nil
        return false
    end
    stopLock()
    STATE.farmStatus = "Post-kill: " .. (job.stage == "chests" and "opening nearby chests" or "collecting nearby drops")
    if LOOT.busy or os.clock() < job.readyAt then return true end
    local root = getHRP()
    if not root or not LOOT.safe(root.Position) then
        STATE.farmStatus = "Post-kill collection waiting for safety"
        return true
    end
    if CFG.autoChests and job.stage ~= "chests" and LOOT.pendingChests(job) then
        job.stage = "chests"
        job.quietSince = nil
        job.readyAt = os.clock()
    end
    if job.stage == "chests" then
        local opened = CFG.autoChests and openChests(true, job) or 0
        if STATE.postKill ~= job or job.epoch ~= STATE.activityEpoch then return true end
        if CFG.autoChests and (LOOT.pendingChests(job) or os.clock() - job.started < 8) then
            job.readyAt = os.clock() + 0.5
            STATE.farmStatus = "Post-kill: waiting for chest spawn / opening confirmation"
            return true
        end
        job.stage = "drops"
        job.readyAt = os.clock() + 0.1
        return true
    end
    local collected = collectLoot(true, job)
    if STATE.postKill ~= job or job.epoch ~= STATE.activityEpoch then return true end
    local remaining = false
    for _, entry in ipairs(LOOT.available()) do
        if (entry.drop.Position - job.position).Magnitude <= job.radius then remaining = true; break end
    end
    if collected > 0 or remaining then job.quietSince = nil
    else job.quietSince = job.quietSince or os.clock() end
    if job.quietSince and os.clock() - job.quietSince >= 3 and os.clock() - job.started >= 8 then
        STATE.postKill = nil
        LOOT.status = "Post-kill collection finished"
    end
    job.readyAt = os.clock() + 0.3
    return true
end

-- === POTIONS ===
function toolbarSlotOf(itemName)
    local d = getData()
    local inv = d and d:FindFirstChild("Inventory")
    local item = inv and inv:FindFirstChild("Inventory") and inv.Inventory:FindFirstChild(itemName)
    local id = item and item:FindFirstChild("Id") and item.Id.Value
    if not id then return nil end
    local tb = inv:FindFirstChild("Toolbar")
    local names = { "One", "Two", "Three", "Four", "Five" }
    for i, n in ipairs(names) do if tb and tb:FindFirstChild(n) and tb[n].Value == id then return i end end
    return nil, id
end
local _lastPotion = 0
potionTick = function(force)
    local hum = getHum()
    if _stopped or not CFG.autoPotion or COMBAT.potionBusy or _skillLast.busy or not hum or hum.Health <= 0 then return false end
    if hum.Health / math.max(1, hum.MaxHealth) * 100 > (CFG.potionHP or 40) then return false end
    if os.clock() - _lastPotion < 4 then return false end
    local name = CFG.potionName or "Health Potion"
    local data = getData()
    local inventory = data and data:FindFirstChild("Inventory")
    local items = inventory and inventory:FindFirstChild("Inventory")
    local toolbar = inventory and inventory:FindFirstChild("Toolbar")
    local function amount()
        local item = items and items:FindFirstChild(name)
        local count = item and item:FindFirstChild("Amount")
        return item and (count and count.Value or 1) or 0
    end
    if amount() <= 0 then COMBAT.potionStatus = "Missing: " .. name; return false end
    local config = LP:FindFirstChild("Items_Config")
    local equipped = config and config:FindFirstChild("Equipped")
    local server = LP:FindFirstChild("Items_ConfigServer")
    if not equipped or not server or not toolbar then COMBAT.potionStatus = "Waiting for equipment data"; return false end
    local slot, id = toolbarSlotOf(name)
    local temporary = not slot
    local savedSlot = toolbar:FindFirstChild("Five")
    if temporary and (not id or not savedSlot) then return false end
    local previousItem = savedSlot and savedSlot.Value
    local previousEquip = equipped.Value
    local character, epoch = getChar(), STATE.activityEpoch
    local before = amount()
    local down, position
    local function cancelled()
        return _stopped or not CFG.autoPotion or STATE.activityEpoch ~= epoch or getChar() ~= character
            or CFG.potionName ~= name or hum.Health <= 0
    end
    local function waitFor(predicate, duration)
        local deadline = os.clock() + duration
        repeat
            if cancelled() then return false end
            if predicate() then return true end
            task.wait(0.05)
        until os.clock() >= deadline
        return not cancelled() and predicate()
    end
    COMBAT.potionBusy = true
    COMBAT.potionStatus = "Preparing " .. name
    _lastPotion = os.clock()
    local ok, consumed = pcall(function()
        COMBAT.releaseBlock()
        if not waitFor(function() return asGame(function() return Checker.check(LP) == true end) end, 1) then return false end
        if temporary then
            slot = 5
            toServer("Toolbar_Equip", "Five", id)
            if not waitFor(function() return savedSlot.Value == id end, 2) then return false end
        end
        asGame(function() equipped.Value = slot end)
        if not waitFor(function()
            local selected, last = server:FindFirstChild("Equipped"), server:FindFirstChild("Last")
            return selected and selected.Value == slot and last and last.Value == name
        end, 2) then COMBAT.potionStatus = "Potion equip not confirmed"; return false end
        local root = getHRP()
        if not root or cancelled() then return false end
        position = root.Position
        COMBAT.potionStatus = "Drinking " .. name
        STATE.farmStatus = COMBAT.potionStatus
        down = true
        toServer("Tool_Mouse", "Down", position)
        local confirmed = waitFor(function() return amount() < before end, 2.8)
        if confirmed then
            COMBAT.potionStatus = "Consumed: " .. name
            COMBAT.potionsUsed = (COMBAT.potionsUsed or 0) + 1
            COMBAT.potionFailures = 0
        elseif not cancelled() then
            COMBAT.potionFailures = (COMBAT.potionFailures or 0) + 1
            if COMBAT.potionFailures >= 3 then
                COMBAT.potionStatus = "Potion unconfirmed 3 times; auto healing paused"
                CFG.autoPotion = false
            else
                COMBAT.potionStatus = ("Potion unconfirmed (%d/3); retrying in 8s"):format(COMBAT.potionFailures)
                _lastPotion = os.clock() + 4
            end
        end
        return confirmed
    end)
    if down then pcall(toServer, "Tool_Mouse", "Up", position) end
    if getChar() == character then
        pcall(function() if equipped.Value == slot then asGame(function() equipped.Value = previousEquip end) end end)
        if temporary and savedSlot.Value == id then pcall(toServer, "Toolbar_Equip", "Five", previousItem) end
    end
    COMBAT.potionBusy = false
    if not ok then
        COMBAT.potionFailures = (COMBAT.potionFailures or 0) + 1
