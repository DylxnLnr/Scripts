function STATE.dungeon.shopApproach(name, row)
    local manager, character, root = STATE.dungeon, getChar(), getHRP()
    if not root or not alive() or not LP:GetAttribute("InShops") then return false end
    local seller = row.Seller
    if name == "Refinement Ore" or name == "Mythic Refinement Ore" or name == "500 Wen" then seller = "Changer Zeni"
    elseif row.Type == "Grant" then seller = "Tower Crystal" end
    local prompt
    for _, candidate in ipairs(workspace:GetDescendants()) do
        if candidate:IsA("ProximityPrompt") and candidate.Enabled
            and (candidate.ObjectText == name or (seller and candidate.ObjectText == seller)) then
            prompt = candidate; break
        end
    end
    if not prompt then manager.shopStatus = "Waiting for the shop seller to load"; return false end
    local position = prompt.Parent:IsA("Attachment") and prompt.Parent.WorldPosition
        or prompt.Parent:IsA("BasePart") and prompt.Parent.Position
    if typeof(position) ~= "Vector3" then manager.shopStatus = "Seller position unavailable"; return false end
    local visit = manager.shopSeller
    if visit and visit.prompt == prompt and visit.character == character and visit.epoch == STATE.activityEpoch
        and (root.Position - position).Magnitude <= math.min(8, prompt.MaxActivationDistance) then return true end
    manager.shopStatus = "Opening " .. tostring(seller or name)
    local epoch = STATE.activityEpoch
    if not manager.prompt(prompt, "Open dungeon shop") then return false end
    if not STATE.waitActivity(epoch, 0.5) or not CFG.autoDungeon or not CFG.dungeonShop or getChar() ~= character or not alive() then return false end
    manager.shopSeller = { prompt = prompt, character = character, epoch = epoch }
    return false
end
function STATE.dungeon.shopLimit(price, points, spent, budget, reserve, maximum)
    local values = table.pack(price, points, spent, budget, reserve, maximum)
    for index = 1, values.n do
        local value = values[index]
        if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then return false end
    end
    return price > 0 and price <= maximum and spent + price <= budget and points - price >= reserve
end
function STATE.dungeon.chestTick()
    local manager, name = STATE.dungeon, "Ouwigahara Chest"
    local target = tonumber(CFG.dungeonShopTarget) or 0
    if target < 1 or target > 10000 or target % 1 ~= 0 or (manager.bought[name] or 0) >= target then
        manager.shopStatus = "Chest opening target reached"; return false
    end
    local points = tonumber(LP:GetAttribute("RunPoints")) or 0
    if not manager.shopLimit(30000, points, manager.spent, CFG.dungeonShopBudget, CFG.dungeonShopReserve, CFG.dungeonShopMaxPrice) then
        manager.shopStatus = "Budget, price limit or point reserve protected"; return false
    end
    local folder = workspace:FindFirstChild("Chests")
    local chest = folder and folder:FindFirstChild(name)
    local prompt = chest and chest:FindFirstChildWhichIsA("ProximityPrompt", true)
    local position = prompt and LOOT.promptPosition(prompt)
    if not position or not prompt.Enabled or chest:GetAttribute("IsOpen") == true or LOOT.busy then
        manager.shopStatus = "Waiting for the paid chest"; return true
    end
    local epoch, character = STATE.activityEpoch, getChar()
    local function cancelled()
        return _stopped or not CFG.autoDungeon or not CFG.dungeonShop or CFG.dungeonShopItem ~= name
            or STATE.activityEpoch ~= epoch or getChar() ~= character or not alive() or not LP:GetAttribute("InShops")
    end
    stopLock()
    if not LOOT.safe(position) then manager.shopStatus = "Waiting for chest safety"; return true end
    tpPos(position, math.min(2, prompt.MaxActivationDistance / 2))
    if not STATE.waitActivity(epoch, 0.5) or cancelled() or not prompt.Parent or not prompt.Enabled
        or chest:GetAttribute("IsOpen") == true or not LOOT.safe(position) then return true end
    points = tonumber(LP:GetAttribute("RunPoints")) or 0
    if not manager.shopLimit(30000, points, manager.spent, CFG.dungeonShopBudget, CFG.dungeonShopReserve, CFG.dungeonShopMaxPrice) then return true end
    manager.shopBusy = true
    manager.spent = manager.spent + 30000
    manager.shopStatus = "Opening the 30000-point chest"
    local opened, collected = false, 0
    local ok, reason = pcall(function()
        local held = LOOT.holdPrompt(prompt, cancelled, function()
            return chest:GetAttribute("IsOpen") == true
                or (tonumber(LP:GetAttribute("RunPoints")) or points) <= points - 30000
        end)
        local deadline = os.clock() + 4
        repeat
            opened = chest:GetAttribute("IsOpen") == true
                and (tonumber(LP:GetAttribute("RunPoints")) or points) <= points - 30000
            if opened or not held or cancelled() then break end
            task.wait(0.1)
        until os.clock() >= deadline
        if not opened then return false end
        manager.bought[name] = (manager.bought[name] or 0) + 1
        LOOT.opened = LOOT.opened + 1
        local started, quiet = os.clock(), os.clock()
        while os.clock() - started < 30 and not cancelled() do
            manager.shopStatus = "Chest paid; collecting rewards"
            local count = collectLoot(false)
            collected = collected + count
            local pending = #LOOT.available() > 0
            if count > 0 or pending then quiet = os.clock() end
            if collected > 0 and not pending and os.clock() - started >= 8 and os.clock() - quiet >= 3 then return true end
            task.wait(0.2)
        end
        return false
    end)
    manager.shopBusy = false
    if not ok or reason ~= true then
        manager.shopBlocked = true; CFG.dungeonShop = false
        manager.shopError = not ok and tostring(reason) or nil
        manager.shopStatus = opened and "Chest paid; loot incomplete, staying in shops"
            or "Chest payment/opening unconfirmed; no retry, budget reserved"
        syncUI(); return true
    end
    manager.shopStatus = "Chest opened and loot collection confirmed"
    STATE.webhook.record(manager.shopStatus, "Market")
    return true
end
function STATE.dungeon.shopTick()
    local manager = STATE.dungeon
    if manager.shopBusy then return true end
    if manager.shopBlocked or not CFG.dungeonShop then return false end
    if LP:GetAttribute("SaveDisabled") or LP:GetAttribute("SaveDisabledSlot") or workspace:GetAttribute("MinigameRunFreshStart") then
        manager.shopStatus = "Shop unavailable in this mode"; return false
    end
    if CFG.dungeonShopItem == "Ouwigahara Chest" then
        if not alive() then return true end
        return manager.chestTick()
    end
    if not alive() or not SF or not Shop then return true end
    local name, epoch = CFG.dungeonShopItem, STATE.activityEpoch
    local row = Shop.itemsforsale[name]
    if not row or row.NoSave or (row.Type ~= "Item" and row.Type ~= "Grant") then
        manager.shopStatus = "Selected item is not in stock"; return false
    end
    local target = tonumber(CFG.dungeonShopTarget) or 0
    local owned = row.Type == "Item" and CRAFT.market.amount(name) or (manager.bought[name] or 0)
    if target < 1 or target > 10000 or target % 1 ~= 0 or owned >= target then manager.shopStatus = "Purchase target reached"; return false end
    local totals, quantity = asGame(function() return Shop.GetCartTotals({ [name] = 1 }, LP) end)
    if not totals or quantity ~= 1 then manager.shopStatus = "Price unavailable"; return false end
    for currency in pairs(totals) do
        if currency ~= "RunPoints" then manager.shopStatus = "Non-point currency blocked"; return false end
    end
    local points = tonumber(LP:GetAttribute("RunPoints")) or 0
    local price = totals.RunPoints
    if not manager.shopLimit(price, points, manager.spent, CFG.dungeonShopBudget, CFG.dungeonShopReserve, CFG.dungeonShopMaxPrice) then
        manager.shopStatus = "Budget, price limit or point reserve protected"; return false
    end
    local data = getData()
    local allowed, why = asGame(function() return Shop.CanBuy(LP, name, data, 1) end)
    if not allowed then manager.shopStatus = "Shop: " .. tostring(why or "requirements not met"); return false end
    local before = manager.shopValue(name, row)
    if before == nil then manager.shopStatus = "Receipt cannot be verified for this item"; return false end
    if not manager.shopApproach(name, row) then return true end
    if _stopped or not CFG.autoDungeon or not CFG.dungeonShop or CFG.dungeonShopItem ~= name or STATE.activityEpoch ~= epoch then return false end
    manager.shopBusy = true
    manager.spent = manager.spent + price
    manager.shopStatus = "Buying one " .. name
    local sent, response = pcall(function() return asGame(function() return SF.ToServer("PurchaseSelection", { [name] = 1 }) end) end)
    manager.shopError = not sent and tostring(response) or nil
    manager.shopResponse = sent and tostring(response) or nil
    local deadline = os.clock() + 4
    while sent and getData() == data and os.clock() < deadline
        and (manager.shopValue(name, row) == before or (tonumber(LP:GetAttribute("RunPoints")) or points) > points - price) do task.wait(0.1) end
    manager.shopBusy = false
    if not sent or getData() ~= data or manager.shopValue(name, row) == before
        or (tonumber(LP:GetAttribute("RunPoints")) or points) > points - price then
        manager.shopBlocked = true; CFG.dungeonShop = false
        manager.shopStatus = "Purchase unconfirmed; no retry, budget remains reserved"
        syncUI(); return true
    end
    manager.bought[name] = (manager.bought[name] or 0) + 1
    manager.shopStatus = "Received " .. name .. " for " .. tostring(price) .. " points"
    STATE.webhook.record(manager.shopStatus, "Market")
    return true
