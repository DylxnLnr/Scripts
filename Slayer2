function COMBAT.trackProgress(target, health, now, canAttack)
    local progress = COMBAT.progress
    if not progress or progress.target ~= target then
        progress = { target = target, health = health, sampledAt = now, startedAt = now,
            damage = 0, stalled = 0, canAttack = canAttack, recovered = false }
        COMBAT.progress = progress
        return
    end
    local damage = math.max(0, progress.health - health)
    progress.damage = progress.damage + damage
    if damage > 0 then
        progress.stalled = 0
        progress.recovered = false
    elseif canAttack and progress.canAttack then
        progress.stalled = progress.stalled + math.clamp(now - progress.sampledAt, 0, 0.5)
    end
    progress.health = health
    progress.sampledAt = now
    progress.canAttack = canAttack
    if not canAttack or health <= 0 then return end
    if progress.stalled >= 24 then return "pause" end
    if progress.stalled >= 12 and not progress.recovered then
        progress.recovered = true
        return "reequip"
    end
end
