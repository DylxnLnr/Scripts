function STATE.dungeon.score(card, context)
    local kind = card.Type
    local health = math.clamp(tonumber(context.health) or 1, 0, 1)
    local hearts = tonumber(context.hearts) or 3
    local rarity = math.clamp(tonumber(card.Rarity) or 1, 1, 7)
    local survival = context.priority == "Survival" and 1.25 or 1
    if kind == "Heal" then return (health < 0.4 and 260 or health < 0.65 and 165 or (1 - health) * 130) * survival, "missing health" end
    if kind == "ExtraLife" then return hearts < (context.maxHearts or 3) and (hearts <= 1 and 285 or 205) * survival or -100, "remaining hearts" end
    if kind == "Revive" then return (context.fallen or 0) > 0 and 215 or -100, "restore a teammate" end
    if kind == "Stat" then
        local stat, amount = card.Stat, tonumber(card.Amount) or 0
        local caps = { ["Damage Reduction Factor"] = 0.35, ["Cooldown Reduction Factor"] = 0.5,
            ["Additional Damage Factor"] = 2, ["Max Stamina"] = 400 }
        local current = context.stats and context.stats[stat] or 0
        if caps[stat] then amount = math.min(amount, math.max(0, caps[stat] - current)) end
        if amount <= 0 then return -100, "stat already capped" end
        local weights = { ["Damage Reduction Factor"] = 1650 * survival, ["Attack Speed Factor"] = 950,
            ["Additional Damage Factor"] = 800, ["Additional Damage"] = 16,
            ["Cooldown Reduction Factor"] = 650, ["Stamina Regen Speed"] = 160,
            ["Max Stamina"] = 0.65, ["Block Points"] = 14 * survival, ["Movement Speed Factor"] = 100 }
        if stat == "Max Health" then
            return 35 + math.min(150, amount / math.max(1, context.maxHealth or 300) * 650) * survival, "lasting health"
        end
        return 35 + math.min(150, amount * (weights[stat] or 0)), "lasting " .. tostring(stat)
    end
    if kind == "Points" or kind == "Fortune" then
        local amount = math.max(0, tonumber(card.Points) or 0)
        return math.min(135, 12 + math.sqrt(amount) * 2) * (context.priority == "Points" and 1.35 or 1), "immediate points"
    end
    if kind == "Event" then
        local event = card.Event
        local score = STATE.dungeon.events[event]
        if not score then return -100, "unverified or high-risk event" end
        if context.owned and context.owned[event] then return -90, "event already owned" end
        if event == "Adrenaline" or event == "Bulwark" then
            score = score + (health < 0.4 and 240 or health < 0.65 and 130 or (1 - health) * 100)
        elseif event == "SecondChance" or event == "Reincarnation" then
            score = score + (hearts <= 1 and 95 or 0)
        elseif event == "LoneWolf" and (context.allies or 0) > 0 then score = 45
        elseif (event == "Medic" or event == "CommunalHeal") and (context.allies or 0) == 0 then score = 0
        elseif event == "Lifeline" and (context.fallen or 0) == 0 then score = -100 end
        return score, "verified event: " .. tostring(event)
    end
    if kind == "Skill" then return 60 + rarity * 8, "additional skill" end
    if kind == "SkillSwap" then return 35 + rarity * 7, "skill replacement" end
    if kind == "Weapon" then return 25 + rarity * 6, "weapon option" end
    if kind == "Forge" then return 65, "free run refinement" end
    if kind == "AscendClan" then return 90 + rarity * 3, "run clan upgrade" end
    if kind == "Clan" then return rarity > (context.clanRank or 0) and 40 + rarity * 10 or -50, "run clan comparison" end
    if kind == "Potion" then return health < 0.6 and 45 or 20, "consumable reserve" end
    if kind == "Reroll" then return 30, "run reroll ticket" end
    if kind == "Skip" then return 0, "decline a risky event safely" end
    return -100, "unverified replacement or skipped floor"
end

