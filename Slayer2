        if offers ~= pending.folder or offers:GetAttribute("Picked") == pending.id then
            manager.picks = manager.picks + 1
            manager.lastCard = pending.title
            manager.pendingPick = nil
        elseif os.clock() - pending.sent < 4 then
            manager.status = "Waiting for card confirmation"; return
        else
            manager.status = "Card unconfirmed; waiting for the server's automatic choice"; return
        end
    end
    if not offers or offers:GetAttribute("Picked") then return end
    if manager.pendingReroll then
        if manager.pendingReroll.folder == offers then manager.status = "Waiting for reroll confirmation"; return end
        manager.pendingReroll = nil
    end
    local context, best, bestScore, reason = manager.context(), nil, -math.huge, nil
    for _, card in ipairs(offers:GetChildren()) do
        local score, why = manager.score(card:GetAttributes(), context)
        if not best or score > bestScore or score == bestScore and card.Name < best.Name then
            best, bestScore, reason = card, score, why
        end
    end
    if not best then manager.status = "Waiting for reward cards"; return end
    if _stopped or not CFG.autoDungeon or offers.Parent ~= LP then return end
