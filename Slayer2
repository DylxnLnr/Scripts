                    il.Font = Enum.Font.Gotham; il.TextSize = 11; il.TextXAlignment = Enum.TextXAlignment.Left
                    il.TextWrapped = true
                    item.MouseButton1Click:Connect(function()
                        tl.Text = val; open = false
                        tw(dd, {Size = UDim2.new(1, 0, 0, 32)}, 0.15); arrow.Rotation = 0
                        if callback then callback(val) end
                    end)
                end
            end
            buildList(list)
            if searchBox then
                searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                    local filtered = {}
                    local query = searchBox.Text:lower()
                    for _, option in ipairs(list) do
                        if tostring(option):lower():find(query, 1, true) then filtered[#filtered + 1] = option end
                    end
                    listF.CanvasPosition = Vector2.zero
                    buildList(filtered)
                end)
            end
            searchBtn.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    if searchBox then searchBox.Text = "" end
                    buildList(list)
                    tw(dd, {Size = UDim2.new(1, 0, 0, math.clamp(#list, 0, 4) * 38 + listOffset + 6)}, 0.15)
