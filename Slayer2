    if _stopped or not CFG.autoSlayer then manager.stop(); return end
    if not data or not character or not alive() then manager.wait("Waiting for respawn / player data"); return end
    if cancelled() then manager.wait("Waiting for character to stabilize"); return end
    if IN_MINIGAME then manager.pause("Slayer training requires the main world"); return end
    if LOOT.busy or COMBAT.potionBusy or _skillLast.busy then manager.status = "Waiting for the current action"; return end
    local progress = manager.progress()
    if not progress then manager.pause("Slayer progression unavailable or target invalid"); return end
    if progress.level >= progress.target then manager.pause("Slayer stage " .. progress.target .. " reached"); return end
    for _, key in ipairs({ "slayerBudget", "slayerReserve" }) do
        local value = CFG[key]
        if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then manager.pause("Invalid Slayer spending limit"); return end
    end
    if getLevel() < 75 then return farm("Farming level " .. getLevel() .. " / 75 for gourds") end
    local target = STATE.target
    local targetHum = target and target.Parent and target:FindFirstChildOfClass("Humanoid")
    if (CFG.autoFarm or CFG.autoQuests) and targetHum and targetHum.Health > 0 then
        manager.status = "Finishing current combat before gourd training"
        return false
    end
    local chosen
    for _, name in ipairs(manager.names) do
        local amount = invAmount(name)
        local points = CRAFT.progressionModule.ProgressValue("Slayer", name)
        if amount > 0 and points > 0 then
            if not chosen or math.abs(progress.remaining - points) < math.abs(progress.remaining - chosen.points) then chosen = { name = name, points = points } end
        end
    end
    if not chosen then
        if not CFG.slayerAllowBuy then manager.pause("No gourds; purchase permission is off"); return end
        local offer = manager.choose(progress.remaining, manager.offers())
        if not offer then manager.pause("No verified Wen gourd offer"); return end
        if manager.spent + offer.price > CFG.slayerBudget then manager.pause("Slayer session budget reached"); return end
        if getWen() < offer.price + CFG.slayerReserve then return farm("Farming Wen " .. getWen() .. " / " .. (offer.price + CFG.slayerReserve)) end
        STATE.slayerFarming = false; stopLock()
        if not manager.travel(waitFor) then return end
        local allowed, why = asGame(function() return Shop.CanBuy(LP, offer.name, data, 1) end)
        if not allowed then manager.pause("Gourd purchase blocked: " .. tostring(why)); return end
        local fresh = manager.choose(progress.remaining, manager.offers())
        if not fresh or fresh.name ~= offer.name or fresh.price ~= offer.price then return end
        if cancelled() or not CFG.slayerAllowBuy then return end
        if manager.spent + offer.price > CFG.slayerBudget or getWen() < offer.price + CFG.slayerReserve then return end
        manager.status = "Buying one " .. offer.name
        local before = invAmount(offer.name)
        manager.spent = manager.spent + offer.price
        manager.transacting = true
        local ok = pcall(function() asGame(function() SF.ToServer("PurchaseFromShop", offer.name, 1) end) end)
        local received = ok and waitFor(3, function() return invAmount(offer.name) > before end)
        manager.transacting = nil
        if not received then
            CFG.slayerAllowBuy = false
            manager.pause("Gourd purchase unconfirmed; budget reserved")
            return
        end
        manager.bought = (manager.bought or 0) + 1
        STATE.webhook.record("Bought " .. offer.name .. " (" .. offer.price .. " Wen)", "Slayer")
        manager.status = "Gourd received"
        return
    end
    STATE.slayerFarming = false; stopLock()
    if not manager.travel(waitFor) then return end
    local root, hum = getHRP(), getHum()
    if not root or not hum then return end
    COMBAT.scan(root.Position)
    if hum.Health < hum.MaxHealth * (CFG.safeHP or 30) / 100 or COMBAT.unsafe(root.Position) then
        manager.pause("Move somewhere safe before using gourds"); return
    end
    for _, enemy in ipairs(liveMobs()) do
        local enemyRoot = enemy.model:FindFirstChild("HumanoidRootPart")
        if enemyRoot and (enemyRoot.Position - root.Position).Magnitude < 45 then
            manager.pause("Move away from enemies before using gourds"); return
        end
    end
    if hum.FloorMaterial == Enum.Material.Air then
        manager.groundSince = manager.groundSince or os.clock()
        if os.clock() - manager.groundSince > 8 then manager.pause("Land on safe ground before gourd training"); return end
        manager.status = "Waiting to land before training"; return
    end
    manager.groundSince = nil
    local id = invId(chosen.name)
    local _, toolbar = invFolder()
    if not id or not toolbar then manager.pause("Gourd inventory unavailable"); return end
    local slot
    for index, name in ipairs(SLOT_NAMES) do if val(toolbar, name, -1) == id then slot = index; break end end
    if not slot then
        for index, name in ipairs(SLOT_NAMES) do if val(toolbar, name, -1) == 0 then slot = index; break end end
        slot = slot or 5
        manager.toolbar = { slot = slot, id = id, replaced = val(toolbar, SLOT_NAMES[slot], 0), data = data }
        toServer("Toolbar_Equip", SLOT_NAMES[slot], id)
        if not waitFor(2, function() return val(toolbar, SLOT_NAMES[slot], -1) == id end) then
            if not cancelled() then manager.pause("Gourd toolbar placement unconfirmed") end
            return
        end
    else manager.toolbar = { slot = slot, id = id, data = data } end
    local config = LP:FindFirstChild("Items_Config")
    local equipped = config and config:FindFirstChild("Equipped")
    if not equipped then manager.pause("Local tool controls unavailable"); return end
    asGame(function() equipped.Value = 0 end)
    if not waitFor(0.35) then manager.stop(); return end
    asGame(function() equipped.Value = slot end)
    if not waitFor(4, function()
        local server = LP:FindFirstChild("Items_ConfigServer")
        return val(server, "Equipped", 0) == slot and val(server, "Last", "") == chosen.name
    end) then if not cancelled() then manager.pause("Gourd equip unconfirmed") else manager.stop() end; return end
    if cancelled() then manager.stop(); return end
    local before, start = invAmount(chosen.name), manager.progress()
    manager.status = "Blowing into " .. chosen.name
    manager.holding = true
    toServer("Tool_Mouse", "Down", root.Position)
    local held = waitFor(1.8)
    if manager.holding then toServer("Tool_Mouse", "Up", root.Position); manager.holding = false end
    local confirmed = held and waitFor(3, function()
        local now = manager.progress()
        return now and start and invAmount(chosen.name) < before and (now.level > start.level or now.current > start.current)
    end)
    manager.stop()
    if not confirmed and not cancelled() then manager.pause("Gourd progress not confirmed; training paused"); return end
    if confirmed then
        local now = manager.progress()
        local gained = now and start and math.max(0, start.remaining - now.remaining) or 0
        manager.used = (manager.used or 0) + 1
        manager.pointsGained = (manager.pointsGained or 0) + gained
        STATE.webhook.record("Used " .. chosen.name .. " (+" .. gained .. " Slayer points)", "Slayer")
        manager.status = "Slayer points confirmed"
    end
end
