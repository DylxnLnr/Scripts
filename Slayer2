        evade = CFG.autoDungeon or CFG.autoDodge or CFG.autoBlock or CFG.autoPerfectBlock, casting = casting,
        disabled = disabled or UserInput:IsKeyDown(Enum.KeyCode.F),
        inRange = delta.Magnitude <= 6 and math.abs(delta.Y) <= (CFG.levelStrikes ~= false and 3 or 5),
