    for _, name in ipairs({ "Humanoids", "Debree" }) do
        local folder = workspace:FindFirstChild(name)
        if folder then exclude[#exclude + 1] = folder end
    end
    params.FilterDescendantsInstances = exclude
    params.RespectCanCollide = true
    local hrp, hum = getHRP(), getHum()
    if not hrp or not hum then return nil end
    local best, bestDistance
    for _, distance in ipairs({ minimumDistance, minimumDistance + 8, minimumDistance + 16, minimumDistance + 28 }) do
        for index = 1, 16 do
            local angle = index * math.pi / 8
            local candidate = origin + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
            local ground = workspace:Raycast(candidate + Vector3.new(0, 45, 0), Vector3.new(0, -100, 0), params)
            if ground and ground.Normal.Y > 0.65 and ground.Material ~= Enum.Material.Water then
                candidate = ground.Position + Vector3.new(0, hum.HipHeight + hrp.Size.Y / 2 + 0.2, 0)
                local travel = candidate - hrp.Position
                if math.abs(candidate.Y - hrp.Position.Y) <= 35 and not COMBAT.unsafe(candidate)
                    and not workspace:Raycast(candidate, Vector3.new(0, 4, 0), params)
                    and not workspace:Blockcast(CFrame.new(hrp.Position), Vector3.new(2, 2, 2), travel, params) then
