        for _, item in ipairs(owned:GetChildren()) do
            local definition = titles.Get(item.Name)
            if definition then
                local score = 0
                for _, buff in ipairs(definition.buffs or {}) do
                    if buff.stat == CFG.titleStat then score = score + (tonumber(buff.amount) or 0) end
                end
                if score > 0 then candidates[#candidates + 1] = {
                    id = item.Name, name = definition.displayName or item.Name, score = score,
                    equipped = table.find(current, item.Name) ~= nil,
                } end
            end
        end
        return { data = data, equipped = equipped, current = current, candidates = candidates, slots = titles.BoostSlots }
    end)
end
function CRAFT.titles.plan(snapshot)
    local candidates = snapshot.candidates
    table.sort(candidates, function(first, second)
        if first.score ~= second.score then return first.score > second.score end
        if first.equipped ~= second.equipped then return first.equipped end
        return first.id < second.id
    end)
    local chosen, changes = {}, {}
    for index = 1, math.min(snapshot.slots, #candidates) do chosen[candidates[index].id] = true end
    local available = {}
    for slot = 1, snapshot.slots do
        if not chosen[snapshot.current[slot]] then available[#available + 1] = slot end
    end
    table.sort(available, function(first, second)
        local firstEmpty, secondEmpty = snapshot.current[first] == "", snapshot.current[second] == ""
        if firstEmpty ~= secondEmpty then return firstEmpty end
        return first < second
    end)
    for index = 1, math.min(snapshot.slots, #candidates) do
        local candidate = candidates[index]
        if not table.find(snapshot.current, candidate.id) then
            changes[#changes + 1] = { id = candidate.id, slot = table.remove(available, 1) }
        end
    end
    return changes
end
function CRAFT.titles.describe()
    local ok, snapshot = pcall(CRAFT.titles.snapshot)
    if not ok or not snapshot then return "Title data unavailable" end
    CRAFT.titles.plan(snapshot)
    local lines = { "Priority: " .. tostring(CFG.titleStat), CRAFT.titles.status }
    for slot = 1, snapshot.slots do lines[#lines + 1] = "Boost " .. slot .. ": " .. (snapshot.current[slot] ~= "" and snapshot.current[slot] or "Empty") end
    for index = 1, math.min(snapshot.slots, #snapshot.candidates) do
        local candidate = snapshot.candidates[index]
        lines[#lines + 1] = ("Best %d: %s (%g)"):format(index, candidate.name, candidate.score)
    end
    if #snapshot.candidates == 0 then lines[#lines + 1] = "No unlocked title improves this stat" end
    return table.concat(lines, "\n")
end
function CRAFT.titles.equip(automatic)
    local manager = CRAFT.titles
    if manager.busy or _stopped then return end
    manager.busy = true
    local ok, err = pcall(function()
        local snapshot = manager.snapshot()
        if not snapshot then manager.status = "Title data unavailable"; return end
        local priority = CFG.titleStat
        local function cancelled()
            return _stopped or getData() ~= snapshot.data or CFG.titleStat ~= priority
                or (automatic and not CFG.autoBestTitles)
        end
        local changes = manager.plan(snapshot)
        if #changes == 0 then
            manager.status = #snapshot.candidates > 0 and "Best available bonuses equipped" or "No matching unlocked title"
            return
        end
        for _, change in ipairs(changes) do
            if cancelled() then manager.status = "Cancelled"; return end
            manager.status = "Equipping " .. change.id
            toServer("TitleRequest", { action = "equipBoost", titleId = change.id, slot = change.slot })
            local deadline = os.clock() + 2
            while val(snapshot.equipped, "Slot" .. change.slot, "") ~= change.id and os.clock() < deadline do
                if cancelled() then manager.status = "Cancelled"; return end
                task.wait(0.1)
            end
            if val(snapshot.equipped, "Slot" .. change.slot, "") ~= change.id then
                CFG.autoBestTitles = false
                manager.status = "Equip not confirmed; auto equip paused"
                return
            end
        end
        manager.status = "Best available bonuses equipped"
    end)
    manager.busy = false
    if not ok then CFG.autoBestTitles = false; manager.status = "Title equip failed: " .. tostring(err) end
    syncUI()
end
