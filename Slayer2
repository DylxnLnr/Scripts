-- === WORLD DB (built from the game's own region content modules) ===
local DB = { regions = {}, npcs = {}, mobs = {}, quests = {}, bosses = {}, shrines = {}, crystals = {}, questByCode = {} }
function buildDB()
    DB = { regions = {}, npcs = {}, mobs = {}, quests = {}, bosses = {}, shrines = {}, crystals = {}, questByCode = {} }
    local contents = {}
    local ouw = RS:FindFirstChild("Ouwland")
    if ouw and ouw:FindFirstChild("Content") then contents[#contents + 1] = ouw.Content end
    local mini = RS:FindFirstChild("Minigames Place")
    if mini and mini:FindFirstChild("Content") then contents[#contents + 1] = mini.Content end
    if #contents == 0 then return end
    local modules = {}
    for _, c in ipairs(contents) do for _, m in ipairs(c:GetChildren()) do if m:IsA("ModuleScript") then modules[#modules + 1] = m end end end
    for _, m in ipairs(modules) do
        local ok, mod = pcall(req, m)
        if ok and type(mod) == "table" then
            local region = m.Name
            DB.regions[#DB.regions + 1] = region
            if typeof(mod.CrystalAt) == "CFrame" then DB.crystals[region] = mod.CrystalAt.Position
            elseif type(mod.Spawns) == "table" and typeof(mod.Spawns[1]) == "Vector3" then DB.crystals[region] = mod.Spawns[1] end
            for _, s in ipairs(mod.Shrines or {}) do
                if typeof(s.At) == "CFrame" then DB.shrines[#DB.shrines + 1] = { name = s.Name, pos = s.At.Position, region = region } end
            end
            for _, n in pairs(mod.Npcs or {}) do
                if n.Type == 1 and n.Name and n.Spawns and typeof(n.Spawns[1]) == "CFrame" then
                    DB.npcs[n.Name] = { name = n.Name, pos = n.Spawns[1].Position, region = region, shop = n.Shop ~= nil, req = n.Requirements }
                elseif n.Type == 2 and n.SendOver then
                    local so = n.SendOver
                    local sp = so.Spawning or {}
                    local center = sp.Center
                    if typeof(center) == "Vector3" and so.Profile ~= "Civilian" and so.Profile ~= "Horse" and so.Code ~= "Horse" then
                        local code = (so.Settings and so.Settings.NpcCode) or so.Code
                        local locs = {}
                        for _, l in ipairs(type(sp.Locations) == "table" and sp.Locations or {}) do
                            if typeof(l) == "Vector3" then locs[#locs + 1] = l elseif typeof(l) == "CFrame" then locs[#locs + 1] = l.Position end
                        end
                        if #locs == 0 then locs[1] = center end
                        local entry = { name = n.Name, folderName = n.Name, code = code, center = center, region = region, locs = locs,
                            qty = n.Quantity or 1, spawnTime = sp.SpawnTime, boss = so.Boss ~= nil, hp = so.Settings and so.Settings.Health }
                        if entry.boss then DB.bosses[#DB.bosses + 1] = entry end
                        DB.mobs[#DB.mobs + 1] = entry
                    end
                end
            end
            for qn, q in pairs(mod.Quests or {}) do
                q._region = region
                DB.quests[qn] = q
            end
        end
    end
    -- combat quest -> mob code (from the quest instance task list; only codes that are real mobs)
    local mobCodes = {}
    for _, mob in ipairs(DB.mobs) do mobCodes[mob.code] = true end
    for qn, q in pairs(DB.quests) do
        local qi = q.QuestInstance
        local tasks = qi and qi:FindFirstChild("Tasks")
        if tasks then
            for _, t in ipairs(tasks:GetChildren()) do
                local code = t:FindFirstChild("Code")
                if code and code:IsA("StringValue") and mobCodes[code.Value] then
                    q._mobCode = code.Value
                    q._killMax = (t:FindFirstChild("Max") and t.Max.Value) or 1
                    q._killTask = t.Name
                    DB.questByCode[code.Value] = DB.questByCode[code.Value] or {}
                    table.insert(DB.questByCode[code.Value], qn)
                end
            end
        end
    end
    -- mob difficulty = level requirement of the quests targeting it (bosses default high)
    for _, mob in ipairs(DB.mobs) do
        local lvl = mob.boss and 30 or 1
        for _, qn in ipairs(DB.questByCode[mob.code] or {}) do
            local q = DB.quests[qn]
            local rq = q and q.Requirements and q.Requirements.Level
            if rq and rq > lvl then lvl = rq end
        end
        mob.level = lvl
    end
    table.sort(DB.mobs, function(a, b) if a.level ~= b.level then return a.level < b.level end return a.name < b.name end)
    table.sort(DB.bosses, function(a, b) return a.name < b.name end)
    table.sort(DB.regions)
end
pcall(buildDB)

function mobByName(name) for _, m in ipairs(DB.mobs) do if m.name == name then return m end end end
