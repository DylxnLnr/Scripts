                end
            end
            if not table.find(names, selectedSkill) then
                selectedSkill = names[1]
                setIncluded(selectedSkill and not CFG.spExcludedSkills[selectedSkill] or false)
            end
            setSummary(("Available: %d SP | Keep: %d SP\n%s"):format(getSkillPoints(), CFG.spMinPoints or 0, SPENDING.busy and "Purchase pending..." or SPENDING.status))
            local stats = {}
            for _, name in ipairs(STAT_NODES) do
                local rank = val(unlockedList, name, 0)
                local ok, maximum = pcall(function() return asGame(function() return SkillStats.GetMaxIndexForCategory(name) end) end)
                local cost = spCost(name)
                stats[#stats + 1] = ("%s: %s / %s | %s"):format(name, tostring(rank), ok and tostring(maximum) or "?", ok and type(maximum) == "number" and rank >= maximum and "MAX" or ("Next: " .. tostring(cost or "?") .. " SP"))
            end
            setStats(table.concat(stats, "\n"))
            local branches = {}
            for _, node in ipairs(currentNodes) do
                local ok, unlocked = pcall(function() return asGame(function() return SkillStats.IsSkillUnlocked(LP, node.name) end) end)
                local cost, requirements = spCost(node.name)
                local eligible, reason = spCanBuy(node.name)
                local status = ok and unlocked and "Unlocked" or node.locked and "Branch locked" or eligible and "Available" or ("Requires " .. tostring(reason))
                local details = {}
                for _, key in ipairs({ "SkillPoints", "Mastery", "Boss" }) do
                    if requirements[key] ~= nil then details[#details + 1] = key .. ": " .. tostring(requirements[key]) end
                end
                local branch = node.branch or "Other skills"
                branches[branch] = branches[branch] or {}
                branches[branch][#branches[branch] + 1] = ("%s | %s | %s SP"):format(node.name, status, tostring(cost or "?"))
                if selectedSkill == node.name then setDetail(node.name .. " | " .. branch .. "\n" .. status .. "\n" .. table.concat(details, " | ")) end
            end
            if not selectedSkill then setDetail("No skill branches available for this character") end
            for branch, setter in pairs(branchSetters) do setter(table.concat(branches[branch] or { "Branch no longer available" }, "\n")) end
            local progress = {}
