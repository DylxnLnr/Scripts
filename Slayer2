function COMBAT.shouldRetreat(percent)
    if CFG.autoDungeon and CFG.dungeonWaitRegen == false then return false end
    if CFG.retreatLowHP == false and not CFG.autoDungeon then return false end
    local threshold = CFG.autoDungeon and math.max(45, CFG.safeHP or 35) or CFG.safeHP or 35
    local recovery = math.min(100, math.max(CFG.autoDungeon and 70 or CFG.recoveryHP or 50, threshold + 5))
    if CFG.autoDungeon and STATE.dungeon and STATE.dungeon.retreatContext then
        local context = STATE.dungeon.retreatContext()
        if context and context.count >= 1 and context.count <= 2 and context.maxHealth > 0 then
            local finishThreshold = math.max(30, math.max(300, context.damage * 12) / context.maxHealth * 100)
            if finishThreshold < threshold then
