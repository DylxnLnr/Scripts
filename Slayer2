-- Smart pick: strongest farmable mob (XP/kill scales with HP), preferring one with a repeatable combat quest.
function pickSmartMob()
    local lvl = getLevel()
    local best, bestScore
    for _, mob in ipairs(DB.mobs) do
        if not mob.boss and levelOK(mob) and mob.code ~= "VillageSpy" then
            local score = (mob.level or 1) * 10 + (mob.qty or 1)
            local hasQuest = false
            for _, qn in ipairs(DB.questByCode[mob.code] or {}) do
                local q = DB.quests[qn]
                if q and passes(q.Requirements) and not q.LogCompletion then hasQuest = true end
            end
            if hasQuest then score = score + 50 end
            if not bestScore or score > bestScore then best, bestScore = mob, score end
        end
    end
    return best
end

-- Any active combat quest (accepted by the script OR by hand) drives the farm target.
function activeCombatQuestMob()
    for _, n in ipairs(activeQuestNames()) do
        local q = DB.quests[n]
        if q and q._mobCode then
            local m = mobByCode(q._mobCode)
            local prog = questTaskProgress(n)
            local kt = prog and q._killTask and prog[q._killTask]
            local killsLeft = not kt or kt.value < kt.max
            if m and killsLeft and not (m.boss and STATE.avoidBoss(m.name))
                and (not m.boss or CFG.autoBoss or levelOK(m) or (CFG.autoPower and n == CFG.powerQuest)) then return m, n end
        end
    end
    return nil
end

function currentFarmMob()
    if CFG.farmMode ~= "Chosen mob" then
        local m, qn = activeCombatQuestMob()
        if m then STATE.currentQuest = qn; return m end
        if STATE.currentQuest and questState(STATE.currentQuest) ~= "Doing" then STATE.currentQuest = nil end
    end
    if CFG.farmMode == "Smart (best XP)" or CFG.farmMode == "Quest target" then return pickSmartMob() end
    if CFG.farmMob ~= "" then return mobByName(CFG.farmMob) end
    return pickSmartMob()
end

