            task.spawn(function() elevate() local did = trainTick(function(m) notify("Training", m) end) if not did then notify("Training", "No training task in your active quests") end end)
        end)
        secRecovery:addButton("Release combat lock", function() setActivity(nil, false) end)
        sec:addButton("Rejoin same server", function() pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end) end)
    end

    -- ---------- Settings (uses the library's built-in bottom tab button) ----------
    do
        local secCfg = pgSet:addSection("Save / load")
        local cfgName = ""
        secCfg:addTextBox("Config name", "name", "", function(t) cfgName = t end)
        local _, refreshCfg = secCfg:addDropdownList("Existing configs", listConfigs(), function(v) cfgName = v end)
        secCfg:addButton("Save", function() if cfgName ~= "" then notify("Config", saveConfig(cfgName) and ("Saved " .. cfgName) or "Save failed") refreshCfg(listConfigs()) end end)
        secCfg:addButton("Load", function() if cfgName ~= "" then notify("Config", loadConfig(cfgName) and ("Loaded " .. cfgName .. "; activities paused") or "Load failed: invalid config, unavailable files or action in progress") end end)
        secCfg:addButton("Set as autoload", function()
            if cfgName ~= "" then notify("Config", setAutoLoad(cfgName) and ("Autoload: " .. cfgName .. "; saved activities and purchases will resume") or "Autoload failed: save the config first") end
        end)
        secCfg:addButton("Clear autoload", function() notify("Config", setAutoLoad("") and "Autoload cleared" or "Autoload clear failed") end)

        local secW = pgSet:addSection("Discord webhook report")
        local _, setWh = secW:addToggle("Enable", CFG.webhookEnabled, function(v) CFG.webhookEnabled = v end)
        toggleSetters.webhookEnabled = setWh
        local _, setUrl = secW:addTextBox("URL", "https://discord.com/api/webhooks/...", CFG.webhookUrl, function(text)
            CFG.webhookUrl = text:match("^%s*(.-)%s*$")
            STATE.webhook.previous = nil; table.clear(STATE.webhook.queue)
        end)
        textSetters.webhookUrl = setUrl
        local _, setInt = secW:addSlider("Interval (min)", CFG.webhookInterval, 1, 120, function(v) CFG.webhookInterval = v end)
        sliderSetters.webhookInterval = setInt
        for _, setting in ipairs({ { "webhookReport", "Periodic status reports" }, { "webhookSlayer", "Report: Slayer / gourds" }, { "webhookMarket", "Report: market purchases" }, { "webhookLoot", "Report: chests / loot / fishing" },
            { "webhookOnRare", "Alert: rare item acquired" }, { "webhookOnProgress", "Alert: level / Slayer stage" }, { "webhookOnBuy", "Alert: confirmed purchases / gourds used" },
            { "webhookOnChests", "Alert: chest opened" }, { "webhookOnDeaths", "Alert: death" }, { "webhookPing", "Mentions for rare drops / stages / deaths" } }) do
            local key = setting[1]
            local _, setter = secW:addToggle(setting[2], CFG[key], function(enabled) CFG[key] = enabled end)
            toggleSetters[key] = setter
        end
        for _, setting in ipairs({ { "webhookRareMin", "Rare item minimum rank" }, { "webhookPingMin", "Mention minimum item rank" } }) do
            local key = setting[1]
            local _, setter = secW:addSlider(setting[2], CFG[key], 1, 7, function(value) CFG[key] = math.floor(value) end)
            sliderSetters[key] = setter
        end
        local _, setMention = secW:addTextBox("Mention", "<@userID> / <@&roleID> / @everyone", CFG.webhookMention, function(text) CFG.webhookMention = text:match("^%s*(.-)%s*$") end)
        textSetters.webhookMention = setMention
        local _, setDelivery = secW:addLabel(STATE.webhook.status)
        STATE.webhook.refresh = function()
            setDelivery(STATE.webhook.status .. ("\nMessages accepted: %d | Failed/unconfirmed: %d\nQueued events: %d | Dropped events: %d"):format(STATE.webhook.sent, STATE.webhook.failed, #STATE.webhook.queue, STATE.webhook.dropped))
        end
        customSync[#customSync + 1] = STATE.webhook.refresh
        secW:addButton("Test webhook", function()
            task.spawn(function()
                local sent, status = STATE.webhook.send(function()
                    return { username = "Pkaizen Ouwland", allowed_mentions = { parse = {} }, embeds = { {
                        title = "Connection test", description = "Pkaizen Ouwland webhook test", color = 0x39A878, timestamp = DateTime.now():ToIsoDate(),
                    } } }
                end)
                notify("Webhook", (sent and "Sent: " or "Not confirmed: ") .. tostring(status))
            end)
        end)
        secW:addButton("Send status report now", function()
            task.spawn(function()
                local sent, status = sendReport()
                notify("Webhook", (sent and "Sent: " or "Not confirmed: ") .. tostring(status))
            end)
        end)

        local secD = pgSet:addSection("Diagnostics")
        local _, setDiag = secD:addLabel("...")
        secD:addButton("Run diagnostics", function()
            local lines = {}
            lines[#lines + 1] = "Executor: " .. tostring((identifyexecutor and identifyexecutor()) or "?")
            lines[#lines + 1] = ("Modules: SE=%s Quests=%s Items=%s SkillTree=%s Stats=%s"):format(tostring(SE ~= nil), tostring(Quests ~= nil), tostring(Items ~= nil), tostring(SkillTree ~= nil), tostring(SkillStats ~= nil))
            local nN, nQ = 0, 0
            for _ in pairs(DB.npcs) do nN = nN + 1 end
            for _ in pairs(DB.quests) do nQ = nQ + 1 end
            lines[#lines + 1] = ("DB: %d regions, %d npcs, %d mobs, %d bosses, %d quests"):format(#DB.regions, nN, #DB.mobs, #DB.bosses, nQ)
            lines[#lines + 1] = "Combat env: " .. tostring(getCombatEnv() ~= nil) .. " | style=" .. tostring(equippedStyle()) .. " | weapon slot=" .. tostring(bestWeaponSlot())
            lines[#lines + 1] = ("Level %d, Race %s, SP %d, skills: %d"):format(getLevel(), getRace(), getSkillPoints(), #mySkills())
            lines[#lines + 1] = "fireproximityprompt: " .. typeof(fireproximityprompt) .. " | getsenv: " .. typeof(getsenv) .. " | files: " .. tostring(fsOK())
            lines[#lines + 1] = "Identity: " .. typeof(_setid) .. " | connections: " .. typeof(getconnections) .. " | signals: " .. typeof(firesignal)
            lines[#lines + 1] = "Config listing: " .. typeof(listfiles) .. " | directories: " .. typeof(makefolder)
            lines[#lines + 1] = "Teleport queue: " .. tostring(teleportConn ~= nil) .. " | autoload: " .. tostring(getAutoLoad() or "off")
            lines[#lines + 1] = "Chests: " .. tostring(LOOT.chestStatus or LOOT.status)
            setDiag(table.concat(lines, "\n"))
            print("[Pkaizen] " .. table.concat(lines, " | "))
        end)
        secD:addButton("Rebuild world DB", function() pcall(buildDB) notify("DB", #DB.mobs .. " mobs, " .. #DB.bosses .. " bosses") end)
    end

    GW:SelectPage("Overview")
    return GW
end

local GW = buildUI()
STATE.teleportReady = teleportConn ~= nil

_G.PkaizenOuwland = {
    stop = function()
        _stopped = true
        pcall(stopLock)
        pcall(CRAFT.slayer.stop)
        pcall(fishHookRemove)
        pcall(function() for k, v in pairs(CFG) do if type(v) == "boolean" then CFG[k] = false end end end)
        pcall(function() if antiAfkConn then antiAfkConn:Disconnect() end end)
        pcall(function() if teleportConn then teleportConn:Disconnect() end end)
    end,
    onClose = function()
        CFG.autoSlayer = false
        STATE.activityEpoch = (STATE.activityEpoch or 0) + 1
        pcall(CRAFT.slayer.stop)
        pcall(stopLock)
    end,
    cfg = CFG, state = STATE, db = DB, fish = FISH,
    debug = {
        dungeon = STATE.dungeon,
        combat = COMBAT,
        slayer = CRAFT.slayer,
        setActivity = setActivity,
        finalSelection = FSR,
        skillCasting = _skillLast,
        loot = LOOT, collectLoot = collectLoot,
        acceptQuest = acceptQuest, doStoryQuest = doStoryQuest, storyCandidates = storyCandidates,
        eligibleCombatQuests = eligibleCombatQuests, spendSkillPoints = spendSkillPoints, skillNodes = skillNodes,
        liveMobs = liveMobs, pickSmartMob = pickSmartMob, mySkills = mySkills, swing = swing, useSkill = useSkill,
        trainTick = trainTick, openChests = openChests, potionTick = potionTick, saveConfig = saveConfig, loadConfig = loadConfig,
        setAutoLoad = setAutoLoad, getAutoLoad = getAutoLoad, listConfigs = listConfigs,
        syncUI = syncUI,
        lockTo = lockTo, stopLock = stopLock, toServer = toServer, getLevel = getLevel, buildDB = buildDB,
        currentFarmMob = currentFarmMob, ensureEquipped = ensureEquipped, bestWeaponSlot = bestWeaponSlot,
        fishTick = fishTick, fishStop = fishStop, sellableFish = sellableFish, sellFishNow = sellFishNow, myFishingObjects = myFishingObjects,
        powerTick = powerTick, fsCountdown = fsCountdown, spinTick = spinTick,
    },
}
_G.__pkHubReady = true

do
    local auto = getAutoLoad()
    task.defer(function()
        local env = (typeof(getgenv) == "function" and getgenv()) or _G
        local dungeonResume = env.PKAIZEN_OUW_RESUME_DUNGEON
        env.PKAIZEN_OUW_RESUME_DUNGEON = nil
        if type(dungeonResume) == "table" and type(dungeonResume.cfg) == "table" then
            for key, value in pairs(dungeonResume.cfg) do if CFG[key] ~= nil and type(CFG[key]) == type(value) then CFG[key] = value end end
            for key, value in pairs(dungeonResume.dungeon or {}) do STATE.dungeon[key] = value end
            for key, value in pairs(dungeonResume.slayer or {}) do CRAFT.slayer[key] = value end
            for key, value in pairs(dungeonResume.state or {}) do STATE[key] = value end
            CFG.autoSpin = false
            if not _stopped then setActivity("autoDungeon", true) end
        elseif auto and auto ~= "" then
            notify("Config", loadConfig(auto, true) and ("Autoloaded " .. auto .. "; saved activities and purchases restored") or ("Autoload failed: " .. auto))
        end
        local resume = env.PKAIZEN_OUW_RESUME_FS
        env.PKAIZEN_OUW_RESUME_FS = nil
        if not _stopped and IN_MINIGAME and type(resume) == "table" then
            CFG.fsAllowBandage = resume.bandage == true
            setActivity("autoFinalSelection", true)
        end
    end)
end
notify("Pkaizen Hub", "Ouwland loaded - press P to toggle")
pcall(function() if _G.__pkLoaderFinish then _G.__pkLoaderFinish() end end)
