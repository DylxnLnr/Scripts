    FISH.nextBuyBait = os.clock() + 25
    local bought = false
    for _, name in ipairs(BAIT_ORDER) do
        if invAmount(name) <= 0 and baitBuyOne(name, CFG.baitBuyMaxWen or 12, CFG.baitBuyQty or 5) then
            FISH.baitBuyTries = 0
