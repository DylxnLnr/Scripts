function STATE.dungeon.oneShotTick()
    if _stopped or not CFG.autoDungeon or not CFG.dungeonOneShot or not alive()
        or workspace:GetAttribute("MinigameKey") ~= "Ouwigahara"
        or LP:GetAttribute("InShops") or LP:GetAttribute("Spectating") then return end
    local manager, now = STATE.dungeon, os.clock()
    if now < (manager.nextOneShot or 0) then return end
    manager.nextOneShot = now + 0.2
    manager.oneShotAttempts = manager.oneShotAttempts or setmetatable({}, { __mode = "k" })
    for _, entry in ipairs(liveMobs()) do
        local model, humanoid = entry.model, entry.hum
        if model.Parent and model ~= getChar() and not Players:GetPlayerFromCharacter(model)
            and not model:FindFirstChild("OuwigaharaAlly")
            and humanoid and humanoid.Health > 0 and humanoid.MaxHealth > 0
            and humanoid.Health <= humanoid.MaxHealth * 0.99 then
            local attempt = manager.oneShotAttempts[humanoid]
            local root = model:FindFirstChild("HumanoidRootPart")
            if (not attempt or (attempt.count < 2 and now >= attempt.nextTry
                and humanoid.Health <= attempt.health - humanoid.MaxHealth * 0.01))
                and root and root:IsA("BasePart") and type(isnetworkowner) == "function" then
                local checked, owned = pcall(isnetworkowner, root)
                if checked and owned == true then
                    manager.oneShotAttempts[humanoid] = {
                        count = (attempt and attempt.count or 0) + 1,
                        health = humanoid.Health, nextTry = now + 2,
                    }
                    local ok, reason = pcall(function() humanoid.Health = 0 end)
                    if not ok then
                        CFG.dungeonOneShot = false
                        manager.oneShotError = tostring(reason)
                        syncUI()
                        return
                    end
                    manager.oneShotWrites = (manager.oneShotWrites or 0) + 1
                end
            end
        end
    end
end
function STATE.dungeon.tick()
    local manager = STATE.dungeon
    local intermission = RS:FindFirstChild("Intermission")
    local offers = LP:FindFirstChild("OuwigaharaOffers")
    local phase = manager.phase({ key = workspace:GetAttribute("MinigameKey"), mainWorld = game.PlaceId == 136406881576517,
        phase = intermission and intermission:GetAttribute("Phase"), shops = LP:GetAttribute("InShops"),
        spectating = LP:GetAttribute("Spectating"), alive = alive(), offers = offers ~= nil,
        waveBreak = workspace:GetAttribute("MinigameWaveBreak") })
    local floor = tonumber(workspace:GetAttribute("MinigameFloor")) or 0
    manager.bestFloor = math.max(manager.bestFloor, floor)
    if manager.runStarted ~= workspace:GetAttribute("MinigameRunStarted") then
        manager.runStarted = workspace:GetAttribute("MinigameRunStarted")
        manager.ended = nil; manager.skippedBreak = nil; manager.pendingPick = nil
    end
    if phase ~= "combat" then stopLock() end
    if phase ~= "reward" and manager.pendingPick and manager.pendingPick.folder.Parent ~= LP then
        manager.pick(nil)
    end
    if phase == "entry" then
        if not STATE.teleportReady then manager.status = "Teleport reload unavailable; provide a local hub file or loader"; return end
        local prompt = manager.findPrompt("Ouwigahara", "Enter")
        if prompt then manager.prompt(prompt, "Enter Ouwigahara")
        elseif os.clock() >= (manager.nextStream or 0) then
            manager.nextStream = os.clock() + 8
            tpPos(Vector3.new(-1607.11, 1016.47, 1142.36), 0)
            manager.status = "Streaming the Ouwigahara entrance"
        end
    elseif phase == "ready" then
        if LP:GetAttribute("Readied") then manager.status = "Ready; waiting for the countdown"
        else manager.prompt(manager.findPrompt("ReadyUp"), "Ready Up") end
    elseif phase == "starting" then manager.status = "Lobby countdown"
    elseif phase == "reward" then manager.pick(offers)
    elseif phase == "respawn" then manager.status = "Waiting for respawn; automation stays enabled"
    elseif phase == "spectating" then manager.status = "No hearts; waiting for revive or run end"
    elseif phase == "ended" then
        if not manager.ended then manager.ended = true; manager.runs = manager.runs + 1 end
        if manager.shopBlocked then manager.status = "Run ended; resolve the unconfirmed purchase before leaving"; return end
        if manager.shopTick and manager.shopTick() then return end
        if CFG.dungeonRepeat then
            if not STATE.teleportReady then manager.status = "Run ended; automatic return needs teleport reload"; return end
            local prompt = manager.findPrompt(nil, "Leave")
            if prompt then manager.prompt(prompt, "Leave Ouwigahara")
            elseif os.clock() >= (manager.nextStream or 0) then
                manager.nextStream = os.clock() + 8
                tpPos(Vector3.new(-2315, 1147, -2582), 0)
                manager.status = "Locating the native exit"
            end
        else manager.status = "Run finished; repeat disabled" end
    elseif phase == "break" then
        local hum = getHum()
        manager.status = CFG.dungeonWaitRegen and "Between waves: recovering before continuing" or "Between waves: ready to continue"
        local waveBreak = workspace:GetAttribute("MinigameWaveBreak")
        if CFG.dungeonSkipBreak and hum and (not CFG.dungeonWaitRegen or hum.Health / math.max(1, hum.MaxHealth) >= 0.85)
            and manager.skippedBreak ~= waveBreak then
            manager.skippedBreak = waveBreak
            toServer("OuwigaharaRequest", { action = "Skip" })
        end
    elseif phase == "combat" then
        if not alive() then return end
        manager.oneShotTick()
        local root, target = getHRP(), STATE.target
        local humanoid = target and target.Parent and target:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            stopLock()
            local bestScore
            for _, entry in ipairs(liveMobs()) do
                local enemyRoot = entry.model:FindFirstChild("HumanoidRootPart")
                if enemyRoot and root and not entry.model:FindFirstChild("OuwigaharaAlly") and not Players:GetPlayerFromCharacter(entry.model) then
                    local distance = (enemyRoot.Position - root.Position).Magnitude
                    local score = distance + entry.hum.Health / math.max(1, entry.hum.MaxHealth) * 35
                    if not bestScore or score < bestScore then target, humanoid, bestScore = entry.model, entry.hum, score end
                end
            end
            if bestScore then
                STATE.targetIsBoss = false
                local mob = mobByName(target.Parent.Name)
