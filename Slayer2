    if #mobs ~= remaining then return nil end
    for _, entry in ipairs(mobs) do
        local amount = tonumber(entry.model:GetAttribute("M1Damage"))
        if not amount or amount <= 0 then return nil end
        damage = math.max(damage, amount)
    end
    local hum = getHum()
