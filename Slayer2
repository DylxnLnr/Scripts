function CRAFT.horse.readNotice()
    -- Game notifications render one TextLabel per word; rebuild the sentence from the sibling labels.
    local gui = LP:FindFirstChild("PlayerGui")
    local holder = gui and gui:FindFirstChild("ComponentsHolder")
    for _, label in ipairs(holder and holder:GetDescendants() or {}) do
        if label:IsA("TextLabel") and label.Visible and label.Text:gsub("<[^>]+>", ""):find("Horse") and label.Parent then
            local words = {}
            for _, sibling in ipairs(label.Parent:GetChildren()) do
                if sibling:IsA("TextLabel") then words[#words + 1] = { order = sibling.LayoutOrder, x = sibling.AbsolutePosition.X, text = sibling.Text:gsub("<[^>]+>", "") } end
            end
            table.sort(words, function(a, b) if a.order ~= b.order then return a.order < b.order end return a.x < b.x end)
            local parts = {}
            for _, word in ipairs(words) do parts[#parts + 1] = word.text end
            local sentence = table.concat(parts, " "):gsub("%s+", " ")
            local lower = sentence:lower()
            if lower:find("wen") or lower:find("purchase") or lower:find("already own") or lower:find("afford") then return sentence end
        end
    end
end
