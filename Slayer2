-- returns true when it owns the character this tick, false to let the farm loop (kill task) run
function powerTick()
    local qn = CFG.powerQuest
    local q = qn ~= "" and questInfo(qn)
    if not q then STATE.farmStatus = "Pick a power quest"; return true end
    local st = questState(qn)
    if st == "Done" then
        CFG.autoPower = false
        notify("Power", "Learned! " .. qn)
        return false
    end
    if st ~= "Doing" then
        local costly = (q.WenCostOnAccept or 0) > 0 or q.ItemCostOnAccept ~= nil
        if costly and not CFG.powerAllowCost then
            STATE.farmStatus = ("%s costs %s Wen%s - enable 'Allow the quest cost'"):format(qn, tostring(q.WenCostOnAccept or 0), q.ItemCostOnAccept and " + items" or "")
            return true
        end
        if os.clock() - POWER.lastTry < 12 then return true end
        POWER.lastTry = os.clock()
        stopLock()
        local ok, why = acceptQuest(qn)
        STATE.farmStatus = ok and ("Accepted " .. qn) or ("Power quest: " .. tostring(why))
        if not ok and why == "requirements" then notify("Power", "You do not meet the requirements for " .. qn) end
        return true
    end
    if trainTick(function(m) STATE.farmStatus = m end) then return true end
    local prog = questTaskProgress(qn) or {}
    for tn, p in pairs(prog) do
        local spec = q.TaskSpecs and q.TaskSpecs[tn]
        if spec and p.value < p.max then
            if spec.Type == "DeliverAny" then
                local have
                for _, n in ipairs(spec.RequiredItems or {}) do if invAmount(n) > 0 then have = n break end end
                local npc = spec.TargetNpc and DB.npcs[spec.TargetNpc]
                if have and npc and os.clock() - POWER.lastDeliver > 6 then
                    POWER.lastDeliver = os.clock()
                    stopLock()
                    STATE.farmStatus = "Delivering " .. have .. " to " .. spec.TargetNpc
                    tpPos(npc.pos, 3); task.wait(0.9)
                    toServer("QuestProgress", qn, tn)
                    task.wait(0.8)
                    return true
                elseif not have then
                    if not CFG.autoFish then CFG.autoFish = true; POWER.fishing = true; notify("Power", "Need a fish for " .. tn .. " - Auto Fish enabled") end
                    STATE.farmStatus = "Fishing for " .. tn
                    fishTick()
                    return true
                end
            elseif spec.Type == "Dungeon" then
                STATE.farmStatus = tn .. " (dungeon) must be done by hand - farming the other tasks"
            end
        end
    end
    if POWER.fishing then POWER.fishing = false; CFG.autoFish = false; fishStop() end
    return false
end



