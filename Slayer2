function fishHookInstall()
    local L = Portal and Portal.CurrentListeners and Portal.CurrentListeners.FishingRod
    if not L then return false end
    if FISH.listener == L and L.Callback == FISH.hook then return true end
    if FISH.listener and FISH.listener ~= L and FISH.listener.Callback == FISH.hook then FISH.listener.Callback = FISH.origCb end
    FISH.listener, FISH.origCb = L, L.Callback
    FISH.hook = function(name, ...)
        local args = table.pack(...)
        if name == "Bite" and CFG.autoFish then
            -- the server only accepts a success verdict if >= 4.5s elapsed since the bite (Rare_Fishing_RodServer: os.clock() - BiteAt >= 4.5)
            -- so we must hold the line for 4.8s, then report success through the portal link; skipping the original callback = no UI/freeze
            FISH.bites = FISH.bites + 1
            local token = args[1]
            FISH.biteId = (FISH.biteId or 0) + 1
            local myId = FISH.biteId
            task.spawn(function()
                local waited = 0
                while waited < 4.8 and CFG.autoFish and not _stopped do
                    task.wait(0.1)
                    waited = waited + 0.1
                end
                if not CFG.autoFish or _stopped then return end
                if myId ~= FISH.biteId then return end
                pcall(function()
                    if FISH.listener and FISH.listener.Server then
                        FISH.listener:Server(token, true)
                    elseif L and L.Server then
                        L:Server(token, true)
                    end
                end)
            end)
            return
        end
        if name == "BiteMissed" and CFG.autoFish then
            FISH.missed = (FISH.missed or 0) + 1
            fishLog("Catch slipped (server fishing chance)")
        end
        if FISH.origCb then return FISH.origCb(name, table.unpack(args, 1, args.n)) end
    end
    L.Callback = FISH.hook
    return true
end
function fishHookRemove()
    if FISH.listener and FISH.listener.Callback == FISH.hook then FISH.listener.Callback = FISH.origCb end
