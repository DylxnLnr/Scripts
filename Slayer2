            if uiRefs.fish then
                local rodName = rodInInventory()
                uiRefs.fish(("Rod: %s | %s\n%d casts | %d bites | %d slipped\n%d prizes | %d collected | %d Wen sold"):format(rodName or "none", FISH.status ~= "" and FISH.status or "off", FISH.casts, FISH.bites, FISH.missed or 0, FISH.prizes or 0, FISH.catches, FISH.soldWen))
            end
            if uiRefs.fs then
                if IN_MINIGAME then
                    local qn = fsActiveQuest()
                    local parts = {}
                    for tn, p in pairs(qn and questTaskProgress(qn) or {}) do parts[#parts + 1] = (("%s %d/%d"):format(tn, p.value, p.max)) end
