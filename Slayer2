CRAFT.progressionModule = safeReq("CAM.Global.PlayerProgression")
function CRAFT.describeProgression()
    local progression = CRAFT.progressionModule
    if not progression then return "Progression data unavailable" end
    local ok, report = pcall(function()
        return asGame(function()
            local lines = {}
            for _, side in ipairs(progression.SidesFor(LP)) do
                if progression.Get(LP, side) == nil then
                    lines[#lines + 1] = side .. ": progression unavailable"
                    continue
                end
                local level = progression.GetLevel(LP, side)
                lines[#lines + 1] = ("%s | Stage %d / %d"):format(side, level, progression.MaxLevel())
                if progression.IsMaxLevel(LP, side) then
                    lines[#lines + 1] = "Final stage reached"
                    continue
                end
                local remaining = progression.Remaining(LP, side)
                lines[#lines + 1] = ("%d / %d points | %d remaining"):format(
                    progression.GetCurrent(LP, side), progression.GetMax(LP, side), remaining)
                local function appendValues(title, values)
                    local names, entries = {}, {}
                    for name in pairs(values or {}) do names[#names + 1] = name end
                    table.sort(names)
                    for _, name in ipairs(names) do
                        local value = values[name]
                        entries[#entries + 1] = value == true and name or (name .. ": " .. tostring(value))
                    end
                    if #entries > 0 then lines[#lines + 1] = title .. table.concat(entries, ", ") end
                end
                appendValues("Next stage bonuses: ", progression.GetStats(side, level + 1))
                appendValues("Next stage rewards: ", progression.GetRewards(side, level + 1))
                local sources = progression.Progressers and progression.Progressers[side .. "s"] or {}
                local names = {}
                for name in pairs(sources) do names[#names + 1] = name end
                table.sort(names)
                for _, name in ipairs(names) do
                    local points = tonumber(sources[name])
                    if points and points > 0 then
                        lines[#lines + 1] = ("%s: %d points | owned %d | %d needed alone"):format(
                            name, points, invAmount(name), math.ceil(remaining / points))
                    end
                end
            end
            return #lines > 0 and table.concat(lines, "\n") or "No progression available for this character"
        end)
    end)
    return ok and report or "Progression data unavailable"
end
local MASTERY = {
    source = safeReq("CAM.Global.Collectibles.MasterySource"),
    settings = safeReq("CAM.Global.gameSettings"),
    increments = {},
}
CFG.farmGoalMastery = ""
CFG.farmGoalMasteryLevel = 0
CFG.farmGoalMasteryCategory = ""
function MASTERY.resolve(category)
    if not MASTERY.source then return nil end
    local ok, definition = pcall(function() return asGame(function() return MASTERY.source(category) end) end)
    if not ok or not definition or definition.Mastery == false then return nil end
    local spec = definition.Mastery
    local name = type(spec) == "string" and spec or type(spec) == "table" and spec.Value or category
    local increment = type(spec) == "table" and spec.IncrementAmount or MASTERY.settings and MASTERY.settings.expPerMasteryDefault
    if type(increment) ~= "number" or increment <= 0 then return nil end
    return name, increment
end
function MASTERY.status(name, category)
    local data = getData()
    local list = data and data:FindFirstChild("MasteryProgressionList")
    local entry = list and list:FindFirstChild(name)
    local key = name .. ":" .. (category or "")
    local increment = MASTERY.increments[key]
    if not increment then
        local resolved
        resolved, increment = MASTERY.resolve(category and category ~= "" and category or name)
        if resolved ~= name then
            increment = MASTERY.settings and MASTERY.settings.expPerMasteryDefault
            for itemName in pairs(Items or {}) do
                local candidate, amount = MASTERY.resolve(itemName)
                if candidate == name then increment = amount; break end
            end
        end
        MASTERY.increments[key] = increment
    end
    if type(increment) ~= "number" or increment <= 0 then return nil end
    local goal = entry and tonumber(val(entry, "Goal", 0)) or 0
    local current = entry and tonumber(val(entry, "Current", 0)) or 0
    return math.floor(goal / increment), current, goal
end
function MASTERY.goal()
    local name, target = CFG.farmGoalMastery, tonumber(CFG.farmGoalMasteryLevel) or 0
    if type(name) ~= "string" or name == "" or target <= 0 then return nil end
    local level = MASTERY.status(name, CFG.farmGoalMasteryCategory or "")
    if level and level >= target then CFG.farmGoalMasteryLevel = 0; return name .. " mastery " .. target end
end
function MASTERY.describe()
    local name, target = CFG.farmGoalMastery, tonumber(CFG.farmGoalMasteryLevel) or 0
    if type(name) ~= "string" or name == "" or target <= 0 then return "Mastery goal: off" end
    local level, current, goal = MASTERY.status(name, CFG.farmGoalMasteryCategory or "")
    return ("%s: level %s / %d | %s / %s XP"):format(name, tostring(level or "?"), target, tostring(current or "?"), tostring(goal or "?"))
end
-- A reached goal is cleared so re-enabling the farm does not stop it again immediately.
function reachedFarmGoal()
    if not (CFG.autoFarm or CFG.autoBoss or CFG.autoQuests) then return nil end
    if (CFG.farmGoalLevel or 0) > 0 and getLevel() >= CFG.farmGoalLevel then CFG.farmGoalLevel = 0; return "Level reached" end
    if (CFG.farmGoalWen or 0) > 0 and not CFG.autoSlayer and getWen() >= CFG.farmGoalWen then CFG.farmGoalWen = 0; return "Wen reached" end
    if (CFG.farmGoalKills or 0) > 0 and STATE.kills >= CFG.farmGoalKills then CFG.farmGoalKills = 0; return "Session kills reached" end
    return MASTERY.goal()
end
function collectionQuestList()
    local names = {}
    for name, quest in pairs(Quests and Quests.Holder or {}) do
        local supported = quest.OfferNpc and DB.npcs[quest.OfferNpc] ~= nil
        local count = 0
        for _, spec in pairs(quest.TaskSpecs or {}) do
            count = count + 1
            if spec.Type ~= "Pickup" and spec.Type ~= "Deliver" then supported = false end
        end
        if supported and count > 0 then names[#names + 1] = name end
    end
    table.sort(names)
    return names
end
function collectionTick()
    local name = CFG.collectionQuest
    local quest = questInfo(name)
    if not quest or not table.find(collectionQuestList(), name) then
        STATE.farmStatus = "Collection: selected route unavailable"
        return
    end
    if questState(name) == "Done" then
        setActivity(nil, false)
        STATE.farmStatus = "Collection complete: " .. name
        return
    end
    if questState(name) ~= "Doing" then
        if not passes(quest.Requirements) then STATE.farmStatus = "Collection locked: character requirements"; return end
        if (tonumber(quest.WenCostOnAccept) or 0) > 0 or quest.ItemCostOnAccept then
            STATE.farmStatus = "Collection paused: accept this paid quest manually first"
            return
        end
        local cooldown = questCooldownLeft()
        if cooldown > 0 then STATE.farmStatus = ("Collection cooldown: %ds"):format(math.ceil(cooldown)); return end
        if not canAddQuest(name) then STATE.farmStatus = "Collection waiting: another quest occupies this category"; return end
    end
    local epoch = STATE.activityEpoch
    stopLock()
    STATE.farmStatus = "Collection: " .. name
    local completed, reason = doStoryQuest(name, function(message) STATE.farmStatus = "Collection: " .. message end)
    if STATE.activityEpoch ~= epoch or _stopped then return end
    if completed then
        STATE.questsDone = STATE.questsDone + 1
        STATE.farmStatus = "Collection completed; waiting for the next run"
        if quest.LogCompletion then
            setActivity(nil, false)
            STATE.farmStatus = "Collection complete: " .. name
        end
    else
        setActivity(nil, false)
        STATE.farmStatus = "Collection stopped: " .. tostring(reason)
        notify("Collection", STATE.farmStatus)
    end
end
