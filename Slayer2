        log("Current clan already matches the target")
        return true, startClan
    end
    local bag = d and d:FindFirstChild("Spinning")
    bag = bag and bag:FindFirstChild("ClanBag")
    if not bag or startClan == "" then log("Clan / bag data unavailable - no spins used"); return false, startClan end
    local owned, emptySlot = { [startClan] = true }, nil
    local stored = false
    for _, name in ipairs({ "One", "Two", "Three" }) do
        local slot = bag:FindFirstChild(name)
        if slot and slot:IsA("StringValue") then
            if slot.Value == "" then emptySlot = emptySlot or slot
            else owned[slot.Value] = true; stored = stored or slot.Value == startClan end
        end
    end
    if CFG.spinSkipOwned and next(wanted) then
        local available = false
        for name in pairs(wanted) do if not owned[name] then available = true end end
        if not available then log("All selected clans are already owned - no spins used"); return false, startClan end
    end
    if not stored and not emptySlot then log("Bag full: store your current clan before rerolling"); return false, startClan end
    manager.busy, manager.used = true, 0
    local generation, skipOwned = manager.generation, CFG.spinSkipOwned
    local limit = math.clamp(math.floor(tonumber(maxSpins) or 10), 1, 200)
    local function cancelled()
        return _stopped or manager.generation ~= generation or getData() ~= d or automatic and not CFG.autoSpin
    end
    local ok, reached, result = pcall(function()
        if cancelled() then return false, startClan end
        if not stored then
            if emptySlot.Value ~= "" then log("Bag changed - stopped"); return false, startClan end
            local saved = spinBag("Set", true, emptySlot.Name)
            local deadline = os.clock() + 3
            while saved and emptySlot.Value ~= startClan and not cancelled() and os.clock() < deadline do task.wait(0.05) end
            if not saved or emptySlot.Value ~= startClan then
                log("Bag save not confirmed - no spins used"); return false, startClan
            end
            log("Protected " .. startClan .. " in slot " .. emptySlot.Name)
        end
        while manager.used < limit and not cancelled() do
            local spins, free = spinCounts()
            if spins + free <= 0 then log("No spins left"); break end
            manager.used = manager.used + 1
            local res, err = spinOnce(true)
            if type(res) ~= "string" or res == "" then
                log("Spin response unconfirmed; stopped without retry: " .. tostring(err)); break
            end
            local deadline = os.clock() + 3
            while not cancelled() and os.clock() < deadline do
                local currentSpins, currentFree = spinCounts()
                if val(d, "Clan", "") == res and currentSpins + currentFree < spins + free then break end
                task.wait(0.05)
            end
            local currentSpins, currentFree = spinCounts()
            if val(d, "Clan", "") ~= res or currentSpins + currentFree >= spins + free then
                log("Spin replication unconfirmed; stopped without retry"); break
            end
            log(("Spin %d/%d: %s (%s)%s"):format(manager.used, limit, res, clanRarity(res),
                skipOwned and owned[res] and " - already owned" or ""))
            if spinTargetMatches(res, selected, wanted) and not (skipOwned and owned[res]) then
                log("Target reached: " .. res); return true, res
            end
        end
        log("Series ended; last rolled clan kept equipped, bag unchanged")
        return false, val(d, "Clan", "")
    end)
    manager.busy = false
    if not ok then log("Spin series error: " .. tostring(reached)); return false, val(getData(), "Clan", "") end
    return reached, result
end

-- === AUTO SKILL POINTS (skills first when unlockable, then stats by priority) ===
function spCanBuy(name)
    if not SkillTree or not SkillTree.RequirementsSolver then return false, "Skill tree unavailable" end
    local loaded, requirements = pcall(function() return asGame(function() return SkillStats.GetRequirements(LP, name) end) end)
    if not loaded or type(requirements) ~= "table" then return false, "Requirements unavailable" end
    for requirement, value in pairs(requirements) do
        local solver = SkillTree.RequirementsSolver[requirement]
        if not solver or type(solver.CanBuy) ~= "function" then return false, "Unknown requirement: " .. tostring(requirement) end
        local ok, can = pcall(function() return asGame(function() return solver.CanBuy(LP, name, value) end) end)
        if not ok or can ~= true then return false, tostring(requirement) .. ": " .. tostring(value) end
    end
    return true
end
function spCost(name)
    local ok, r = pcall(function() return asGame(function() return SkillStats.GetRequirements(LP, name) end) end)
    return ok and type(r) == "table" and r.SkillPoints or nil, ok and type(r) == "table" and r or {}
end
function skillNodes()
    local nodes = {}
    local ok, branches = pcall(function() return asGame(function() return SkillTree.GetBranches(LP) end) end)
    if not ok or type(branches) ~= "table" then return nodes end
    local function walk(node, branch, locked)
        locked = locked or node.Locked == true
        if node.IsBranch then branch = node.Name end
        if node.Name and not node.IsBranch and not node.ProgressionIndex then nodes[#nodes + 1] = { name = node.Name, branch = branch, locked = locked } end
        for _, child in ipairs(node) do walk(child, branch, locked) end
    end
    for _, root in ipairs(branches) do walk(root, root.Name) end
    return nodes
end
local SPENDING = { busy = false, status = "No purchases this session" }
function spendSkillPoints(log, target, automatic)
    if SPENDING.busy then return 0, "A purchase is already running" end
    log = log or function() end
    local d = getData()
    if not d then return 0 end
    local slot = d
    local function cancelled()
        return _stopped or getData() ~= slot or (automatic and not CFG.autoSkillPoints)
    end
    SPENDING.busy = true
    local function report(message)
        SPENDING.status = message
        log(message)
    end
    local ok, result = pcall(function()
    local spent = 0
    local points = getSkillPoints()
    -- 1) skills (power/clan/innate) that are buyable right now
    local reserve = math.max(0, tonumber(CFG.spMinPoints) or 0)
    local targetSkill = false
    for _, n in ipairs(skillNodes()) do
        if target == n.name then targetSkill = true end
        if cancelled() then return spent end
        local unlocked = false
        pcall(function() unlocked = asGame(function() return SkillStats.IsSkillUnlocked(LP, n.name) end) == true end)
        local selected = target and target == n.name or not target and CFG.spBuySkills ~= false and not (CFG.spExcludedSkills or {})[n.name]
        if selected and not unlocked and not n.locked then
            local cost, reqs = spCost(n.name)
            if cost then
                if spCanBuy(n.name) and points - cost >= (tonumber(CFG.spMinPoints) or 0) then
                    toServer("UnlockSkillTreeNode", n.name)
                    local confirmed, bought
                    local deadline = os.clock() + 2
                    repeat
                        task.wait(0.1)
                        confirmed, bought = pcall(function() return asGame(function() return SkillStats.IsSkillUnlocked(LP, n.name) end) end)
                    until (confirmed and bought == true) or cancelled() or os.clock() >= deadline
                    if confirmed and bought == true then
                        report("Unlocked skill " .. n.name .. " (" .. cost .. " SP)")
                        spent = spent + 1
                    else
                        report("Not confirmed: " .. n.name)
                        return spent
                    end
                    if target then return spent end
                    points = getSkillPoints()
                elseif CFG.spReserveSkills and (reqs.Mastery or reqs.Boss) then
                    reserve = math.max(reserve, (tonumber(CFG.spMinPoints) or 0) + cost)
                end
            end
        end
    end
    if targetSkill then report("Selected skill is already unlocked, locked, or outside your budget"); return spent end
    -- 2) stats by priority
    local unlockedList = d:FindFirstChild("SkillTreeUnlockedList")
    local prio = {}
    if type(CFG.spPriority) == "table" then
        for _, s in ipairs(CFG.spPriority) do prio[#prio + 1] = s end
    else
        for s in tostring(CFG.spPriority):gmatch("[^,]+") do prio[#prio + 1] = s:gsub("^%s+", ""):gsub("%s+$", "") end
    end
    if target then prio = { target } end
    local progressed = true
    while progressed and (target or CFG.spBuyStats ~= false) do
        if cancelled() then return spent end
        progressed = false
        points = getSkillPoints()
        for _, stat in ipairs(prio) do
            if cancelled() then return spent end
            points = getSkillPoints()
            local have = unlockedList and unlockedList:FindFirstChild(stat) and unlockedList[stat].Value or 0
            local maxIdx = 6
            pcall(function() maxIdx = asGame(function() return SkillStats.GetMaxIndexForCategory(stat) end) or 6 end)
            if (not target or target == stat) and have < maxIdx then
                local ok, r = pcall(function() return asGame(function() return SkillStats.GetRequirementsAt(LP, stat, have + 1) end) end)
                local cost = ok and type(r) == "table" and r.SkillPoints
                if cost and points - cost >= reserve and spCanBuy(stat) then
                    toServer("UnlockSkillTreeNode", stat)
                    local nowHave
                    local deadline = os.clock() + 2
                    repeat
                        task.wait(0.1)
                        nowHave = unlockedList and unlockedList:FindFirstChild(stat) and unlockedList[stat].Value or 0
                    until nowHave > have or cancelled() or os.clock() >= deadline
                    if nowHave > have then
                        report(("Stat %s -> %d (%d SP)"):format(stat, nowHave, cost))
                        spent = spent + 1
                        if target then return spent end
                        progressed = true
                        break
                    end
                    report("Not confirmed: " .. stat)
                    return spent
                end
            end
        end
    end
    if spent == 0 then report("No eligible purchase within your point budget") end
    return spent
    end)
    SPENDING.busy = false
    if not ok then
        SPENDING.status = "Purchase stopped: " .. tostring(result)
        return 0, SPENDING.status
    end
    return result
end

-- === BOSS FARM ===
function bossTick()
    local boss
    if (CFG.bossName or "") ~= "" then
        STATE.bossRotation = nil
        for _, entry in ipairs(DB.bosses) do if entry.name == CFG.bossName then boss = entry; break end end
        if not boss then stopLock(); STATE.farmStatus = "Selected boss unavailable"; return end
    else
        local bosses = {}
        local selected = CFG.bossSelection
        if type(selected) == "table" then
            for _, entry in ipairs(DB.bosses) do
                if selected[entry.name] then bosses[#bosses + 1] = entry end
            end
        end
        if #bosses == 0 then
            for _, entry in ipairs(DB.bosses) do if levelOK(entry) then bosses[#bosses + 1] = entry end end
        end
        table.sort(bosses, function(first, second)
            if first.level ~= second.level then return first.level < second.level end
            return first.name < second.name
        end)
        if #bosses == 0 then stopLock(); STATE.farmStatus = "No bosses within your level limit"; return end
        local rotation = STATE.bossRotation
        if not rotation or rotation.epoch ~= STATE.activityEpoch then
            rotation = { index = 1, epoch = STATE.activityEpoch, arrivedAt = os.clock() }
            STATE.bossRotation = rotation
        end
        local target = rotation.target
        local humanoid = target and target:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health <= 0 then
            stopLock()
            rotation.index = rotation.index % #bosses + 1
            rotation.target = nil
            rotation.arrivedAt = os.clock()
        end
        rotation.index = math.clamp(rotation.index, 1, #bosses)
        rotation.count = #bosses
        boss = bosses[rotation.index]
        local available = liveMobs(boss.folderName, boss.region)
        if #available == 0 then
            for offset = 1, #bosses - 1 do
                local nextIndex = (rotation.index + offset - 1) % #bosses + 1
                local candidate = bosses[nextIndex]
                local loaded = liveMobs(candidate.folderName, candidate.region)
                if #loaded > 0 then
                    stopLock()
                    rotation.index = nextIndex
                    rotation.target = nil
                    rotation.arrivedAt = os.clock()
                    boss, available = candidate, loaded
                    break
                end
            end
        end
        if #available > 0 then
            rotation.arrivedAt = os.clock()
        elseif os.clock() - rotation.arrivedAt >= 10 then
            stopLock()
            rotation.index = rotation.index % #bosses + 1
            rotation.target = nil
            rotation.arrivedAt = os.clock()
            STATE.farmStatus = "Boss absent: " .. boss.name .. "; moving to next"
            return
        end
    end
    STATE.targetIsBoss = true
    farmTick(boss)
    if STATE.bossRotation then
        STATE.bossRotation.target = STATE.target or STATE.bossRotation.target
        STATE.farmStatus = ("Boss %d/%d: %s | %s"):format(STATE.bossRotation.index, STATE.bossRotation.count, boss.name, STATE.farmStatus)
    end
end

