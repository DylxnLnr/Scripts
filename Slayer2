function STATE.webhook.send(build)
    local report = STATE.webhook
    if report.busy then return false, "Report already sending" end
    if os.clock() < report.retryAt then return false, report.status end
    if not CFG.webhookEnabled or (CFG.webhookUrl or "") == "" then
        report.setStatus("Enable webhook and set its URL first")
        return false, report.status
    end
    report.busy = true
    report.setStatus("Sending report")
    local worked, sent, status, code = pcall(function() return httpPost(CFG.webhookUrl, (build or report.payload)()) end)
    report.busy = false
    if worked and sent then report.sent = report.sent + 1 else report.failed = report.failed + 1 end
    report.retryAt = math.max(report.retryAt, os.clock() + 5)
    report.setStatus(worked and status or "Report failed to build; delivery unconfirmed")
    return worked and sent == true, report.status, code
end
function sendReport()
    return STATE.webhook.send()
end
function STATE.webhook.mentions(body, ping)
    body.allowed_mentions = { parse = {} }
    if not ping or not CFG.webhookPing then return end
    local mention = tostring(CFG.webhookMention or ""):match("^%s*(.-)%s*$")
    local user = mention:match("^<@!?(%d+)>$")
    local role = mention:match("^<@&(%d+)>$")
    if user then body.allowed_mentions.users = { user }
    elseif role then body.allowed_mentions.roles = { role }
    elseif mention == "@everyone" or mention == "@here" then body.allowed_mentions.parse = { "everyone" }
    else return end
    body.content = mention
end
function STATE.webhook.flush()
    local report = STATE.webhook
    if report.busy or os.clock() < report.retryAt or not CFG.webhookEnabled then return end
    local enabled = { Purchase = CFG.webhookOnBuy, Rare = CFG.webhookOnRare, Progress = CFG.webhookOnProgress, Chests = CFG.webhookOnChests, Death = CFG.webhookOnDeaths }
    for index = #report.queue, 1, -1 do
        local event = report.queue[index]
        if event.url ~= CFG.webhookUrl or not enabled[event.kind] then table.remove(report.queue, index) end
    end
    if #report.queue == 0 then return end
    local batch = {}
    for index = 1, math.min(3, #report.queue) do batch[#batch + 1] = report.queue[index] end
    local sent, _, code = report.send(function()
        local body = { username = "Pkaizen Ouwland", embeds = {} }
        local ping = false
        for _, event in ipairs(batch) do
            body.embeds[#body.embeds + 1] = { title = event.title, description = event.description,
                color = event.kind == "Death" and 0xD9534F or event.kind == "Rare" and 0xE2B714 or 0x39A878,
                timestamp = event.timestamp, footer = { text = "Pkaizen Ouwland | " .. LP.Name } }
            ping = ping or event.ping
        end
        report.mentions(body, ping)
        return body
    end)
    for _, event in ipairs(batch) do
        event.attempts = event.attempts + 1
        if sent or code ~= 429 or event.attempts >= 3 then
            local index = table.find(report.queue, event)
            if index then table.remove(report.queue, index) end
            if not sent then report.dropped = report.dropped + 1 end
        end
    end
    report.setStatus(report.status)
end
function STATE.webhook.tick()
    local report = STATE.webhook
    if not CFG.webhookEnabled or CFG.webhookUrl == "" then report.previous = nil; table.clear(report.queue); return end
    local data = getData()
    local inventory = invFolder()
    if not data or not inventory then return end
    local current = { data = data, url = CFG.webhookUrl, level = getLevel(), deaths = STATE.deaths,
        chests = LOOT.opened, counts = {}, stage = nil }
    local ok, progress = pcall(CRAFT.slayer.progress)
    if ok and progress then current.stage = progress.level end
    for _, item in ipairs(inventory:GetChildren()) do
        current.counts[item.Name] = (current.counts[item.Name] or 0) + math.max(0, tonumber(val(item, "Amount", 1)) or 0)
    end
    local previous = report.previous
    report.previous = current
    if previous and previous.data == data and previous.url == CFG.webhookUrl then
        if CFG.webhookOnRare then
            local gains = {}
            for name, count in pairs(current.counts) do
                local rarity = Items and Items[name] and tonumber(Items[name].Rarity)
                if rarity and rarity >= (tonumber(CFG.webhookRareMin) or 5) and count > (previous.counts[name] or 0) then
                    gains[#gains + 1] = { name = name, rank = rarity, gain = count - (previous.counts[name] or 0), count = count }
                end
            end
            table.sort(gains, function(first, second) return first.rank > second.rank or first.rank == second.rank and first.name < second.name end)
            for _, gain in ipairs(gains) do
                report.enqueue("Rare item acquired | rank " .. gain.rank, ("**%s**\n+%d | %d owned"):format(gain.name, gain.gain, gain.count), "Rare", gain.rank >= (tonumber(CFG.webhookPingMin) or 6))
            end
        end
        if CFG.webhookOnProgress then
            if current.level > previous.level then report.enqueue("Level up", ("Level **%d -> %d**"):format(previous.level, current.level), "Progress", false) end
            if current.stage and previous.stage and current.stage > previous.stage then report.enqueue("Slayer stage reached", ("Stage **%d -> %d**"):format(previous.stage, current.stage), "Progress", true) end
        end
        if CFG.webhookOnChests and current.chests > previous.chests then report.enqueue("Chest opening confirmed", ("+%d | %d this session\n%s"):format(current.chests - previous.chests, current.chests, LOOT.chestStatus or LOOT.status), "Chests", false) end
        if CFG.webhookOnDeaths and current.deaths > previous.deaths then report.enqueue("Character died", ("%d deaths this session\n%s"):format(current.deaths, STATE.farmStatus or ""), "Death", true) end
    end
    if not report.busy and #report.queue > 0 and os.clock() >= report.retryAt then task.spawn(report.flush) end
end

