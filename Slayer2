    end
    if catch then
        if FISH.pendingCatch ~= catch then
            FISH.pendingCatch, FISH.catchSince, FISH.nextCollect = catch, os.clock(), 0
            FISH.prizes = (FISH.prizes or 0) + 1
        end
        if os.clock() - FISH.catchSince >= 18 then
