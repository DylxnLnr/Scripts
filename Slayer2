-- Hardcoded dock coordinates. The previous runtime discovery (ring search around the NPC + "SwimParts" raycasts)
-- picked the wrong tile: the bot teleported to the dock every tick and never cast. Keep it simple and stable:
-- the known-good stand/cast, with only a straight-down floor check to correct the height.
function FISH.resolveSpot()
    local fb = FISH_SPOTS[CFG.fishSpot] or FISH_SPOTS["Mistfall Harbor dock (Jeso)"]
    if FISH.spotCache and os.clock() - FISH.spotCache.t < 5 then return FISH.spotCache.stand, FISH.spotCache.cast end
    local stand = fb.stand
    local hrp, hum = getHRP(), getHum()
    if hrp and hum then
        local ex = { getChar() }
        for _, n in ipairs({ "Debree", "Humanoids" }) do
            local folder = workspace:FindFirstChild(n)
            if folder then ex[#ex + 1] = folder end
        end
        local gp = RaycastParams.new()
        gp.FilterType = Enum.RaycastFilterType.Exclude
        gp.FilterDescendantsInstances = ex
        gp.RespectCanCollide = true
        local height = hum.HipHeight + hrp.Size.Y / 2 + 0.15
        local hit = workspace:Raycast(fb.stand + Vector3.new(0, 18, 0), Vector3.new(0, -52, 0), gp)
        if hit and hit.Normal.Y >= 0.8 and math.abs(hit.Position.Y - fb.stand.Y) < 12 then
            stand = hit.Position + Vector3.new(0, height, 0)
        end
    end
    FISH.spotCache = { t = os.clock(), stand = stand, cast = fb.cast }
    return stand, fb.cast
end
