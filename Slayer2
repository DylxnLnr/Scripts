function fsBuy(item)
    if item ~= "Bandage" or not CFG.fsAllowBandage then fsrLog("Bandage needed: authorize the 25 Wen purchase in Final Selection"); return end
    if invAmount(item) > 0 then return end
    if FSR.bandageAttempted then fsrLog("Bandage purchase already attempted; check inventory before retrying manually"); return end
    if os.clock() - FSR.lastBuy < 6 then return end
    FSR.lastBuy = os.clock()
    local quoted, price = pcall(function()
        return asGame(function()
            local listing = Shop and Shop.itemsforsale[item]
            if not listing or type(listing.Price) ~= "table" then return nil end
            for currency in pairs(listing.Price) do if currency ~= "Wen" then return nil end end
            local totals = Shop.GetCartTotals({ [item] = 1 }, LP)
            return totals and totals.Wen
        end)
    end)
    if not quoted or type(price) ~= "number" or not (price >= 0 and price <= 25) then fsrLog("Bandage blocked: price not verified within 25 Wen"); return end
    if getWen() < price then fsrLog("Bandage needs " .. price .. " Wen"); return end
    local rika = DB.npcs["Rika"]
    if not rika then fsrLog("Bandage: Rika is unavailable"); return end
    stopLock(); tpPos(rika.pos, 3); if not FSR.wait(1.2) then return end
    if _stopped or not CFG.autoFinalSelection or not CFG.fsAllowBandage then return end
    FSR.bandageAttempted = true
    CFG.fsAllowBandage = false
    local before = invAmount(item)
    pcall(function() return asGame(function() return SF.ToServer("PurchaseFromShop", item, 1) end) end)
    local deadline = os.clock() + 3
    repeat
        if invAmount(item) > before then fsrLog("Bandage purchase confirmed"); return end
        if not FSR.wait(0.1) then return end
    until os.clock() >= deadline
    fsrLog("Bandage purchase unconfirmed; automatic retry disabled")
end
function skipDialogue()
    local holder = LP:FindFirstChild("PlayerGui") and LP.PlayerGui:FindFirstChild("ComponentsHolder")
    local df = holder and holder:FindFirstChild("DialogueFrame")
    if not df then return false end
    local selected, advance
    for _, b in ipairs(df:GetDescendants()) do
        if b:IsA("GuiButton") and b.Visible then
            local visible, parent = true, b.Parent
            while parent and parent ~= holder do
                if parent:IsA("GuiObject") and not parent.Visible then visible = false; break end
                parent = parent.Parent
            end
            if not visible then continue end
            if b.Name == "ClickDetector" then advance = b; continue end
            local txt = b:IsA("TextButton") and b.Text or ""
            for _, label in ipairs(b:GetDescendants()) do if label:IsA("TextLabel") then txt = txt .. label.Text end end
            txt = txt:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
            if txt == "Locate Rem" then
                if (FSR.stage or 1) <= 1 and not fsActiveQuest() and canAddQuest("Locate Rem") then selected = b end
            elseif txt == "Close" or txt == "Cancel" then
                selected = selected or b
            end
        end
    end
    selected = selected or advance
    if not selected then return false end
    if typeof(getconnections) == "function" then
        local connections = getconnections(selected.MouseButton1Click)
        if #connections == 0 then connections = getconnections(selected.Activated) end
        for _, connection in ipairs(connections) do pcall(function() connection:Fire() end) end
        return #connections > 0
    elseif typeof(firesignal) == "function" then
        return pcall(firesignal, selected.MouseButton1Click)
    end
    return false
end
function fsRunTick()
    if _stopped or not CFG.autoFinalSelection then return end
    if LP:GetAttribute("TrialEnding") == true or questState("Defeat the Hand Demon") == "Done" then
        stopLock()
        COMBAT.zoneCenter = nil
        if os.clock() - (FSR.lastSkip or 0) > 0.7 then FSR.lastSkip = os.clock(); skipDialogue() end
        STATE.farmStatus = LP:GetAttribute("FinalSelectionClosingDone") == true
            and "FS: completed - waiting for server return"
            or "FS: boss completed - loot / closing dialogue"
        return
    end
    local qn, q = fsActiveQuest()
    if os.clock() - (FSR.lastSkip or 0) > 0.7 then FSR.lastSkip = os.clock(); skipDialogue() end
    if qn ~= "Rescue and Hold the Zone" then COMBAT.zoneCenter = nil end
    if not qn then
        for index = #FS_CHAIN, 1, -1 do
            if questState(FS_CHAIN[index]) == "Done" then
                FSR.stage = math.max(FSR.stage or 1, index + 1)
                break
            end
        end
        for index = FSR.stage or 1, #FS_CHAIN do
            local name = FS_CHAIN[index]
            if questState(name) ~= "Done" then
                if os.clock() - FSR.lastAccept > 8 then
                    FSR.lastAccept = os.clock()
                    local def = DB.quests[name]
                    if not def or not canAddQuest(name) then fsrLog("Waiting for server quest transition: " .. name); return end
                    local pos = def and (typeof(def.Position) == "Vector3" and def.Position) or (DB.npcs["Rem"] and DB.npcs["Rem"].pos)
                    stopLock()
                    if pos then tpPos(pos, 3); if not FSR.wait(0.9) then return end end
                    if _stopped or not CFG.autoFinalSelection then return end
                    toServer("AddQuest", name)
                    fsrLog("Requesting quest " .. name)
                end
                return
            end
        end
        STATE.farmStatus = "FS: every trial quest is done - wait for the ending"
        return
    end
    local prog = questTaskProgress(qn) or {}
    STATE.farmStatus = "FS: " .. qn
    -- kill task first (Lesser Demons / Lost / Hand Demon): pickups like the submerged key only count once the boss is dead
    if q._mobCode and q._killTask then
        local kt = prog[q._killTask]
        local mob = mobByCode(q._mobCode)
        if mob and kt and kt.value < kt.max then
            STATE.targetIsBoss = mob.boss == true
            farmTick(mob)
            if not STATE.farmStatus:find("^Fighting") and not STATE.farmStatus:find("^Retreat") and not STATE.farmStatus:find("^Drinking") then
                STATE.farmStatus = ("FS: %s %d/%d - %s"):format(q._killTask, kt.value, kt.max, STATE.farmStatus)
            end
            return
        end
    end
    STATE.targetIsBoss = false
    -- special mechanics first
    for tn, p in pairs(prog) do
        if p.value < p.max then
            local spec = q.TaskSpecs and q.TaskSpecs[tn]
            if tn == "Checkpoints" or tn == "Speak with Levi" then return fsMountain(qn, prog) end
            if tn == "Capture the Zone" or tn == "Rescue the Civilian" or (tn == "Return to Levi" and qn == "Rescue and Hold the Zone") then return fsZone(qn, prog) end
            if spec and spec.Type == "Dungeon" then return fsDungeon(qn, tn) end
        end
    end
    -- pickups
    for tn, p in pairs(prog) do
        local spec = q.TaskSpecs and q.TaskSpecs[tn]
        if spec and spec.Type == "Pickup" and p.value < p.max and os.clock() - FSR.lastPickup > 3 then
            FSR.lastPickup = os.clock()
            stopLock()
            for i, pos in ipairs(spec.Positions or {}) do
                if typeof(pos) == "Vector3" then
                    if _stopped or not CFG.autoFinalSelection then return end
                    tpPos(pos, 2); if not FSR.wait(0.7) then return end
                    toServer("QuestProgress", qn, tn, i); if not FSR.wait(0.6) then return end
                end
            end
            fsrLog(FSR.confirm(qn, tn, p.value) and ("Pickup confirmed: " .. tn) or ("Waiting for pickup confirmation: " .. tn))
            return
        end
    end
    -- deliveries (Find X / Return to X / Treat Klien)
    for tn, p in pairs(prog) do
        local spec = q.TaskSpecs and q.TaskSpecs[tn]
        if spec and spec.Type == "Deliver" and p.value < p.max then
            if spec.RequiredItem and invAmount(spec.RequiredItem) < (spec.Count or 1) then return fsBuy(spec.RequiredItem) end
            local npc = DB.npcs[spec.TargetNpc]
            if npc and os.clock() - FSR.lastDeliver > 4 then
                FSR.lastDeliver = os.clock()
                stopLock(); tpPos(npc.pos, 3); if not FSR.wait(0.9) then return end
                toServer("QuestProgress", qn, tn)
                fsrLog(FSR.confirm(qn, tn, p.value) and ("Delivery confirmed: " .. tn) or ("Waiting for delivery confirmation: " .. tn))
            end
            return
        end
    end
    -- leftover tasks without spec (e.g. kill task whose mob is not streamed): go to the marker
    for tn, p in pairs(prog) do
        if p.value < p.max then
            local mk = q.Markers and q.Markers[tn] and q.Markers[tn].Position
            if typeof(mk) == "Vector3" then
                local hostile = fsHostileNear(mk, 80)
                if hostile then fsAttackModel(hostile) return end
                local hrp = getHRP()
                if hrp and (hrp.Position - mk).Magnitude > 25 then stopLock(); tpPos(mk, 8) end
                STATE.farmStatus = "FS: waiting at " .. tn
                return
            end
        end
    end
end

