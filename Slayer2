    local function punchReplica()
        local client = getCombatDo()
        if client and type(client.Do) == "function" then
            local style = equippedStyle()
            if not style then return nil end
            local preset = CombatPresets and CombatPresets.Presets and CombatPresets.Presets[style]
            if not preset then return nil end
            local max = preset.Max or 5
            local gap = preset.default or 0.25
            if _lastComboval >= max and _combo < max then gap = preset.final or gap end
            local remaining = os.clock() - _lastSwing
            if remaining < gap then return false, gap - remaining end
            if Checker then
                local okC, can = pcall(function() return asGame(function() return Checker.check(LP, "combat") end) end)
                if okC and can ~= true then return false, 0.08 end
            end
            if not _comboValue then
                _comboValue = Instance.new("IntValue")
                _comboValue.Name = "ComboValue"
                _comboValue.Value = 1
            end
            _comboValue.Value = _combo
            local ok = pcall(function()
                asGame(function()
                    client.Do(_comboValue, preset, style, nil)
                end)
            end)
            if not ok then return nil end
            _lastComboval = _combo
            _lastSwing = os.clock()
            _combo = _combo + 1
            if _combo > max then _combo = 1 end
            return true, math.max(0, gap)
        end
        local style = equippedStyle()
        local preset = CombatPresets and CombatPresets.Presets and CombatPresets.Presets[style]
        local gap = (preset and (preset.default or 0.25)) or 0.25
        if os.clock() - _lastSwing < gap then return false end
        local max = (preset and preset.Max) or 5
        toServer("Combat_Service", style, _combo, false, 0.1, false, nil)
        _lastSwing = os.clock()
        _combo = _combo + 1
        if _combo > max then _combo = 1 end
        return true
    end
    swing = function()
        if not ensureEquipped() then return false end
        local env = getCombatEnv()
        if env and type(env.punch) == "function" then
            local values = getValues()
            local tracker = values and values:FindFirstChild("ComboTrackerClient")
            local stamp = tracker and tracker:FindFirstChild("Time")
            local before = stamp and stamp.Value
            local ok, cd = pcall(function() return asGame(env.punch) end)
            tracker = values and values:FindFirstChild("ComboTrackerClient")
            stamp = tracker and tracker:FindFirstChild("Time")
            local executed = ok and stamp ~= nil and stamp.Value ~= before
            if executed then return true, ok and type(cd) == "number" and math.max(0, cd) or 0.08 end
            if not ok then return false, 0.08 end
            local rep = punchReplica()
            if rep then return rep end
            return false, type(cd) == "number" and math.max(0, cd) or 0.08
        end
        return punchReplica()
    end
end

-- Skills available to the player (breathing / demon art / fighting style / clan), with cooldown info.
function mySkills()
    local d = getData()
    local out = {}
    local seen = {}
    local function addFrom(tbl, cat)
        if type(tbl) ~= "table" or type(tbl.Skills) ~= "table" then return end
        for _, s in ipairs(tbl.Skills) do
            if s.Name and not seen[s.Name] and s.Name ~= "Blocking" and (s.Key or cat == "clan") then
                seen[s.Name] = true
                out[#out + 1] = { name = s.Name, cd = s.CoolDown or 10, stamina = s.Stamina or 0, hold = s.Max_Hold, cat = cat }
            end
        end
    end
    local br = val(d, "Powers.Breathing", "")
    local da = val(d, "Powers.DemonArt", "")
    local fs = val(d, "Powers.FightingStyle", "")
    if Breathings and br ~= "" then addFrom(Breathings[br], "power") end
    if DemonArts and da ~= "" then addFrom(DemonArts[da], "power") end
    if FightingStyles and fs ~= "" then addFrom(FightingStyles[fs], "power") end
    local clan = val(d, "Clan", "")
    if ClanSkills and clan ~= "" then
        pcall(function() addFrom({ Skills = asGame(function() return ClanSkills.SkillsFor(clan, LP) end) }, "clan") end)
    end
    local filtered = {}
    for _, s in ipairs(out) do
        local ok, unlocked = pcall(function() return asGame(function() return SkillStats.IsSkillUnlocked(LP, s.name) end) end)
        if ok and unlocked == true then filtered[#filtered + 1] = s end
    end
    return filtered
end
