        FISH.seenLine = line
        if FISH.castPending then FISH.casts = FISH.casts + 1 end
        FISH.castPending, FISH.castFailures = nil, 0
        FISH.castT = os.clock()
    elseif catch and FISH.castPending then
        FISH.casts = FISH.casts + 1
        FISH.castPending, FISH.castFailures = nil, 0
    elseif not line and FISH.castPending then
        if os.clock() - FISH.castPending < 6 then FISH.status = "Waiting for the cast to appear"; return end
