function httpPost(url, body)
    if not url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+$")
        and not url:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%-]+$") then
        return false, "Invalid Discord webhook URL (use the copied webhook URL)"
    end
    local fn = (typeof(request) == "function" and request) or (typeof(http_request) == "function" and http_request)
        or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request) or (krnl and krnl.request)
    if not fn then return false, "Executor HTTP unavailable" end
    local ok, response = pcall(function()
        return fn({ Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(body) })
    end)
    if not ok then return false, "Network error; delivery unconfirmed" end
    local status = type(response) == "table" and tonumber(response.StatusCode or response.Status)
    if not status then return false, "HTTP status missing; delivery unconfirmed" end
    if status >= 200 and status < 300 then return true, "Discord accepted report (HTTP " .. status .. ")" end
    if status == 429 then
        local decoded, data = pcall(function() return HttpService:JSONDecode(response.Body or "") end)
        local delay = decoded and type(data) == "table" and tonumber(data.retry_after) or nil
        for key, value in pairs(type(response.Headers) == "table" and response.Headers or {}) do
            if tostring(key):lower() == "retry-after" then delay = math.max(delay or 0, tonumber(value) or 0) end
        end
        if not delay or delay ~= delay or delay < 0 or delay == math.huge then delay = 60 end
        delay = math.max(1, delay)
        STATE.webhook.retryAt = os.clock() + delay
        return false, "Discord rate limited; wait " .. math.ceil(delay) .. "s", 429
    end
    return false, "Discord rejected report (HTTP " .. status .. ")"
end
function STATE.webhook.payload()
    local exp, goal = getExp()
    local elapsed = math.max(1, os.clock() - STATE.startTime)
    local expGain = exp - (STATE.startExp or exp)
    local fields = {}
    local function field(name, value, inline)
        local text = tostring(value or "Unavailable")
        if #text > 350 then text = text:sub(1, utf8.offset(text, 0, 348) - 1) .. "..." end
        fields[#fields + 1] = { name = name, value = text ~= "" and text or "None", inline = inline == true }
    end
    local hum = getHum()
    field("Character", ("Level %d | %s\nXP %d / %d\nHP %s"):format(getLevel(), getRace(), exp, goal, hum and ("%.0f / %.0f"):format(hum.Health, hum.MaxHealth) or "Unavailable"), true)
    field("Resources", ("%d Wen\n%d skill points"):format(getWen(), getSkillPoints()), true)
    field("Session", ("%02d:%02d:%02d elapsed\n%d kills | %d deaths | %d quests"):format(math.floor(elapsed / 3600), math.floor(elapsed % 3600 / 60), math.floor(elapsed % 60), STATE.kills, STATE.deaths, STATE.questsDone or 0), true)
    field("Session balance", ("%+d XP snapshot delta | %.0f/min\n%+d Wen net | %.0f Wen/min (includes purchases)"):format(expGain, expGain / (elapsed / 60), getWen() - (STATE.startWen or getWen()), (getWen() - (STATE.startWen or getWen())) / (elapsed / 60)))
    local activities = {}
