                searchBox.ClearTextOnFocus = false; searchBox.Font = Enum.Font.Gotham; searchBox.TextSize = 12
                searchBox.TextColor3 = C.text; searchBox.PlaceholderColor3 = C.muted
            end
            local listOffset = searchBox and 64 or 34
            local listF = Instance.new("ScrollingFrame", dd)
            listF.LayoutOrder = 2
            listF.Size = UDim2.new(1, 0, 1, -listOffset); listF.Position = UDim2.new(0, 0, 0, listOffset)
            listF.BackgroundTransparency = 1; listF.BorderSizePixel = 0
            listF.ScrollBarThickness = 2; listF.ScrollBarImageColor3 = C.accent
            listF.CanvasSize = UDim2.new(0, 0, 0, 0); listF.AutomaticCanvasSize = Enum.AutomaticSize.Y
            layout(listF, 2); pad(listF, 4, 4, 4, 4)
            local open = false
            local function buildList(filtered)
                for _, c in pairs(listF:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                filtered = filtered or list
                for _, val in ipairs(filtered) do
                    local item = Instance.new("TextButton", listF)
                    item.Size = UDim2.new(1, 0, 0, 36); item.BackgroundColor3 = C.input
                    item.Text = ""; item.AutoButtonColor = false; item.BorderSizePixel = 0; corner(item, 6)
