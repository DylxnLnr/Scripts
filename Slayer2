        uiRefs.skillsRefresh = function()
            local data = getData()
            local unlockedList = data and data:FindFirstChild("SkillTreeUnlockedList")
            local currentNodes = skillNodes()
            table.clear(names)
            for _, node in ipairs(currentNodes) do
                names[#names + 1] = node.name
                local branch = node.branch or "Other skills"
                if not branchSetters[branch] then
                    local section = pgSkills:addCollapse(branch)
                    local _, setter = section:addLabel("")
