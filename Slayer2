function CRAFT.refine.check(row, data)
    local refinement = CRAFT.refinement
    local goal = math.clamp(math.floor(tonumber(CFG.refineTargetLevel) or 0), 0, refinement.MaxLevel)
    if goal > 0 and row.level >= goal then return nil, ("Target +%d reached"):format(goal) end
    local rung = refinement.GetRung(row.level, CFG.refineUseGuard == true)
    if not rung then return nil, "Maximum refinement reached" end
    local costs = refinement.ResolveOreCost(data, rung)
    for name, need in pairs(costs) do
        local held = refinement.GetHeldCount(data, name)
        if held < need then return nil, ("Missing %s (%d / %d)"):format(name, held, need) end
    end
    if getWen() < rung.Wen then return nil, ("Missing Wen (%d / %d)"):format(getWen(), rung.Wen) end
    if CFG.refineUseGuard and refinement.GetHeldCount(data, refinement.GuardItem) < 1 then return nil, "No " .. refinement.GuardItem .. " owned" end
    return rung
end
function CRAFT.refine.run(maxAttempts)
    local manager = CRAFT.refine
    if manager.busy then return false, "Refinement already running" end
    if not (SF and CRAFT.refinement) then return false, "Refinement module unavailable" end
    if not CRAFT.refineTarget() then return false, "Select equipment in the refinement planner first" end
    local npc = DB.npcs[manager.npc]
    if not npc then return false, manager.npc .. " missing from world database" end
    manager.busy = true; manager.cancel = false
    task.spawn(function()
        local ok, err = pcall(function()
            local data = getData()
            for attempt = 1, maxAttempts do
                if manager.cancel or _stopped then manager.status = "Refinement cancelled"; return end
                local row = CRAFT.refineTarget()
                if not row or getData() ~= data then manager.status = "Target equipment unavailable"; return end
                local rung, why = manager.check(row, data)
                if not rung then manager.status = why; return end
                local root = getHRP()
                if not root or not alive() then manager.status = "Waiting for character"; return end
                if (root.Position - npc.pos).Magnitude > 8 then
                    stopLock()
                    manager.status = "Travelling to " .. manager.npc
                    tpPos(npc.pos, 3)
                    task.wait(0.8)
                    root = getHRP()
                    if not root or (root.Position - npc.pos).Magnitude > 12 then manager.status = "Could not reach " .. manager.npc; return end
                end
                local before = row.level
                manager.attempts = manager.attempts + 1
                manager.status = ("Attempt %d: %s +%d (%.1f%% success)"):format(attempt, row.name, before, rung.SuccessBp / 100 + rung.GreatBp / 100)
                local sent, result = pcall(function()
                    return asGame(function()
                        return SF.ToServer("RefinementRequest", { action = "Attempt", Id = row.id, UseGuard = CFG.refineUseGuard == true })
                    end)
                end)
                if not sent or type(result) ~= "table" then manager.status = "No server response; stopped for safety"; return end
                if result.Ok ~= true then manager.status = "Refused: " .. tostring(result.Reason or "unknown"); return end
                local deadline, after = os.clock() + 3, nil
                repeat
                    task.wait(0.1)
                    local now = CRAFT.refineTarget()
                    after = now and now.level
                until os.clock() >= deadline or (after and after ~= before)
                after = after or before
                if after > before then manager.successes = manager.successes + 1
                elseif result.GuardSaved ~= true then manager.failures = manager.failures + 1 end
                manager.status = ("%s%s: +%d -> +%d"):format(tostring(result.Outcome or "Result"), result.GuardSaved == true and " (guarded)" or "", before, after)
                STATE.webhook.record(("Refined %s: %s +%d -> +%d"):format(row.name, tostring(result.Outcome or "?"), before, after), "Market")
                task.wait(1.2)
            end
            if maxAttempts > 1 then manager.status = "Attempt limit reached: " .. manager.status end
        end)
        manager.busy = false
        if not ok then manager.status = "Refinement error: " .. tostring(err) end
        notify("Refinement", manager.status)
    end)
    return true
end
