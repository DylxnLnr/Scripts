function CRAFT.gear.snapshot()
    return asGame(function()
        local manager, data = CRAFT.gear, getData()
        local inventory = data and data:FindFirstChild("Inventory")
        local items = inventory and inventory:FindFirstChild("Inventory")
        local accessories = inventory and inventory:FindFirstChild("Accessories")
        local stats = accessories and accessories:FindFirstChild("Stats")
        if not (items and stats and manager.series and manager.requirements and manager.types) then return nil end
        local current, entries, candidates = {}, {}, {}
        for _, slot in ipairs(manager.slots) do
            if not stats:FindFirstChild(slot) then return nil end
            current[slot] = val(stats, slot, 0)
        end
        for _, item in ipairs(items:GetChildren()) do
            local id, definition = tonumber(val(item, "Id", 0)), Items and Items[item.Name]
            if id and id > 0 and definition and type(definition.Stats) == "table"
                and (definition.EquipType == 3 or definition.EquipType == 5) then
                local amount = definition.Stats[CFG.gearStat]
                local score = amount == true and 1 or type(amount) == "number" and amount or 0
                local health = tonumber(definition.Stats["Max Health"]) or 0
                if manager.series.SetOf(item.Name) ~= nil then
                    local multiplier = manager.series.Multiplier(item)
                    if type(amount) == "number" then score = score * multiplier end
                    health = health * multiplier
                end
                local equipped = false
                for _, equippedId in pairs(current) do if equippedId == id then equipped = true; break end end
                local entry = { id = id, name = item.Name, score = score, health = health, equipped = equipped, item = item }
                entries[id] = entry
                if score > 0 and score < math.huge and not item:FindFirstChild("NoSave") and not item:FindFirstChild("QuestGrant")
                    and manager.requirements.Passes(data, definition.Requirements) then candidates[#candidates + 1] = entry end
            end
        end
        return { data = data, folder = stats, current = current, entries = entries, candidates = candidates,
            highest = manager.types.HighestOnlyStats[CFG.gearStat] == true
                or (candidates[1] and type(Items[candidates[1].name].Stats[CFG.gearStat]) == "boolean") or false }
    end)
end
function CRAFT.gear.plan(snapshot)
    local manager = CRAFT.gear
    table.sort(snapshot.candidates, function(first, second)
        if first.score ~= second.score then return first.score > second.score end
        if first.equipped ~= second.equipped then return first.equipped end
        return first.id < second.id
    end)
    local selected, names, ordered = {}, {}, {}
    for _, entry in ipairs(snapshot.candidates) do
        if not names[entry.name] then
            selected[entry.id] = true; names[entry.name] = true; ordered[#ordered + 1] = entry
            if #ordered >= (snapshot.highest and 1 or #manager.slots) then break end
        end
    end
    local desired, changes = {}, {}
    for _, slot in ipairs(manager.slots) do desired[slot] = snapshot.current[slot] end
    for _, entry in ipairs(ordered) do
        local already, replacement
        for _, slot in ipairs(manager.slots) do
            local existing = snapshot.entries[desired[slot]]
            if desired[slot] == entry.id then already = true; break end
            if existing and existing.name == entry.name then replacement = slot end
        end
        if not already then
            if not replacement then
                for _, slot in ipairs(manager.slots) do
                    if not selected[desired[slot]] then
                        local existing = snapshot.entries[desired[slot]]
                        local previous = replacement and snapshot.entries[desired[replacement]]
                        local score, oldScore = existing and existing.score or 0, previous and previous.score or 0
                        if not replacement or desired[slot] == 0 or (desired[replacement] ~= 0
                            and (score < oldScore or score == oldScore and (existing and existing.health or 0) < (previous and previous.health or 0))) then replacement = slot end
                        if desired[slot] == 0 then break end
                    end
                end
            end
            if replacement then
                changes[#changes + 1] = { slot = replacement, id = entry.id, previous = snapshot.current[replacement], name = entry.name }
                desired[replacement] = entry.id
            end
        end
    end
    local function total(loadout)
        local amount = 0
        for _, id in pairs(loadout) do
            local entry = snapshot.entries[id]
            if entry then amount = snapshot.highest and math.max(amount, entry.score) or amount + entry.score end
        end
        return amount
    end
    local before, after = total(snapshot.current), total(desired)
    if after <= before then return {}, before, before end
    return changes, before, after
end
function CRAFT.gear.describe()
    local ok, snapshot = pcall(CRAFT.gear.snapshot)
    if not ok or not snapshot then return "Equipment data unavailable" end
    local changes, before, after = CRAFT.gear.plan(snapshot)
    local lines = { "Priority: " .. tostring(CFG.gearStat), CRAFT.gear.status,
        ("Accessory bonus: %g -> %g"):format(before, after) }
    for _, slot in ipairs(CRAFT.gear.slots) do
        local entry = snapshot.entries[snapshot.current[slot]]
        lines[#lines + 1] = slot .. ": " .. (entry and entry.name or snapshot.current[slot] == 0 and "Empty" or "Unknown item")
    end
    for _, change in ipairs(changes) do lines[#lines + 1] = "Upgrade " .. change.slot .. ": " .. change.name end
    if #changes == 0 then lines[#lines + 1] = "No eligible improvement for this stat" end
    return table.concat(lines, "\n")
end
