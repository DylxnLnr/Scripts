        end
        if target then
            COMBAT.attackTick(target)
            manager.status = ("Floor %d | %s | %s"):format(floor, target.Name, COMBAT.mode or "approach")
        else manager.status = ("Floor %d: waiting for enemies (%s left)"):format(floor, tostring(workspace:GetAttribute("MinigameEnemiesLeft") or "?")) end
    else manager.status = phase == "unavailable" and "Ouwigahara unavailable in this place" or "Waiting for dungeon state" end
    STATE.farmStatus = "Dungeon: " .. manager.status
end
