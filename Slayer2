function STATE.dungeon.prompt(prompt, action)
    local manager, root = STATE.dungeon, getHRP()
    if not prompt or not prompt.Parent or not prompt.Enabled or not root or not alive() then return false end
    if typeof(fireproximityprompt) ~= "function" then manager.status = "Executor prompt support unavailable"; return false end
    local position = prompt.Parent:IsA("Attachment") and prompt.Parent.WorldPosition
        or prompt.Parent:IsA("BasePart") and prompt.Parent.Position
    if typeof(position) ~= "Vector3" then return false end
    if os.clock() < (manager.nextPrompt or 0) then return false end
    if (manager.attempts[action] or 0) >= 3 then manager.status = action .. " unconfirmed; pause and restart to retry"; return false end
    stopLock()
    root.CFrame = CFrame.new(position + Vector3.new(0, 2, 2))
    root.AssemblyLinearVelocity = Vector3.zero
    local epoch, character = STATE.activityEpoch, getChar()
    if not STATE.waitActivity(epoch, 0.25) or not CFG.autoDungeon or getChar() ~= character or not prompt.Parent then return false end
    if (root.Position - position).Magnitude > prompt.MaxActivationDistance then return false end
    if action == "Enter Ouwigahara" or action == "Leave Ouwigahara" then
        if not teleportConn or not teleportConn.prepare() then
            manager.status = "Teleport continuation could not be queued; staying here"
            return false
        end
    end
    manager.attempts[action] = (manager.attempts[action] or 0) + 1
    manager.nextPrompt = os.clock() + 8
    manager.status = action .. ": waiting for server"
    fireproximityprompt(prompt, prompt.HoldDuration)
    return true
end
