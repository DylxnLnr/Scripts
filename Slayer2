function CRAFT.report()
    local recipe = CRAFT.recipe()
    if not recipe then return "No crafting target", {} end
    local lines = { ("%s x%d | %s"):format(recipe.result, recipe.amount or 1, recipe.station or "Unknown station") }
    local rows, grouped = {}, {}
    for _, list in ipairs({ recipe.required or {}, recipe.additionalMaterials or {} }) do
        for _, item in ipairs(list) do
            local tier = CRAFT.module.RequiredTier(recipe, item.name)
            local key = item.name .. ":" .. tostring(tier)
            if not grouped[key] then
                grouped[key] = { name = item.name, tier = tier, need = 0 }
                rows[#rows + 1] = grouped[key]
            end
            grouped[key].need = grouped[key].need + (tonumber(item.amount) or 1)
        end
    end
    for _, name in ipairs(recipe.keep or {}) do rows[#rows + 1] = { name = name, need = 1, kept = true } end
    local missing = 0
    for _, row in ipairs(rows) do
        row.have = CRAFT.owned(row.name, row.tier)
        row.missing = math.max(0, row.need - row.have)
        missing = missing + row.missing
        lines[#lines + 1] = ("%s%s%s: %d / %d%s"):format(row.name,
            row.tier ~= nil and (" [tier " .. row.tier .. "]") or "", row.kept and " (kept)" or "",
            row.have, row.need, row.missing > 0 and (" | missing " .. row.missing) or " | ready")
    end
    local currencies = {}
    for name in pairs(recipe.price or {}) do currencies[#currencies + 1] = name end
    table.sort(currencies)
    for _, name in ipairs(currencies) do
        local needed = tonumber(recipe.price[name]) or 0
        local have = name == "Wen" and getWen() or nil
        if have == nil then
            lines[#lines + 1] = ("%s: %d required | balance not verified"):format(name, needed)
            missing = missing + 1
        else
            local shortage = math.max(0, needed - have)
            missing = missing + shortage
            lines[#lines + 1] = ("%s: %d / %d | missing %d"):format(name, have, needed, shortage)
        end
    end
    if recipe.refineKept ~= nil then lines[#lines + 1] = ("Refinement retained: %g%%"):format(recipe.refineKept * 100) end
    lines[#lines + 1] = missing == 0 and "Listed costs met; confirm eligibility at the blacksmith" or "Target incomplete"
    lines[#lines + 1] = CFG.craftProtect and "Target materials protected from selling" or "Target material protection off"
    return table.concat(lines, "\n"), rows
end
