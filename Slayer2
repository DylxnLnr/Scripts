            tl.BackgroundTransparency = 1; tl.Text = title; tl.TextColor3 = C.text
            tl.Font = Enum.Font.Gotham; tl.TextSize = 12; tl.TextXAlignment = Enum.TextXAlignment.Left
            local value = math.floor(default or min)
            local val = Instance.new("TextLabel", sld)
            val.Size = UDim2.new(0, 40, 0, 16); val.Position = UDim2.new(1, -50, 0, 6)
            val.BackgroundTransparency = 1; val.Text = tostring(value)
            val.TextColor3 = C.accent; val.Font = Enum.Font.GothamBold; val.TextSize = 12
            local bar = Instance.new("TextButton", sld)
            bar.Size = UDim2.new(1, -24, 0, 4); bar.Position = UDim2.new(0, 12, 0, 28)
            bar.BackgroundColor3 = C.input; bar.Text = ""; bar.BorderSizePixel = 0
            bar.AutoButtonColor = false; bar.Active = true; corner(bar, 2)
            local fill = Instance.new("Frame", bar)
            local pct = math.clamp((value - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(pct, 0, 1, 0); fill.BackgroundColor3 = C.accent
            fill.BorderSizePixel = 0; corner(fill, 2)
            local knob = Instance.new("Frame", bar)
            knob.Size = UDim2.new(0, 12, 0, 12); knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            knob.BackgroundColor3 = C.text; knob.BorderSizePixel = 0; corner(knob, 6)
            local dragging = false
            local function updateFromX(x)
                elevate()
                local p = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * p)
                local np = math.clamp((value - min) / (max - min), 0, 1)
                fill.Size = UDim2.new(np, 0, 1, 0)
                knob.Position = UDim2.new(np, 0, 0.5, 0)
                val.Text = tostring(value)
                if callback then callback(value) end
            end
            bar.MouseButton1Down:Connect(function()
                dragging = true; updateFromX(UserInput:GetMouseLocation().X)
            end)
            track(UserInput.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    updateFromX(i.Position.X)
                end
            end))
            track(UserInput.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end))
            local function setValue(v)
                elevate()
                value = math.clamp(math.floor(v), min, max)
                local np = math.clamp((value - min) / (max - min), 0, 1)
                fill.Size = UDim2.new(np, 0, 1, 0)
                knob.Position = UDim2.new(np, 0, 0.5, 0)
                val.Text = tostring(value)
            end
            return sld, setValue
        end

