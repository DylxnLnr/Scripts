-- Re-run the hub after a teleport (Final Selection / minigame place). The loader can provide the reload code in
-- getgenv().PKAIZEN_OUW_RELOAD; otherwise we fall back to a local file if the executor has one.
pcall(function()
    local q = (typeof(queue_on_teleport) == "function" and queue_on_teleport) or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if not q then return end
    local env = (typeof(getgenv) == "function" and getgenv()) or _G
    local code = type(env.PKAIZEN_OUW_RELOAD) == "string" and env.PKAIZEN_OUW_RELOAD or nil
    if not code and typeof(isfile) == "function" then
        for _, f in ipairs({ "Pkaizen-Ouwland.lua", "ouw_test.lua" }) do
            if isfile(f) then code = ('task.wait(6) loadstring(readfile("%s"))()'):format(f) break end
        end
    end
    if code then
        teleportConn = { queued = false }
        function teleportConn:Disconnect()
            if self.connection then self.connection:Disconnect() end
        end
        function teleportConn.prepare()
            if _stopped or not (CFG.autoFinalSelection or CFG.autoDungeon) then return false end
            if teleportConn.queued then return true end
            if CFG.autoDungeon then
                local hub = _G.PkaizenOuwland
                if not hub then return false end
                local resume = { cfg = CFG, dungeon = {}, slayer = {}, state = {} }
                for _, key in ipairs({ "runs", "picks", "bestFloor", "spent", "bought", "shopBlocked", "lastCard" }) do
                    resume.dungeon[key] = hub.state.dungeon[key]
                end
                for _, key in ipairs({ "spent", "bought", "used", "pointsGained" }) do resume.slayer[key] = hub.debug.slayer[key] end
                for _, key in ipairs({ "kills", "deaths", "questsDone", "startTime", "startExp", "startWen", "bossDeaths" }) do resume.state[key] = hub.state[key] end
                local payload = ("getgenv().PKAIZEN_OUW_RESUME_DUNGEON = game:GetService('HttpService'):JSONDecode(%q)\n"):format(HttpService:JSONEncode(resume))
                local ok, result = pcall(q, payload .. code)
                teleportConn.queued = ok and result ~= false
                hub.state.teleportError = not teleportConn.queued and tostring(result) or nil
                return teleportConn.queued
            end
            local resume = ("getgenv().PKAIZEN_OUW_RESUME_FS = { bandage = %s }\n"):format(tostring(CFG.fsAllowBandage == true))
            local ok, result = pcall(q, resume .. code)
            teleportConn.queued = ok and result ~= false
            return teleportConn.queued
        end
        teleportConn.connection = LP.OnTeleport:Connect(function(state)
            if state == Enum.TeleportState.Started then teleportConn.prepare() end
        end)
    end
end)


