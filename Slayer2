function CRAFT.refineReport()
    local target = CRAFT.refineTarget()
    local refinement = CRAFT.refinement
    if not target then return "No refinement target", {} end
    local lines = { ("%s #%d | +%d / +%d"):format(target.name, target.id, target.level, refinement.MaxLevel) }
    local rung = refinement.GetRung(target.level, false)
    if not rung then return lines[1] .. "\nMaximum refinement reached", {} end
    local data = getData()
    if not data then return "Character data unavailable", {} end
    local costs, converted = refinement.ResolveOreCost(data, rung)
    local names, protected = {}, {}
    for name in pairs(costs) do names[#names + 1] = name; protected[name] = true end
    protected[refinement.SmeltRate.To] = true
    table.sort(names)
    for _, name in ipairs(names) do
        local have = refinement.GetHeldCount(data, name)
        lines[#lines + 1] = ("%s: %d / %d | missing %d"):format(name, have, costs[name], math.max(0, costs[name] - have))
    end
    if converted > 0 then lines[#lines + 1] = ("Includes %d regular ore converted at %d:1"):format(converted, refinement.SmeltRate.FromCount) end
    lines[#lines + 1] = ("Wen: %d / %d | missing %d"):format(getWen(), rung.Wen, math.max(0, rung.Wen - getWen()))
    lines[#lines + 1] = ("Normal: %.2f%% | Great: %.2f%% | Failure: %.2f%%"):format(rung.SuccessBp / 100, rung.GreatBp / 100, rung.FailBp / 100)
    local nextLevel = math.min(refinement.MaxLevel, target.level + 1)
    local greatLevel = math.min(refinement.MaxLevel, target.level + refinement.GreatStep)
    for _, stat in ipairs(refinement.GetRefineStats(target.name)) do
        lines[#lines + 1] = ("%s multiplier: x%g -> x%g (great x%g)"):format(stat,
            refinement.GetStatMultiplier(target.name, stat, target.level),
            refinement.GetStatMultiplier(target.name, stat, nextLevel),
            refinement.GetStatMultiplier(target.name, stat, greatLevel))
    end
    local guarded = refinement.GetRung(target.level, true)
    if rung.FailBp > 0 and guarded then
        protected[refinement.GuardItem] = true
        lines[#lines + 1] = ("%s owned: %d | guarded great chance: %.2f%%"):format(
            refinement.GuardItem, refinement.GetHeldCount(data, refinement.GuardItem), guarded.GreatBp / 100)
        lines[#lines + 1] = "Failure outcome depends on guard; confirm at the blacksmith"
    end
    lines[#lines + 1] = CFG.refineProtect and "Target ores protected from selling" or "Target ore protection off"
    return table.concat(lines, "\n"), protected, rung.Wen
