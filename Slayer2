    end
    if not pt then fsrLog("ParkourTraining map not loaded") return end
    if FSR.training ~= tr then
        FSR.training = tr
        FSR.pulled = {}
        FSR.leverFailures = {}
    end
    FSR.pulled = FSR.pulled or {}
    local hrp = getHRP()
    if not hrp then return end
    -- levers unlock level by level (client-side), so pull them in order through the game's own prompt handlers
    for i = 1, 7 do
        local sw = pt:FindFirstChild("Switchs") and pt.Switchs:FindFirstChild("Switch_" .. i)
        if not sw then fsrLog("Waiting for lever " .. i .. " to stream"); return end
        local leverState = sw:FindFirstChild("A_")
        if leverState and leverState:GetAttribute("On") == true then FSR.pulled[i] = true end
        if sw and not FSR.pulled[i] then
            stopLock()
            hrp.CFrame = CFrame.new(sw:GetPivot().Position + Vector3.new(0, 3, 0)); hrp.AssemblyLinearVelocity = Vector3.zero
            local pp
            local t0 = os.clock()
            while os.clock() - t0 < 4 do
                pp = sw:FindFirstChildWhichIsA("ProximityPrompt", true)
                if pp and pp.Enabled then break end
                if not FSR.wait(0.25) then return end
            end
            if not pp or not pp.Enabled then fsrLog("Lever " .. i .. " prompt is not ready") return end
            local on, reason = FSR.holdLever(sw, pp, hrp)
            if reason == "cancelled" then return end
            FSR.leverFailures = FSR.leverFailures or {}
            if on == true then
                FSR.pulled[i] = true
                FSR.leverFailures[i] = nil
                fsrLog("Parkour lever " .. i .. "/7 confirmed")
            else
                FSR.leverFailures[i] = (FSR.leverFailures[i] or 0) + 1
                if FSR.leverFailures[i] >= 3 then
                    CFG.autoFinalSelection = false
                    stopLock()
                    fsrLog("Paused: lever " .. i .. " not confirmed after 3 attempts")
                else
                    fsrLog("Lever " .. i .. ": " .. tostring(reason) .. "; retry " .. FSR.leverFailures[i] .. "/3")
                end
            end
            return
        end
    end
    local final = pt:FindFirstChild("Final")
    if not final then
        local sw7 = pt.Switchs:FindFirstChild("Switch_7")
        tpPos((sw7 and sw7:GetPivot().Position or Vector3.new(207, 1027, 2955)) + Vector3.new(-40, 10, 20), 0)
        pcall(function() LP:RequestStreamAroundAsync(Vector3.new(124, 1042, 2990), 2) end)
        STATE.farmStatus = "FS: Parkour Dungeon - waiting for the finish to load"
        return
    end
    -- Final is a big trigger volume: touching it makes the game client report Stop at once, and the server must already
    -- see us within 75 studs. So park just outside the volume first, let the position replicate, then step in.
    local half = final.Size / 2
    local park = final.CFrame:PointToWorldSpace(Vector3.new(-(half.X + 12), -half.Y + 4, 0))
