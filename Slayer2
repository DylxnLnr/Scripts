    local controller, profile = _skillLast.controller, _skillLast.profile
    local character = getChar()
    if not controller or not profile or not character or not _skillLast.ready(name) then return false end
    local info = profile.skill_info and profile.skill_info[name]
    if not info then _skillLast.status = "Skill unavailable: " .. name; return false end
    local aim = _skillLast.aim
    if not aim or type(aim.mousepos) ~= "function" then _skillLast.status = "Skill aiming unavailable"; return false end
    local before = info.lastUsed
    local originalAim = aim.mousepos
    local function aimedPosition(distance, params, skill)
        if skill == name and typeof(targetPos) == "Vector3" then return targetPos end
        return originalAim(distance, params, skill)
    end
    local function stopped() return _stopped or getChar() ~= character or not alive() or cancelled and cancelled() end
    _skillLast.busy = true
    _skillLast.attempts[name] = os.clock() + 1
    aim.mousepos = aimedPosition
    local ok, why = pcall(function()
        if stopped() then return false end
        asGame(function() controller.Attempt_Hold(name) end)
        if info.lastUsed == before then _skillLast.status = "Not ready: " .. name; return false end
        _skillLast[name] = os.clock()
        _skillLast.casts[name] = (_skillLast.casts[name] or 0) + 1
        _skillLast.status = "Casting: " .. name
        local current = character:FindFirstChild("SHC")
        if current and current.Value == name then
            local untilTime = os.clock() + 0.2
            repeat task.wait(0.05) until stopped() or os.clock() >= untilTime
            if stopped() then
                asGame(function() controller.ForceCancel(name) end)
                return false
            end
            asGame(function() controller.StopHold(name) end)
        end
        _skillLast.status = "Triggered: " .. name
        return true
    end)
    if aim.mousepos == aimedPosition then aim.mousepos = originalAim end
    _skillLast.busy = false
    if not ok then _skillLast.status = "Skill error: " .. tostring(why); return false end
    return why == true
