-- Potassium refuses game-side `require` at identity 8; run game calls at the LocalScript identity.
function asGame(fn, ...)
    if not _setid then return fn(...) end
    local prev = (_getid and _getid()) or 8
    pcall(_setid, 2)
    local ok, a, b, c = pcall(fn, ...)
    pcall(_setid, prev)
    if not ok then error(a, 0) end
    return a, b, c
end

